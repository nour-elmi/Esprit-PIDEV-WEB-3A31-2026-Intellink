{% extends 'base.html.twig' %}
{% block title %}Nouvelle Réclamation - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { background-color: #f4f8fd; font-family: "Heebo", sans-serif; margin: 0; color: #585978; }
        *, *::before, *::after { box-sizing: border-box; }
        ::-webkit-scrollbar { width: 8px; } ::-webkit-scrollbar-track { background: #f4f8fd; } ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; } ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        .scroll-progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); z-index: 100000; width: 0%; box-shadow: 0 0 15px rgba(86, 204, 242, 0.8); border-radius: 0 5px 5px 0; }
        
        .glass-navbar { background: rgba(255, 255, 255, 0.85) !important; backdrop-filter: blur(15px); border-bottom: 1px solid rgba(255,255,255,0.5); transition: transform 0.4s ease, background 0.3s; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05); }
        .navbar-hidden { transform: translateY(-100%); }
        .glitch-logo { position: relative; display: inline-block; color: #2F80ED; font-weight: 900; letter-spacing: -1px; margin: 0;}
        .glitch-logo::before, .glitch-logo::after { content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; }
        .glitch-logo:hover::before { left: 2px; text-shadow: -2px 0 #56CCF2; animation: glitch-anim-1 0.2s infinite linear alternate-reverse; opacity: 1; }
        .glitch-logo:hover::after { left: -2px; text-shadow: 2px 0 #2F80ED; animation: glitch-anim-2 0.3s infinite linear alternate-reverse; opacity: 1; }
        @keyframes glitch-anim-1 { 0% { clip-path: inset(20% 0 80% 0); } 100% { clip-path: inset(50% 0 30% 0); } }
        @keyframes glitch-anim-2 { 0% { clip-path: inset(10% 0 60% 0); } 100% { clip-path: inset(80% 0 10% 0); } }

        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo { font-size: 3rem; font-weight: 900; color: #2F80ED; animation: pulse-glow 1.5s infinite alternate; }
        @keyframes pulse-glow { 0% { transform: scale(0.95); text-shadow: 0 0 10px rgba(47, 128, 237, 0.2); } 100% { transform: scale(1.05); text-shadow: 0 0 30px rgba(86, 204, 242, 0.8); } }

        /* FORMULAIRE DESIGN (Glassmorphism clair) */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: color 0.4s ease; background: white; color: #2F80ED !important; border: 2px solid #2F80ED; padding: 12px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; display: inline-block;}
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(0deg, #2F80ED, #56CCF2); z-index: -1; transition: top 0.6s cubic-bezier(0.25, 1, 0.5, 1); border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { color: white !important; border-color: transparent; box-shadow: 0 10px 20px rgba(47, 128, 237, 0.3); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }
        .btn-outline-custom { background: transparent; color: #2F80ED; border: 2px solid #2F80ED; padding: 8px 24px; border-radius: 50px; font-size: 14px; font-weight: bold; text-decoration: none; transition: all 0.3s; display: inline-block;}
        .btn-outline-custom:hover { background: #2F80ED; color: #ffffff; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(47, 128, 237, 0.2); }

        .formation-form-wrapper { 
            background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.9);
            border-radius: 20px; padding: 40px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05); 
            position: relative; overflow: hidden;
        }
        .formation-form-wrapper::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); }

        .form-group-custom { margin-bottom: 24px; }
        .form-group-custom label { display: block; font-family: "Fira Sans", sans-serif; font-weight: 600; color: #323450; font-size: 14px; margin-bottom: 8px; letter-spacing: 0.5px;}
        .form-control-custom { width: 100%; padding: 13px 18px; border: 2px solid rgba(47, 128, 237, 0.1); border-radius: 12px; font-size: 15px; color: #323450; background: rgba(255, 255, 255, 0.8); transition: all 0.3s ease; outline: none; }
        .form-control-custom:focus { border-color: #2F80ED; box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.15); background: #ffffff; transform: translateY(-2px); }
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div id="preloader"><h1 class="loader-logo">Intel_link<span style="color: #56CCF2;">.</span></h1></div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            <a class="navbar-brand" href="{{ path('app_home') }}">
                                <h3 class="glitch-logo" data-text="Intel_link">Intel_link<span style="color: #56CCF2;">.</span></h3> 
                            </a>
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 45px; height: 45px; object-fit: cover; margin-right: 10px; border: 3px solid #ffffff; box-shadow: 0 4px 10px rgba(47,128,237,0.2);">
                                            <span style="color: #323450; font-weight: 700;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 15px; border: 1px solid rgba(255,255,255,0.8); backdrop-filter: blur(20px); box-shadow: 0 20px 50px rgba(0,0,0,0.1); padding: 15px 0;">
                                            <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="lni lni-user mr-10"></i> Mon Profil</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_reclamation_index') }}"><i class="lni lni-bullhorn mr-10"></i> Mes Réclamations</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="main-content" style="padding: 40px 0;">
        <div style="max-width: 800px; margin: 0 auto; padding: 0 20px;">
            <a href="{{ path('app_reclamation_index') }}" class="btn-outline-custom" style="margin-bottom: 20px;" data-aos="fade-right">&larr; Mes Réclamations</a>
            
            <div class="formation-form-wrapper" data-aos="fade-up" data-aos-duration="1000">
                <h2 style="font-family: 'Fira Sans', sans-serif; font-weight: 900; color: #323450; font-size: 2.2rem; letter-spacing: -1px; margin-bottom: 10px;">Créer un <span style="color: #2F80ED;">Ticket</span></h2>
                <p style="color: #585978; margin-bottom: 30px; font-size: 1.1rem;">Remplissez le formulaire ci-dessous pour que notre équipe d'experts analyse votre demande.</p>

                <form action="{{ path('app_reclamation_new') }}" method="POST" enctype="multipart/form-data">
                    <div class="form-group-custom">
                        <label>OBJET DE LA DEMANDE</label>
                        <input type="text" name="objet" class="form-control-custom" placeholder="Ex: Problème technique sur le forum..." required>
                    </div>

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                            <label>TYPE</label>
                            <select name="type" class="form-control-custom" required>
                                <option value="Technique">Technique</option>
                                <option value="Facturation">Facturation</option>
                                <option value="Service Client">Service Client</option>
                                <option value="Autre">Autre</option>
                            </select>
                        </div>
                        <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                            <label>PRIORITÉ</label>
                            <select name="priorite" class="form-control-custom" required>
                                <option value="FAIBLE">🟢 Faible</option>
                                <option value="MOYENNE" selected>🟡 Moyenne</option>
                                <option value="ELEVEE">🔴 Élevée</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group-custom">
                        <label>DESCRIPTION DÉTAILLÉE</label>
                        <textarea name="description" class="form-control-custom" rows="6" placeholder="Soyez le plus précis possible pour nous aider à vous répondre rapidement..." required></textarea>
                    </div>

                    <div class="form-group-custom">
                        <label>PIÈCE JOINTE <span style="color: #8b92a5; font-weight: 400;">(Image ou PDF, optionnel)</span></label>
                        <input type="file" name="pieceJointe" class="form-control-custom" style="padding: 10px;">
                    </div>

                    <div style="text-align: right; margin-top: 30px;">
                        <button type="submit" class="btn-liquid"><i class="lni lni-telegram-original"></i> Envoyer la demande</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        window.addEventListener('load', () => { setTimeout(() => { document.getElementById('preloader').style.opacity = '0'; setTimeout(() => document.getElementById('preloader').style.display = 'none', 800); }, 500); });
        AOS.init({ once: true, offset: 50 });

        let lastScrollTop = 0; const navbar = document.getElementById('smartNavbar'), progressBar = document.getElementById('scrollBar');
        window.addEventListener('scroll', () => {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            progressBar.style.width = ((scrollTop / (document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100) + "%";
            scrollTop > lastScrollTop && scrollTop > 100 ? navbar.classList.add('navbar-hidden') : navbar.classList.remove('navbar-hidden');
            lastScrollTop = scrollTop;
        });
    </script>
{% endblock %}