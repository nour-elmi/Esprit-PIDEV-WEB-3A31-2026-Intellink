{% extends 'base.html.twig' %}
{% block title %}Mes Réclamations - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        /* BASE */
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { background-color: #f4f8fd; font-family: "Heebo", sans-serif; margin: 0; color: #585978; }
        *, *::before, *::after { box-sizing: border-box; }
        
        /* SCROLLBAR CYBERNÉTIQUE */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f4f8fd; }
        ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        /* LIGNE DE VIE */
        .scroll-progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); z-index: 100000; width: 0%; box-shadow: 0 0 15px rgba(86, 204, 242, 0.8); border-radius: 0 5px 5px 0; }

        /* NAVBAR & GLITCH */
        .glass-navbar { background: rgba(255, 255, 255, 0.85) !important; backdrop-filter: blur(15px); border-bottom: 1px solid rgba(255,255,255,0.5); transition: transform 0.4s ease, background 0.3s; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05); }
        .navbar-hidden { transform: translateY(-100%); }
        .glitch-logo { position: relative; display: inline-block; color: #2F80ED; font-weight: 900; letter-spacing: -1px; margin: 0;}
        .glitch-logo::before, .glitch-logo::after { content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; }
        .glitch-logo:hover::before { left: 2px; text-shadow: -2px 0 #56CCF2; animation: glitch-anim-1 0.2s infinite linear alternate-reverse; opacity: 1; }
        .glitch-logo:hover::after { left: -2px; text-shadow: 2px 0 #2F80ED; animation: glitch-anim-2 0.3s infinite linear alternate-reverse; opacity: 1; }
        @keyframes glitch-anim-1 { 0% { clip-path: inset(20% 0 80% 0); } 100% { clip-path: inset(50% 0 30% 0); } }
        @keyframes glitch-anim-2 { 0% { clip-path: inset(10% 0 60% 0); } 100% { clip-path: inset(80% 0 10% 0); } }

        /* PRELOADER */
        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo { font-size: 3rem; font-weight: 900; color: #2F80ED; animation: pulse-glow 1.5s infinite alternate; }
        @keyframes pulse-glow { 0% { transform: scale(0.95); text-shadow: 0 0 10px rgba(47, 128, 237, 0.2); } 100% { transform: scale(1.05); text-shadow: 0 0 30px rgba(86, 204, 242, 0.8); } }

        /* BOUTONS LIQUIDES & CUSTOM */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: color 0.4s ease; background: white; color: #2F80ED !important; border: 2px solid #2F80ED; padding: 12px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; display: inline-block;}
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(0deg, #2F80ED, #56CCF2); z-index: -1; transition: top 0.6s cubic-bezier(0.25, 1, 0.5, 1); border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { color: white !important; border-color: transparent; box-shadow: 0 10px 20px rgba(47, 128, 237, 0.3); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }
        
        .btn-outline-custom { background: transparent; color: #2F80ED; border: 2px solid #2F80ED; padding: 8px 24px; border-radius: 50px; font-size: 14px; font-weight: bold; text-decoration: none; transition: all 0.3s; display: inline-block;}
        .btn-outline-custom:hover { background: #2F80ED; color: #ffffff; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(47, 128, 237, 0.2); }
        .btn-danger-custom { background: #eb5757; color: #ffffff; border: none; padding: 8px 18px; border-radius: 50px; font-weight: 600; transition: all 0.3s; }
        .btn-danger-custom:hover { background: #c0392b; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(235, 87, 87, 0.3); }

        /* CARTES ET FILTRES (Glassmorphism) */
        .form-control-custom { width: 100%; padding: 13px 18px; border: 2px solid rgba(47, 128, 237, 0.1); border-radius: 12px; font-size: 15px; color: #323450; background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: all 0.3s ease; outline: none; }
        .form-control-custom:focus { border-color: #2F80ED; box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.15); background: #ffffff; transform: translateY(-2px); }

        .rec-card { 
            background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.9);
            border-radius: 20px; padding: 25px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.03); 
            position: relative; overflow: hidden; transition: 0.4s; transform-style: preserve-3d; cursor: pointer;
        }
        .rec-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(47, 128, 237, 0.1); }
        .rec-card::before { content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(180deg, #2F80ED, #56CCF2); transform: scaleY(0); transform-origin: top; transition: transform 0.4s ease; }
        .rec-card:hover::before { transform: scaleY(1); }
        
        .badge-status { padding: 6px 15px; border-radius: 20px; color: white; font-weight: bold; font-size: 12px; letter-spacing: 0.5px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div id="preloader"><h1 class="loader-logo">Intel_link<span style="color: #56CCF2;">.</span></h1></div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar" data-aos="fade-down">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            <a class="navbar-brand" href="{{ path('app_home') }}">
                                <h3 class="glitch-logo" data-text="Intel_link">Intel_link<span style="color: #56CCF2;">.</span></h3> 
                            </a>
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 45px; height: 45px; object-fit: cover; margin-right: 10px; border: 3px solid #ffffff; box-shadow: 0 4px 10px rgba(47,128,237,0.2);">
                                            <span style="color: #323450; font-weight: 700;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 15px; border: 1px solid rgba(255,255,255,0.8); backdrop-filter: blur(20px); box-shadow: 0 20px 50px rgba(0,0,0,0.1); padding: 15px 0;">
                                            <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="lni lni-user mr-10"></i> Mon Profil</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="main-content" style="padding: 40px 0;">
        <div style="max-width: 1100px; margin: 0 auto; padding: 0 20px;">
            <a href="{{ path('app_home') }}" class="btn-outline-custom" style="margin-bottom: 20px;" data-aos="fade-right">&larr; Retour</a>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;" data-aos="fade-up">
                <div>
                    <h2 style="font-family: 'Fira Sans', sans-serif; font-weight: 900; color: #323450; font-size: 2.5rem; letter-spacing: -1px; margin-bottom: 5px;">Mes <span style="color: #2F80ED;">Réclamations</span></h2>
                    <p style="color: #585978; font-size: 1.1rem; margin: 0;">Gérez vos tickets de support et suivez leur avancement en temps réel.</p>
                </div>
                <a href="{{ path('app_reclamation_new') }}" class="btn-liquid"><i class="lni lni-plus"></i> Nouvelle Réclamation</a>
            </div>

            {% for message in app.flashes('success') %}
                <div style="background: rgba(39, 174, 96, 0.1); border: 1px solid rgba(39, 174, 96, 0.3); color: #27ae60; padding: 15px; border-radius: 12px; margin-bottom: 20px;" data-aos="fade-down">{{ message }}</div>
            {% endfor %}

            <div style="display: flex; gap: 15px; margin-bottom: 30px;" data-aos="fade-up" data-aos-delay="100">
                <input type="text" id="searchInput" class="form-control-custom" placeholder="🔍 Rechercher un ticket..." style="max-width: 350px;">
                <select id="statusFilter" class="form-control-custom" style="max-width: 200px;">
                    <option value="Tous">Tous les statuts</option>
                    <option value="OUVERT">Ouvert</option>
                    <option value="TRAITE">Traité</option>
                    <option value="REJETE">Rejeté</option>
                </select>
            </div>

            <div id="reclamationsList">
                {% for rec in reclamations %}
                    <div class="rec-card" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 50 }}" data-status="{{ rec.statut }}" data-text="{{ rec.objet|lower }} {{ rec.description|lower }}">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                            <h4 style="margin: 0; color: #2F80ED; font-weight: 800; font-family: 'Fira Sans', sans-serif; transform: translateZ(10px);">{{ rec.objet }}</h4>
                            <span class="badge-status" style="{% if rec.statut == 'OUVERT' %}background: linear-gradient(45deg, #f39c12, #f1c40f);{% elseif rec.statut == 'TRAITE' %}background: linear-gradient(45deg, #27ae60, #2ecc71);{% else %}background: linear-gradient(45deg, #c0392b, #e74c3c);{% endif %} transform: translateZ(20px);">
                                {{ rec.statut }}
                            </span>
                        </div>
                        <p style="margin: 0 0 20px 0; font-size: 15px; color: #585978; line-height: 1.6; transform: translateZ(10px);">
                            {{ rec.description|length > 120 ? rec.description|slice(0, 120) ~ '...' : rec.description }}
                        </p>
                        
                        <div style="display: flex; justify-content: flex-end; gap: 12px; transform: translateZ(20px);">
                            <a href="{{ path('app_reclamation_show', {'id': rec.id}) }}" class="btn-outline-custom"><i class="lni lni-eye"></i> Détails</a>
                            {% if rec.statut == 'OUVERT' %}
                                <form method="post" action="{{ path('app_reclamation_delete', {'id': rec.id}) }}" onsubmit="return confirm('Supprimer ce ticket ?');" style="margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id) }}">
                                    <button type="submit" class="btn-danger-custom"><i class="lni lni-trash"></i></button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 50px; background: rgba(255,255,255,0.5); border-radius: 20px; border: 1px dashed #2F80ED;" data-aos="zoom-in">
                        <i class="lni lni-empty-file" style="font-size: 40px; color: #2F80ED; margin-bottom: 15px; display: block;"></i>
                        <p style="font-size: 1.2rem; color: #585978; margin: 0;">Vous n'avez aucune réclamation pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.7.2/vanilla-tilt.min.js"></script>

    <script>
        window.addEventListener('load', () => { setTimeout(() => { document.getElementById('preloader').style.opacity = '0'; setTimeout(() => document.getElementById('preloader').style.display = 'none', 800); }, 500); });
        AOS.init({ once: true, offset: 50 });

        let lastScrollTop = 0; const navbar = document.getElementById('smartNavbar'), progressBar = document.getElementById('scrollBar');
        window.addEventListener('scroll', () => {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            progressBar.style.width = ((scrollTop / (document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100) + "%";
            scrollTop > lastScrollTop && scrollTop > 100 ? navbar.classList.add('navbar-hidden') : navbar.classList.remove('navbar-hidden');
            lastScrollTop = scrollTop;
        });

        // Filtrage dynamique
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        function filterList() {
            const searchText = searchInput.value.toLowerCase();
            const status = statusFilter.value;
            document.querySelectorAll('.rec-card').forEach(card => {
                const matchesText = card.dataset.text.includes(searchText);
                const matchesStatus = status === 'Tous' || card.dataset.status === status;
                card.style.display = matchesText && matchesStatus ? 'block' : 'none';
            });
        }
        searchInput.addEventListener('input', filterList);
        statusFilter.addEventListener('change', filterList);
        
        VanillaTilt.init(document.querySelectorAll(".rec-card"), { max: 3, speed: 400, glare: true, "max-glare": 0.1 });
    </script>
{% endblock %}