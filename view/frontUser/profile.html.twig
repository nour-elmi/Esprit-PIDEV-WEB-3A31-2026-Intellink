{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        /* =========================================================================
           1. ESTHÉTIQUE GLOBALE (Héritée de l'accueil)
           ========================================================================= */
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { background-color: #f4f8fd; font-family: "Heebo", sans-serif; margin: 0; color: #585978; }
        *, *::before, *::after { box-sizing: border-box; }
        
        /* SCROLLBAR CYBERNÉTIQUE */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f4f8fd; }
        ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        /* GRAIN CINÉMATOGRAPHIQUE */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 99998; opacity: 0.05;
            background: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E');
        }

        /* LIGNE DE VIE (PROGRESS BAR) */
        .scroll-progress-bar {
            position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2);
            z-index: 100000; width: 0%; box-shadow: 0 0 15px rgba(86, 204, 242, 0.8); border-radius: 0 5px 5px 0;
        }

        /* PRÉCHARGEUR */
        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo { font-size: 3rem; font-weight: 900; color: #2F80ED; animation: pulse-glow 1.5s infinite alternate; }
        @keyframes pulse-glow { 0% { transform: scale(0.95); text-shadow: 0 0 10px rgba(47, 128, 237, 0.2); } 100% { transform: scale(1.05); text-shadow: 0 0 30px rgba(86, 204, 242, 0.8); } }

        /* AURA MAGNÉTIQUE */
        .cursor-glow { position: fixed; top: 0; left: 0; width: 600px; height: 600px; background: radial-gradient(circle, rgba(86, 204, 242, 0.08) 0%, rgba(47, 128, 237, 0) 60%); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; z-index: 9999; transition: width 0.3s, height 0.3s; mix-blend-mode: multiply; }

        /* NAVBAR INTELLIGENTE & GLITCH LOGO */
        .glass-navbar { background: rgba(255, 255, 255, 0.6) !important; backdrop-filter: blur(25px); border-bottom: 1px solid rgba(255,255,255,0.5); transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), background 0.3s; }
        .navbar-hidden { transform: translateY(-100%); }
        .glitch-logo { position: relative; display: inline-block; color: #2F80ED; font-weight: 900; letter-spacing: -1px; margin: 0;}
        .glitch-logo::before, .glitch-logo::after { content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; }
        .glitch-logo:hover::before { left: 2px; text-shadow: -2px 0 #56CCF2; animation: glitch-anim-1 0.2s infinite linear alternate-reverse; opacity: 1; }
        .glitch-logo:hover::after { left: -2px; text-shadow: 2px 0 #2F80ED; animation: glitch-anim-2 0.3s infinite linear alternate-reverse; opacity: 1; }
        @keyframes glitch-anim-1 { 0% { clip-path: inset(20% 0 80% 0); } 100% { clip-path: inset(50% 0 30% 0); } }
        @keyframes glitch-anim-2 { 0% { clip-path: inset(10% 0 60% 0); } 100% { clip-path: inset(80% 0 10% 0); } }

        /* BOUTON LIQUID WAVE */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: color 0.4s ease; background: white; color: #2F80ED !important; border: 2px solid #2F80ED; padding: 12px 28px; border-radius: 50px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block;}
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(0deg, #2F80ED, #56CCF2); z-index: -1; transition: top 0.6s cubic-bezier(0.25, 1, 0.5, 1); border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { color: white !important; border-color: transparent; box-shadow: 0 10px 20px rgba(47, 128, 237, 0.3); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }
        
        .btn-liquid-success { border-color: #27ae60; color: #27ae60 !important; }
        .btn-liquid-success::before { background: linear-gradient(0deg, #27ae60, #2ecc71); }

        /* =========================================================================
           2. COMPOSANTS SPÉCIFIQUES AU PROFIL (Adaptés au nouveau design)
           ========================================================================= */
        /* Panneaux effet Glassmorphism */
        .formation-form-wrapper { 
            background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.9);
            border-radius: 20px; padding: 40px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.03); 
            position: relative; overflow: hidden;
        }
        /* Ligne de gradient en haut du panneau principal */
        .profile-main.formation-form-wrapper::before {
            content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 4px;
            background: linear-gradient(90deg, #2F80ED, #56CCF2);
        }

        .profile-layout { display: flex; gap: 40px; max-width: 1100px; margin: 40px auto; position: relative; z-index: 2; }
        .profile-sidebar { width: 300px; display: flex; flex-direction: column; align-items: center; gap: 20px; }
        .profile-main { flex: 1; }
        
        /* Avatar avec Glow */
        .profile-avatar { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid #ffffff; box-shadow: 0 10px 25px rgba(47, 128, 237, 0.2); transition: 0.3s; }
        .profile-avatar:hover { transform: scale(1.05); box-shadow: 0 15px 35px rgba(47, 128, 237, 0.3); }
        
        .cv-box { display: flex; align-items: center; justify-content: space-between; padding: 15px; border: 1px dashed #2F80ED; border-radius: 10px; background: rgba(47, 128, 237, 0.05); transition: 0.3s;}
        .cv-box:hover { background: rgba(47, 128, 237, 0.1); }
        
        .btn-outline-custom { background: transparent; color: #2F80ED; border: 2px solid #2F80ED; padding: 10px 26px; border-radius: 50px; font-weight: 600; cursor: pointer; transition: all 0.3s; display: inline-block; text-decoration: none;}
        .btn-outline-custom:hover { background: #2F80ED; color: #ffffff; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(47, 128, 237, 0.2); }
        
        .btn-danger-custom { background: #eb5757; color: #ffffff; border: none; padding: 12px 28px; border-radius: 50px; font-weight: 600; cursor: pointer; transition: all 0.3s; width: 100%; display: block; text-align: center; }
        .btn-danger-custom:hover { background: #c0392b; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(235, 87, 87, 0.3); }

        .form-group-custom { margin-bottom: 24px; }
        .form-group-custom label { display: block; font-family: "Fira Sans", sans-serif; font-weight: 600; color: #323450; font-size: 14px; margin-bottom: 8px; letter-spacing: 0.5px;}
        .form-control-custom { width: 100%; padding: 13px 18px; border: 2px solid #e8edf5; border-radius: 12px; font-size: 15px; color: #323450; background: #ffffff; transition: all 0.3s ease; outline: none; }
        .form-control-custom:focus { border-color: #2F80ED; box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.1); }
        .form-control-custom:disabled { background-color: rgba(241, 245, 249, 0.5); color: #64748b; border-color: transparent;}

        .alert-custom { padding: 16px 20px; border-radius: 12px; font-size: 14px; font-weight: 500; margin-bottom: 20px; }
        .alert-success-custom { background: rgba(39, 174, 96, 0.08); border: 1px solid rgba(39, 174, 96, 0.2); color: #27ae60; }
        .alert-danger-custom { background: rgba(235, 87, 87, 0.08); border: 1px solid rgba(235, 87, 87, 0.2); color: #eb5757; }

        /* Modal Avatar */
        .avatar-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); z-index: 100000; justify-content: center; align-items: center; }
        .avatar-grid { background: white; padding: 40px; border-radius: 20px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; width: 450px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); animation: scaleIn 0.3s ease-out;}
        @keyframes scaleIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .avatar-grid img { width: 80px; height: 80px; cursor: pointer; transition: 0.3s; border-radius: 50%; border: 2px solid transparent;}
        .avatar-grid img:hover { transform: scale(1.15); box-shadow: 0 10px 20px rgba(47, 128, 237, 0.2); border-color: #2F80ED;}
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div class="noise-overlay"></div>

    <div id="preloader"><h1 class="loader-logo">Intel_link<span style="color: #56CCF2;">.</span></h1></div>
    <div class="cursor-glow" id="cursorGlow"></div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar" data-aos="fade-down" data-aos-duration="1000">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            <a class="navbar-brand" href="{{ path('app_home') }}">
                                <h3 class="glitch-logo" data-text="Intel_link">Intel_link<span style="color: #56CCF2;">.</span></h3> 
                            </a>
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                                            {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 45px; height: 45px; object-fit: cover; margin-right: 10px; border: 3px solid #ffffff;">
                                            <span style="color: #323450; font-weight: 700;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileMenu" style="border-radius: 15px; border: 1px solid rgba(255,255,255,0.8); backdrop-filter: blur(20px); box-shadow: 0 20px 50px rgba(0,0,0,0.1); padding: 15px 0;">
                                            <li><a class="dropdown-item" href="{{ path('app_profile') }}" style="transition: 0.3s; font-weight: 500; color: #585978; padding: 10px 20px;"><i class="lni lni-user mr-10"></i> Mon Profil</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_reclamation_index') }}" style="transition: 0.3s; font-weight: 500; color: #585978; padding: 10px 20px;"><i class="lni lni-bullhorn mr-10"></i> Mes Réclamations</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}" style="transition: 0.3s; font-weight: 500; padding: 10px 20px;"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="main-content" style="padding-top: 40px;">
        <div style="max-width: 1100px; margin: 0 auto; padding: 0 20px 20px 20px;" data-aos="fade-right" data-aos-duration="1000">
            <a href="{{ path('app_home') }}" class="btn-outline-custom" style="padding: 6px 20px; font-size: 14px;">
                &larr; Retour à l'accueil
            </a>
            <h2 style="margin-top: 25px; font-family: 'Fira Sans', sans-serif; font-weight: 900; color: #323450; font-size: 2.5rem; letter-spacing: -1px;">Espace <span style="color: #2F80ED;">Personnel</span></h2>
            <p style="color: #585978; font-size: 1.1rem;">Gérez vos informations, votre sécurité et vos documents professionnels.</p>
        </div>

        <div class="profile-layout">
            
            <div class="profile-sidebar formation-form-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                {% set avatar_src = user.image starts with 'http' ? user.image : asset('uploads/profiles/' ~ user.image) %}
                <img src="{{ avatar_src }}" alt="Avatar" class="profile-avatar" id="avatar-preview">
                
                <div id="image-actions" style="display: none; width: 100%; margin-top: 20px;">
                    <label for="image_profil" class="btn-outline-custom" style="display: block; width: 100%; box-sizing: border-box; text-align: center; margin-bottom: 12px; padding: 10px 5px; font-size: 13px; cursor: pointer;">
                        <i class="lni lni-upload"></i> Importer photo
                    </label>
                    <button type="button" class="btn-outline-custom" style="display: block; width: 100%; box-sizing: border-box; text-align: center; padding: 10px 5px; font-size: 13px;" onclick="document.getElementById('avatarModal').style.display='flex'">
                        <i class="lni lni-emoji-smile"></i> Choisir avatar
                    </button>
                </div>

                <hr style="width: 100%; border: 0; border-top: 1px solid #e8edf5; margin: 25px 0;">

                <form action="{{ path('app_profile_delete') }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer votre compte ? Cette action est irréversible.');" style="width: 100%;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                    <button type="submit" class="btn-danger-custom"><i class="lni lni-trash"></i> Supprimer le compte</button>
                </form>
            </div>

            <div class="profile-main formation-form-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
                    <h3 style="color: #323450; font-weight: 800; margin: 0;">Informations Personnelles</h3>
                    <button type="button" class="btn-liquid" id="btn-edit" onclick="toggleEditMode(true)" style="padding: 10px 25px; font-size: 14px;">
                        <i class="lni lni-pencil"></i> Modifier le profil
                    </button>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert-custom alert-success-custom">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('danger') %}
                    <div class="alert-custom alert-danger-custom">{{ message }}</div>
                {% endfor %}

                <form action="{{ path('app_profile') }}" method="POST" enctype="multipart/form-data">
                    
                    <input type="file" id="image_profil" name="image_profil" accept="image/png, image/jpeg" style="display: none;" onchange="previewLocalImage(this)">
                    <input type="hidden" id="avatar_url" name="avatar_url">
                    <input type="file" id="cv_pdf" name="cv_pdf" accept="application/pdf" style="display: none;" onchange="document.getElementById('lbl-cv').innerText = this.files[0].name">

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label>NOM COMPLET</label>
                            <input type="text" name="nom" class="form-control-custom editable-field" value="{{ user.nom }}" disabled required>
                        </div>

                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label>ADRESSE EMAIL</label>
                            <input type="email" name="email" class="form-control-custom editable-field" value="{{ user.email }}" disabled required>
                        </div>
                    </div>

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label>RÔLE</label>
                            <input type="text" class="form-control-custom" value="{{ user.role }}" disabled>
                        </div>

                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label style="color: #2F80ED;">SÉCURITÉ (2FA)</label>
                            <select name="auth_method" class="form-control-custom editable-field" disabled>
                                <option value="NONE" {% if user.authMethod == 'NONE' %}selected{% endif %}>Désactivée</option>
                                <option value="EMAIL" {% if user.authMethod == 'EMAIL' %}selected{% endif %}>Par Email</option>
                                <option value="FACE" {% if user.authMethod == 'FACE' %}selected{% endif %}>Reconnaissance Faciale</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group-custom mt-2">
                        <label>CV / COMPÉTENCES (PDF)</label>
                        <div class="cv-box">
                            <div style="display: flex; align-items: center;">
                                <i class="lni lni-empty-file" style="font-size: 24px; color: #2F80ED; margin-right: 15px;"></i>
                                <span id="lbl-cv" style="font-weight: 600; color: #323450; font-size: 15px;">
                                    {% if user.skills %}CV_{{ user.nom|replace({' ': '_'}) }}.pdf{% else %}Aucun document lié{% endif %}
                                </span>
                            </div>
                            
                            <div id="cv-read-actions">
                                {% if user.skills %}
                                    <a href="{{ asset('uploads/CV/' ~ user.skills) }}" target="_blank" class="btn-outline-custom" style="padding: 6px 18px; font-size: 13px;"><i class="lni lni-eye"></i> Ouvrir</a>
                                {% endif %}
                            </div>

                            <div id="cv-edit-actions" style="display: none;">
                                <label for="cv_pdf" class="btn-liquid" style="padding: 6px 18px; font-size: 13px; margin: 0; cursor: pointer;"><i class="lni lni-upload"></i> Remplacer</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions mt-4" id="save-actions" style="display: none; justify-content: flex-end; gap: 15px;">
                        <button type="button" class="btn-outline-custom" onclick="toggleEditMode(false)">Annuler</button>
                        <button type="submit" class="btn-liquid btn-liquid-success">Enregistrer les modifications</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="avatar-modal" id="avatarModal" onclick="closeModal(event)">
        <div class="avatar-grid">
            <h4 style="grid-column: span 4; text-align: center; margin-bottom: 10px; color: #323450; font-weight: 800;">Choisir un avatar</h4>
            {% set avatars = [
                "https://cdn-icons-png.flaticon.com/512/4140/4140047.png", "https://cdn-icons-png.flaticon.com/512/1144/1144709.png",
                "https://cdn-icons-png.flaticon.com/512/6997/6997662.png", "https://cdn-icons-png.flaticon.com/512/147/147140.png",
                "https://cdn-icons-png.flaticon.com/512/147/147144.png", "https://cdn-icons-png.flaticon.com/512/4140/4140048.png",
                "https://cdn-icons-png.flaticon.com/512/147/147142.png", "https://cdn-icons-png.flaticon.com/512/147/147129.png"
            ] %}
            {% for url in avatars %}
                <img src="{{ url }}" alt="Avatar" onclick="selectAvatar('{{ url }}')">
            {% endfor %}
            <button type="button" class="btn-outline-custom" style="grid-column: span 4;" onclick="document.getElementById('avatarModal').style.display='none'">Fermer</button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        // 1. Initialisation AOS
        AOS.init({ once: true, offset: 50 });

        // 2. Preloader
        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('preloader').style.opacity = '0';
                setTimeout(function() { document.getElementById('preloader').style.display = 'none'; }, 800);
            }, 500); 
        });

        // 3. Scroll Progress Bar & Smart Navbar
        let lastScrollTop = 0;
        const navbar = document.getElementById('smartNavbar');
        const progressBar = document.getElementById('scrollBar');
        
        window.addEventListener('scroll', function() {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            let docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            let scrolled = (scrollTop / docHeight) * 100;
            progressBar.style.width = scrolled + "%";

            if (scrollTop > lastScrollTop && scrollTop > 100) {
                navbar.classList.add('navbar-hidden');
            } else {
                navbar.classList.remove('navbar-hidden');
            }
            lastScrollTop = scrollTop;
        });

        // 4. Cursor Aura
        const cursorGlow = document.getElementById('cursorGlow');
        document.addEventListener('mousemove', (e) => {
            cursorGlow.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(-50%, -50%)`;
        });

        // 5. GESTION DU MODE ÉDITION DU PROFIL
        function toggleEditMode(active) {
            document.querySelectorAll('.editable-field').forEach(field => {
                field.disabled = !active;
            });

            document.getElementById('btn-edit').style.display = active ? 'none' : 'inline-block';
            document.getElementById('save-actions').style.display = active ? 'flex' : 'none';
            
            document.getElementById('image-actions').style.display = active ? 'block' : 'none';
            document.getElementById('cv-read-actions').style.display = active ? 'none' : 'block';
            document.getElementById('cv-edit-actions').style.display = active ? 'block' : 'none';
        }

        // 6. GESTION DES AVATARS
        function previewLocalImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatar-preview').src = e.target.result;
                    document.getElementById('avatar_url').value = ''; 
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function selectAvatar(url) {
            document.getElementById('avatar-preview').src = url;
            document.getElementById('avatar_url').value = url;
            document.getElementById('image_profil').value = ''; 
            document.getElementById('avatarModal').style.display = 'none';
        }

        function closeModal(event) {
            if (event.target.id === 'avatarModal') {
                document.getElementById('avatarModal').style.display = 'none';
            }
        }
    </script>
{% endblock %}