{% extends 'base.html.twig' %}

{% block title %}Connexion & Inscription - Intel_link{% endblock %}

{% block stylesheets %}
<style>
    /* =========================================================================
       1. DESIGN GLOBAL & SPACING (Fond et Centrage)
       ========================================================================= */
    body {
        background-color: #f5f7fa;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .auth-container {
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        position: relative;
        overflow: hidden; /* Cache ce qui dépasse pendant l'animation */
        width: 850px;
        max-width: 100%;
        min-height: 580px;
    }

    /* =========================================================================
       2. LES PANNEAUX DE FORMULAIRES 
       ========================================================================= */
    .form-container {
        position: absolute;
        top: 0;
        height: 100%;
        transition: all 0.6s ease-in-out;
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0 40px;
        box-sizing: border-box;
        background-color: #ffffff; /* FOND OPAQUE POUR CACHER L'AUTRE PANNEAU */
        z-index: 1;
    }

    .form-container form {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px; /* ESPACEMENT PARFAIT ENTRE LES CHAMPS */
    }

    .sign-in-container {
        left: 0;
        z-index: 2;
    }

    .sign-up-container {
        left: 0; 
        opacity: 0;
        z-index: 1;
    }

    /* =========================================================================
       3. LE PANNEAU COULISSANT (L'Overlay Bleu)
       ========================================================================= */
    .overlay-container {
        position: absolute;
        top: 0;
        left: 50%;
        width: 50%;
        height: 100%;
        overflow: hidden;
        transition: transform 0.6s ease-in-out;
        z-index: 100;
    }

    .overlay {
        background-color: #0598ff;
        color: #ffffff;
        position: relative;
        left: -100%;
        height: 100%;
        width: 200%;
        transform: translateX(0);
        transition: transform 0.6s ease-in-out;
        display: flex;
    }

    .overlay-panel {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        top: 0;
        height: 100%;
        width: 50%;
        transform: translateX(0);
        transition: transform 0.6s ease-in-out;
    }

    .overlay-left {
        transform: translateX(-20%);
    }

    .overlay-right {
        right: 0;
        transform: translateX(0);
    }

    /* =========================================================================
       4. ANIMATION CSS CORRIGÉE (Masquage Parfait)
       ========================================================================= */
    .auth-container.right-panel-active .sign-in-container {
        transform: translateX(100%);
        opacity: 0; /* On cache le sign-in */
        z-index: 1;
    }
    
    .auth-container.right-panel-active .overlay-container {
        transform: translateX(-100%);
    }
    
    .auth-container.right-panel-active .sign-up-container {
        transform: translateX(100%); 
        opacity: 1; /* On affiche le sign-up */
        z-index: 5; /* On le met au premier plan */
    }
    
    .auth-container.right-panel-active .overlay {
        transform: translateX(50%);
    }
    
    .auth-container.right-panel-active .overlay-left {
        transform: translateX(0);
    }
    
    .auth-container.right-panel-active .overlay-right {
        transform: translateX(20%);
    }

    /* =========================================================================
       5. STYLES DES ÉLÉMENTS (Nettoyés)
       ========================================================================= */
    h1 { font-weight: bold; margin: 0 0 10px 0; color: #0598ff; font-size: 26px; }
    h1.white-text { color: white; font-size: 32px; }
    p { font-size: 14px; margin: 0 0 25px 0; }

    .input-group { position: relative; width: 100%; max-width: 300px; }
    
    input[type="text"], input[type="email"], input[type="password"], select {
        background-color: transparent;
        border: none;
        border-bottom: 2px solid #0598ff;
        padding: 10px 5px;
        width: 100%;
        outline: none;
        font-size: 14px;
        box-sizing: border-box;
    }

    .toggle-password {
        position: absolute;
        right: 5px;
        top: 8px;
        cursor: pointer;
        color: #0598ff;
        background: none;
        border: none;
        font-size: 14px;
    }

    button.btn-primary {
        border-radius: 20px;
        border: 2px solid #0598ff;
        background-color: #0598ff;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: bold;
        padding: 12px 45px;
        letter-spacing: 1px;
        cursor: pointer;
        transition: transform 80ms ease-in;
        width: 220px;
        margin-top: 5px;
    }

    button.btn-primary:active { transform: scale(0.95); }
    
    button.btn-ghost {
        background-color: transparent;
        border-color: #FFFFFF;
    }

    button.btn-github {
        background-color: #24292e;
        border-color: #24292e;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .file-upload-row { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 300px; }
    .file-upload-label {
        background-color: #ecf0f1; color: #2c3e50; padding: 6px 12px;
        border-radius: 5px; cursor: pointer; font-size: 11px;
    }
    .file-name { font-size: 10px; color: gray; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    
    .strength-bar-container { width: 100%; max-width: 300px; height: 5px; background: #ecf0f1; border-radius: 5px; overflow: hidden; }
    .strength-bar { height: 100%; width: 0%; background: #e74c3c; transition: width 0.3s ease; }

    .error-msg { color: #e74c3c; font-size: 12px; text-align: center; max-width: 300px; }
</style>
{% endblock %}

{% block body %}
<div class="auth-container" id="auth-container">
    
    <div class="form-container sign-in-container">
        <form action="{{ path('app_login') }}" method="POST">
            <h1>Connexion</h1>
            {% for message in app.flashes('error_login') %}
                <div class="error-msg" style="margin-bottom: 15px;">{{ message }}</div>
            {% endfor %}
            
            {% if error %}
                <div class="error-msg">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div class="input-group">
                <input type="email" name="_username" placeholder="Email" value="{{ last_username }}" required />
            </div>
            <div class="input-group">
                <input type="password" id="login-password" name="_password" placeholder="Mot de passe" required />
                <button type="button" class="toggle-password" onclick="togglePassword('login-password')">👁</button>
            </div>
            
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-primary">Se connecter</button>
            <button type="button" class="btn-primary btn-github" onclick="window.location.href='#'">
                <img src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png" style="width:16px; filter: invert(1);"> Se connecter avec GitHub
            </button>
            <a href="#" style="color: #64748b; font-size: 12px; text-decoration: none; margin-top: 10px;">Mot de passe oublié ?</a>
        </form>
    </div>

    <div class="form-container sign-up-container">
        <form action="{{ path('app_register') }}" method="POST" enctype="multipart/form-data">
            <h1>Inscription</h1>
            {% for message in app.flashes('error_signup') %}
                <div class="error-msg" style="margin-bottom: 15px;">{{ message }}</div>
                <script>
                    // Petit script pour rouvrir automatiquement le panneau d'inscription s'il y a une erreur
                    document.addEventListener("DOMContentLoaded", function() {
                        document.getElementById('auth-container').classList.add("right-panel-active");
                    });
                </script>
            {% endfor %}

            <div class="file-upload-row" style="justify-content: center;">
                <img id="avatar-preview" src="https://cdn-icons-png.flaticon.com/512/149/149071.png" style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover;">
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <label for="image_profil" class="file-upload-label" style="background-color: #0598ff; color: white;">Importer photo...</label>
                    <input type="file" id="image_profil" name="image_profil" accept="image/png, image/jpeg" style="display: none;" onchange="previewImage(this)">
                </div>
            </div>

            <div class="input-group">
                <input type="text" name="nom" placeholder="Nom complet" required />
            </div>
            <div class="input-group">
                <input type="email" name="email" placeholder="Email" required />
            </div>
            <div class="input-group">
                <input type="password" id="signup-password" name="password" placeholder="Mot de passe" required onkeyup="checkStrength(this.value)" />
                <button type="button" class="toggle-password" onclick="togglePassword('signup-password')">👁</button>
            </div>
            
            <div class="strength-bar-container"><div class="strength-bar" id="strength-bar"></div></div>

            <div class="input-group">
                <span style="position: absolute; left: 0; top: 10px;">👤</span>
                <select name="role_demande" style="padding-left: 25px; color: #64748b;">
                    <option value="utilisateur simple">Sélectionner un rôle pro (Optionnel)</option>
                    <option value="CHEF PROJET">CHEF PROJET</option>
                    <option value="RECRUTEUR">RECRUTEUR</option>
                    <option value="FORMATEUR">FORMATEUR</option>
                </select>
            </div>

            <div class="file-upload-row" style="border-bottom: 2px solid #0598ff; padding-bottom: 5px;">
                <label for="cv_pdf" class="file-upload-label">Joindre CV (PDF)</label>
                <input type="file" id="cv_pdf" name="cv_pdf" accept="application/pdf" style="display: none;" onchange="updateFileName(this)">
                <span id="pdf-file-name" class="file-name">Aucun fichier</span>
            </div>

            <button type="submit" class="btn-primary">S'inscrire</button>
        </form>
    </div>

    <div class="overlay-container">
        <div class="overlay">
            <div class="overlay-panel overlay-left">
                <h1 class="white-text">Bon retour !</h1>
                <p>Déjà inscrit ? Connectez-vous.</p>
                <button class="btn-primary btn-ghost" id="signInBtn">Se connecter</button>
            </div>
            <div class="overlay-panel overlay-right">
                <h1 class="white-text">Bienvenue !</h1>
                <p>Pas encore de compte ?</p>
                <button class="btn-primary btn-ghost" id="signUpBtn">S'inscrire</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const signUpButton = document.getElementById('signUpBtn');
    const signInButton = document.getElementById('signInBtn');
    const container = document.getElementById('auth-container');

    signUpButton.addEventListener('click', () => {
        container.classList.add("right-panel-active");
    });

    signInButton.addEventListener('click', () => {
        container.classList.remove("right-panel-active");
    });

    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
        } else {
            input.type = "password";
        }
    }

    function checkStrength(password) {
        const bar = document.getElementById('strength-bar');
        const len = password.length;
        
        let percentage = Math.min((len / 8.0) * 100, 100);
        bar.style.width = percentage + "%";

        if (len >= 8) {
            bar.style.backgroundColor = "#2ecc71"; 
        } else if (len >= 5) {
            bar.style.backgroundColor = "#f39c12"; 
        } else {
            bar.style.backgroundColor = "#e74c3c"; 
        }
    }

    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('avatar-preview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function updateFileName(input) {
        const label = document.getElementById('pdf-file-name');
        if (input.files && input.files[0]) {
            label.textContent = input.files[0].name;
            label.style.color = "black";
        } else {
            label.textContent = "Aucun fichier";
            label.style.color = "gray";
        }
    }
</script>
{% endblock %}