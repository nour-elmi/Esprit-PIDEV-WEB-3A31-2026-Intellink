{% extends 'base.html.twig' %}

{% block title %}Accueil - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/glightbox.min.css') }}">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { background-color: #f4f8fd; }
        
        /* 1. NOUVEAU : LA SCROLLBAR CYBERNÉTIQUE */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f4f8fd; }
        ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        /* 2. NOUVEAU : LE GRAIN CINÉMATOGRAPHIQUE */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 99998; opacity: 0.05;
            background: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E');
        }

        /* 3. NOUVEAU : LA LIGNE DE VIE (PROGRESS BAR) */
        .scroll-progress-bar {
            position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2);
            z-index: 100000; width: 0%; box-shadow: 0 0 15px rgba(86, 204, 242, 0.8); border-radius: 0 5px 5px 0;
        }

        /* NAVBAR INTELLIGENTE (SMART HIDE) */
        .glass-navbar { background: rgba(255, 255, 255, 0.6) !important; backdrop-filter: blur(25px); border-bottom: 1px solid rgba(255,255,255,0.5); transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), background 0.3s; }
        .navbar-hidden { transform: translateY(-100%); }

        /* PRÉCHARGEUR */
        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo { font-size: 3rem; font-weight: 900; color: #2F80ED; animation: pulse-glow 1.5s infinite alternate; }
        @keyframes pulse-glow { 0% { transform: scale(0.95); text-shadow: 0 0 10px rgba(47, 128, 237, 0.2); } 100% { transform: scale(1.05); text-shadow: 0 0 30px rgba(86, 204, 242, 0.8); } }

        /* AURA MAGNÉTIQUE */
        .cursor-glow { position: fixed; top: 0; left: 0; width: 600px; height: 600px; background: radial-gradient(circle, rgba(86, 204, 242, 0.08) 0%, rgba(47, 128, 237, 0) 60%); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; z-index: 9999; transition: width 0.3s, height 0.3s; mix-blend-mode: multiply; }

        /* CYBER GLITCH LOGO */
        .glitch-logo { position: relative; display: inline-block; color: #2F80ED; font-weight: 900; letter-spacing: -1px; }
        .glitch-logo::before, .glitch-logo::after { content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; }
        .glitch-logo:hover::before { left: 2px; text-shadow: -2px 0 #56CCF2; animation: glitch-anim-1 0.2s infinite linear alternate-reverse; opacity: 1; }
        .glitch-logo:hover::after { left: -2px; text-shadow: 2px 0 #2F80ED; animation: glitch-anim-2 0.3s infinite linear alternate-reverse; opacity: 1; }
        @keyframes glitch-anim-1 { 0% { clip-path: inset(20% 0 80% 0); } 100% { clip-path: inset(50% 0 30% 0); } }
        @keyframes glitch-anim-2 { 0% { clip-path: inset(10% 0 60% 0); } 100% { clip-path: inset(80% 0 10% 0); } }

        /* BOUTON LIQUID WAVE */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: color 0.4s ease; background: white; color: #2F80ED !important; border: 2px solid #2F80ED; }
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(0deg, #2F80ED, #56CCF2); z-index: -1; transition: top 0.6s cubic-bezier(0.25, 1, 0.5, 1); border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { color: white !important; border-color: transparent; box-shadow: 0 10px 20px rgba(47, 128, 237, 0.3); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }

        /* GRILLE 3D & MASQUE */
        .hero-section-wrapper-5 { position: relative; z-index: 1; min-height: 95vh; display: flex; align-items: center; overflow: hidden; }
        #tsparticles { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
        .perspective-grid { position: absolute; bottom: -50%; left: -50%; width: 200%; height: 100%; background-image: linear-gradient(rgba(47, 128, 237, 0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(47, 128, 237, 0.15) 1px, transparent 1px); background-size: 50px 50px; transform: perspective(600px) rotateX(75deg); animation: grid-move 10s linear infinite; z-index: 0; pointer-events: none; }
        @keyframes grid-move { 0% { transform: perspective(600px) rotateX(75deg) translateY(0); } 100% { transform: perspective(600px) rotateX(75deg) translateY(50px); } }
        .video-text-mask { font-size: 14vw; font-weight: 900; background: url('https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80'); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-size: cover; background-position: center; opacity: 0.04; position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%); white-space: nowrap; z-index: 0; pointer-events: none; letter-spacing: -5px; }
        .gradient-text { background: linear-gradient(90deg, #2F80ED, #56CCF2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        /* BADGES FLOTTANTS */
        .hero-image-container { position: relative; z-index: 5; }
        .parallax-badge { position: absolute; background: rgba(255,255,255,0.85); backdrop-filter: blur(10px); padding: 12px 20px; border-radius: 15px; box-shadow: 0 15px 35px rgba(47, 128, 237, 0.15); border: 1px solid rgba(255,255,255,0.9); font-weight: 700; color: #323450; z-index: 10; display: flex; align-items: center; gap: 12px; pointer-events: none; }
        .parallax-badge i { font-size: 22px; color: #2F80ED; background: rgba(47, 128, 237, 0.1); padding: 8px; border-radius: 50%; }
        .badge-1 { top: -20px; left: -30px; }
        .badge-2 { bottom: 30px; right: -40px; }

        /* BANDEAU DES PARTENAIRES */
        .trusted-by-section { background: #ffffff; padding: 50px 0; border-top: 1px solid rgba(47, 128, 237, 0.1); border-bottom: 1px solid rgba(47, 128, 237, 0.1); position: relative; z-index: 2; overflow: hidden; }
        .trusted-title { text-align: center; font-size: 0.85rem; font-weight: 700; color: #8b92a5; text-transform: uppercase; letter-spacing: 2.5px; margin-bottom: 35px; }
        .marquee-wrapper { width: 100%; overflow: hidden; white-space: nowrap; display: flex; align-items: center; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
        .marquee-content { display: inline-flex; align-items: center; animation: marquee 35s linear infinite; }
        .marquee-content img { height: 35px; margin: 0 50px; filter: grayscale(100%) opacity(0.5); transition: all 0.4s ease; }
        .marquee-content img:hover { filter: grayscale(0%) opacity(1); transform: scale(1.1); cursor: pointer; }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

        /* CARTES 3D & SPOTLIGHT */
        .feature-style-5 { background-color: transparent; position: relative; z-index: 2; }
        .feature-link { text-decoration: none !important; color: inherit; display: block; height: 100%; }
        .single-feature { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.9); position: relative; overflow: hidden; transform-style: preserve-3d; border-radius: 20px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.03); }
        .single-feature::after { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(86, 204, 242, 0.15), transparent 40%); z-index: 0; transition: opacity 0.3s; opacity: 0; }
        .single-feature:hover::after { opacity: 1; }
        .single-feature::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; z-index: 2; }
        .single-feature:hover::before { transform: scaleX(1); }
        
        .icon-wrapper { background: rgba(47, 128, 237, 0.05); width: 85px; height: 85px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px auto; color: #2F80ED; font-size: 38px; transform: translateZ(40px); transition: 0.4s; z-index: 2; position: relative; }
        .content { transform: translateZ(30px); position: relative; z-index: 2; }
        .single-feature:hover .icon-wrapper { background: #2F80ED; color: #ffffff; box-shadow: 0 15px 30px rgba(47, 128, 237, 0.3); }
        .integrated-logo-badge { position: absolute; top: 25px; right: 25px; width: 35px; height: 35px; background: #ffffff; border-radius: 8px; padding: 5px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); border: 1px solid #e8edf5; z-index: 3; transform: translateZ(50px); transition: 0.4s; }
        .single-feature:hover .integrated-logo-badge { transform: translateZ(60px) scale(1.15) rotate(-5deg); box-shadow: 0 15px 25px rgba(0,0,0,0.15); }
        .feature-cta { display: inline-flex; align-items: center; font-weight: bold; color: #2F80ED; margin-top: 20px; }
        .feature-cta i { opacity: 0; transform: translateX(-10px); transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); margin-left: 5px; }
        .single-feature:hover .feature-cta i { opacity: 1; transform: translateX(0); }

        /* CARTE VIDÉO */
        .video-play-card { border: 8px solid rgba(255,255,255,0.7); border-radius: 20px; overflow: hidden; box-shadow: 0 30px 60px rgba(47, 128, 237, 0.15); position: relative; cursor: pointer; transition: 0.5s; transform-style: preserve-3d; }
        .video-play-card:hover { box-shadow: 0 40px 80px rgba(47, 128, 237, 0.3); border-color: #ffffff; }
        .play-button-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17, 24, 39, 0.2); display: flex; align-items: center; justify-content: center; transform: translateZ(50px); }
        .play-icon-circle { width: 90px; height: 90px; background: rgba(47, 128, 237, 0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; padding-left: 5px; color: white; font-size: 35px; animation: pulse-button 2s infinite; }
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div class="noise-overlay"></div>

    <div id="preloader"><h1 class="loader-logo">Intel_link<span style="color: #56CCF2;">.</span></h1></div>
    <div class="cursor-glow" id="cursorGlow"></div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar" data-aos="fade-down" data-aos-duration="1000">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            <a class="navbar-brand" href="{{ path('app_home') }}">
                                <h3 class="glitch-logo" data-text="Intel_link">Intel_link<span style="color: #56CCF2;">.</span></h3> 
                            </a>
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                                            {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 45px; height: 45px; object-fit: cover; margin-right: 10px; border: 3px solid #ffffff;">
                                            <span style="color: #323450; font-weight: 700;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileMenu">
                                            <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="lni lni-user mr-10"></i> Mon Profil</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_reclamation_index') }}"><i class="lni lni-bullhorn mr-10"></i> Mes Réclamations</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% else %}
                                    <a href="{{ path('app_login') }}" class="button radius-30 btn-liquid" style="font-weight: bold; padding: 12px 25px;">🔐 Espace Client</a>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section class="hero-section-wrapper-5">
        <div class="video-text-mask">MANAGEMENT</div>
        <div class="perspective-grid"></div>
        <div id="tsparticles"></div>

        <div class="hero-style-5" style="position: relative; z-index: 2; width: 100%;">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="hero-content-wrapper" data-aos="fade-right" data-aos-duration="1200" data-aos-delay="500">
                            <span style="color: #2F80ED; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 20px; display: block; font-size: 0.85rem; background: rgba(47,128,237,0.1); padding: 5px 15px; border-radius: 20px; width: fit-content; border: 1px solid rgba(47,128,237,0.2);">Excellence & Vision</span>
                            
                            <h1 class="mb-30" style="font-size: 4.2rem; line-height: 1.1; color: #323450; font-weight: 900; letter-spacing: -1.5px;">
                                Révélez vos talents à l'échelle <br>
                                <span class="gradient-text" id="typed-text"></span>
                            </h1>
                            
                            <p class="mb-40 mt-30" style="font-size: 1.25rem; color: #585978; line-height: 1.7;">L'infrastructure stratégique pour les esprits brillants. Pilotez vos projets, optimisez votre réseau et façonnez l'avenir de l'entreprise.</p>
                            
                            <div class="d-flex gap-4 align-items-center flex-wrap">
                                <a href="#features" class="button radius-50 btn-liquid shadow-lg" style="padding: 15px 35px; font-size: 1.1rem; font-weight: bold;">Explorer l'écosystème</a>
                                <a href="https://www.youtube.com/watch?v=LXb3EKWsInQ" class="glightbox d-flex align-items-center gap-2" style="padding: 12px 25px; font-weight: bold; border-radius: 30px; background: rgba(255,255,255,0.8); backdrop-filter: blur(5px); color: #323450; text-decoration: none; box-shadow: 0 10px 20px rgba(0,0,0,0.05); transition: 0.3s;">
                                    <i class="lni lni-play" style="font-size: 22px; color: #2F80ED;"></i> Voir la démo
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-6">
                        <div class="hero-image-container mt-5 mt-lg-0" data-aos="fade-left" data-aos-duration="1500" data-aos-delay="800">
                            <div class="parallax-badge badge-1" data-speed="-3"><i class="lni lni-network"></i> +10k Talents</div>
                            <div class="parallax-badge badge-2" data-speed="4"><i class="lni lni-bar-chart"></i> 99% Croissance</div>

                            <div class="video-play-card glightbox" href="https://www.youtube.com/watch?v=LXb3EKWsInQ" data-tilt data-tilt-glare data-tilt-max-glare="0.3" data-tilt-scale="1.02">
                                <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Networking" style="width: 100%; display: block;">
                                <div class="play-button-overlay"><div class="play-icon-circle"><i class="lni lni-play"></i></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="trusted-by-section">
        <div class="container"><div class="trusted-title" data-aos="fade-up" data-aos-duration="1000">Les entreprises qui recrutent nos talents</div></div>
        <div class="marquee-wrapper">
            <div class="marquee-content">
                <img src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg" alt="Google">
                <img src="https://upload.wikimedia.org/wikipedia/commons/9/96/Microsoft_logo_%282012%29.svg" alt="Microsoft">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg" alt="Stripe">
                <img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Cisco_logo_blue_2016.svg" alt="Cisco">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/51/IBM_logo.svg" alt="IBM">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg" alt="Amazon">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b1/Tata_Consultancy_Services_Logo.svg" alt="TCS">
                <img src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg" alt="Google">
                <img src="https://upload.wikimedia.org/wikipedia/commons/9/96/Microsoft_logo_%282012%29.svg" alt="Microsoft">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg" alt="Stripe">
                <img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Cisco_logo_blue_2016.svg" alt="Cisco">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/51/IBM_logo.svg" alt="IBM">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg" alt="Amazon">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b1/Tata_Consultancy_Services_Logo.svg" alt="TCS">
            </div>
        </div>
    </section>

    <section id="features" class="feature-style-5 pt-100 pb-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="section-title text-center mb-60" data-aos="fade-up" data-aos-duration="1000">
                        <h2 class="mb-15" style="font-weight: 900; color: #323450; font-size: 2.8rem;">L'Architecture du Succès</h2>
                        <p style="font-size: 1.25rem; color: #585978;">Quatre modules puissants, conçus pour accélérer votre évolution.</p>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-40" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                    <a href="{% if app.user %}#{% else %}{{ path('app_login') }}{% endif %}" class="feature-link">
                        <div class="single-feature radius-lg p-5 text-center h-100 spotlight-card" data-tilt data-tilt-glare data-tilt-max-glare="0.1" data-tilt-max="10">
                            <img src="https://cdn-icons-png.flaticon.com/512/174/174857.png" alt="LinkedIn" class="integrated-logo-badge">
                            <div class="icon-wrapper"><i class="lni lni-world"></i></div>
                            <div class="content">
                                <h4 class="mb-3 fw-bold" style="color: #323450;">Réseau Professionnel</h4>
                                <p class="text-muted">Échangez des stratégies, analysez les marchés et connectez-vous avec des étudiants et professionnels du monde entier.</p>
                                <span class="feature-cta">Rejoindre la discussion <i class="lni lni-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-6 col-md-6 mb-40" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
                    <a href="{% if is_granted('ROLE_RECRUTEUR') %}#{% else %}#{% endif %}" class="feature-link">
                        <div class="single-feature radius-lg p-5 text-center h-100 spotlight-card" data-tilt data-tilt-glare data-tilt-max-glare="0.1" data-tilt-max="10">
                            <img src="https://cdn-icons-png.flaticon.com/512/281/281764.png" alt="Google" class="integrated-logo-badge">
                            <div class="icon-wrapper"><i class="lni lni-briefcase"></i></div>
                            <div class="content">
                                <h4 class="mb-3 fw-bold" style="color: #323450;">Opportunités & Carrières</h4>
                                <p class="text-muted">Accédez à des offres de stages et d'emplois exclusives ciblées sur vos compétences en management et technologies.</p>
                                <span class="feature-cta">Parcourir les offres <i class="lni lni-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-6 col-md-6 mb-40" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
                    <a href="{% if is_granted('ROLE_CHEF_PROJET') %}#{% else %}#{% endif %}" class="feature-link">
                        <div class="single-feature radius-lg p-5 text-center h-100 spotlight-card" data-tilt data-tilt-glare data-tilt-max-glare="0.1" data-tilt-max="10">
                            <img src="https://cdn-icons-png.flaticon.com/512/25/25231.png" alt="GitHub" class="integrated-logo-badge">
                            <div class="icon-wrapper"><i class="lni lni-rocket"></i></div>
                            <div class="content">
                                <h4 class="mb-3 fw-bold" style="color: #323450;">Développement de Projets</h4>
                                <p class="text-muted">Mettez la théorie en pratique. Intégrez des équipes pluridisciplinaires pour piloter des stratégies innovantes.</p>
                                <span class="feature-cta">Explorer les projets <i class="lni lni-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-6 col-md-6 mb-40" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="400">
                    <a href="{% if is_granted('ROLE_FORMATEUR') %}#{% else %}#{% endif %}" class="feature-link">
                        <div class="single-feature radius-lg p-5 text-center h-100 spotlight-card" data-tilt data-tilt-glare data-tilt-max-glare="0.1" data-tilt-max="10">
                            <img src="https://cdn-icons-png.flaticon.com/512/5968/5968913.png" alt="Coursera" class="integrated-logo-badge">
