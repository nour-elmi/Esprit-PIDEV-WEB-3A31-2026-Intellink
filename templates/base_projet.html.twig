<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Intellink{% endblock %}</title>

    <!-- CSS -->
    <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.lineicons.com/4.0/lineicons.css">

    <style>
        .glass-navbar { 
            position: fixed !important; 
            top: 0; left: 0; width: 100%; z-index: 9999;
            background: rgba(248, 250, 252, 0.9) !important; 
            backdrop-filter: blur(20px); 
            border-bottom: 1px solid rgba(0,0,0,0.05); 
            transition: transform 0.4s; 
        }

        .navbar-hidden { transform: translateY(-100%); }

        .glitch-logo { position: relative; display: inline-block; text-decoration: none; }

        .glitch-img-main { 
            height: 35px; 
            display: block; 
            position: relative; 
            z-index: 2; 
        }

        .glitch-img-layer { 
            position: absolute; 
            top: 0; left: 0; 
            height: 35px; 
            width: 100%; 
            object-fit: contain; 
            opacity: 0; 
            z-index: 1; 
        }

        .glitch-logo:hover .layer-1 { 
            left: 2px; 
            opacity: 1; 
            filter: drop-shadow(-2px 0 #56CCF2); 
        }

        .glitch-logo:hover .layer-2 { 
            left: -2px; 
            opacity: 1; 
            filter: drop-shadow(2px 0 #2F80ED); 
        }

        body { padding-top: 80px; }
    </style>
</head>

<body>

<!-- ================= NAVBAR ================= -->
<header class="header header-6 glass-navbar" id="smartNavbar">
    <div class="navbar-area">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <nav class="navbar navbar-expand-lg">
                        
                        <!-- LOGO -->
                        <a class="navbar-brand glitch-logo" href="{{ path('app_home') }}">
                            <img src="{{ asset('assets/img/logo.png') }}" alt="IntelLink" class="glitch-img-main">
                            <img src="{{ asset('assets/img/logo.png') }}" class="glitch-img-layer layer-1">
                            <img src="{{ asset('assets/img/logo.png') }}" class="glitch-img-layer layer-2">
                        </a>

                        <!-- BURGER -->
                        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                            <span class="lni lni-menu"></span>
                        </button>

                        <!-- MENU -->
                        <div class="collapse navbar-collapse" id="navMenu">
                            
                        </div>

                        <!-- PROFIL -->
                        <div class="header-action d-flex align-items-center ms-3">
                            {% if app.user %}
                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center"
                                       data-bs-toggle="dropdown"
                                       style="cursor:pointer; background:#fff; padding:5px 15px 5px 5px; border-radius:50px; border:1px solid #e2e8f0;">
                                        
                                        {% if app.user.image %}
                                            {% set avatar = app.user.image starts with 'http'
                                                ? app.user.image
                                                : asset('uploads/profiles/' ~ app.user.image) %}
                                        {% else %}
                                            {% set avatar = 'https://ui-avatars.com/api/?name=' ~ app.user.nom|url_encode %}
                                        {% endif %}

                                        <img src="{{ avatar }}" style="width:35px;height:35px;border-radius:50%;margin-right:10px;">
                                        <span style="font-weight:700;">{{ app.user.nom }}</span>
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_profile') }}">
                                                Mon Profil
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                                Déconnexion
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="btn btn-primary">
                                    🔐 Connexion
                                </a>
                            {% endif %}
                        </div>

                    </nav>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- ================= END NAVBAR ================= -->


<!-- ================= CONTENT ================= -->
<div class="container" style="padding-top: 20px;">

    {% for message in app.flashes('success') %}
        <div class="alert-custom alert-success-custom">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert-custom alert-danger-custom">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert-custom alert-warning-custom">{{ message }}</div>
    {% endfor %}

    {% block body %}{% endblock %}

</div>


<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
let lastScrollTop = 0;
const navbar = document.getElementById('smartNavbar');

window.addEventListener('scroll', function() {
    let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

    if (scrollTop > lastScrollTop && scrollTop > 100) {
        navbar.classList.add('navbar-hidden');
    } else {
        navbar.classList.remove('navbar-hidden');
    }

    lastScrollTop = scrollTop;
});
</script>

</body>
</html>