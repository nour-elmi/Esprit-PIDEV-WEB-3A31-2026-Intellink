{% extends 'emploi/base_emploi.html.twig' %}

{% block title %}Toutes les offres d'emploi{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="container">
        <div class="hero-content">
            <a href="{{ path('showoffre') }}" class="back-link" style="color: rgba(255,255,255,0.7);">
                <i class="lni lni-arrow-left"></i> Accueil
            </a>
            {# 'offre' contient la liste des offres envoyée par le contrôleur #}
            <h1>Nos {{ offre|length }} offres d'emploi</h1>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">
        <div class="row g-4">
            
            <div class="col-lg-8">
                <div class="search-bar-wrapper mb-4">
                    <form action="{{ path('showoffre') }}" method="get" class="d-flex gap-2">
                        <div class="input-group-custom flex-grow-1" style="position: relative;">
                            <i class="lni lni-search-alt" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #64748b;"></i>
                            <input type="text" 
                                name="search" 
                                value="{{ searchTerm|default('') }}" 
                                placeholder="Rechercher un poste..." 
                                class="form-control-custom" 
                                style="padding-left: 45px; border: 1px solid #e2e8f0; border-radius: 12px; height: 50px; width: 100%;">
                        </div>
                        <button type="submit" class="btn-liquid px-4" style="height: 50px; border-radius: 12px; background: #2F80ED;">
                            Rechercher
                        </button>
                    </form>
                </div>

                {# Changement ici : 'for o in offre' pour ne pas confondre l'objet et la liste #}
                {% for o in offre %}
                    <div class="detail-card mb-4">
                        <div class="detail-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="detail-section-title">
                                    <i class="lni lni-briefcase"></i> {{ o.titre }}
                                </div>
                                <span class="tag tag-primary">
                                    {{ o.typeContrat ? o.typeContrat.getLabel() : 'Contrat N/A' }}
                                </span>
                            </div>
                            
                            <p class="mt-3" style="color: var(--body-color); line-height: 1.6;">
                                {{ o.description|slice(0, 200) }}...
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <span style="font-weight: 600; color: var(--primary);">
                                    <i class="lni lni-apartment"></i> {{ o.nomEntreprise }}
                                </span>
                                
                                {# CHANGEMENT CRUCIAL : On envoie l'ID de l'offre à la route addListe #}
                                <a href="{{ path('addListe', {'id_offre': o.idOffre}) }}" class="btn-liquid px-3 py-2" style="font-size: 14px; text-decoration: none; background: #2F80ED; color: white; border-radius: 8px;">
                                    Postuler
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="detail-card text-center p-5">
                        <i class="lni lni-emoji-sad" style="font-size: 3rem; color: var(--primary);"></i>
                        <p class="mt-3">Aucune offre disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

            <div class="col-lg-4">
                <div class="sidebar-sticky">
                    <div class="info-card-show" style="background: #fff; padding: 20px; border-radius: 15px; border: 1px solid #eee;">
                        <div class="info-card-header mb-3">
                            <i class="lni lni-stats-up"></i>
                            <span class="ms-2" style="font-weight: 700;">Statistiques</span>
                        </div>
                        <div class="info-card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Disponibilité</span>
                                <span style="font-weight: 700;">{{ offre|length }} Postes</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Mise à jour</span>
                                <span>Aujourd'hui</span>
                            </div>
                        </div>
                    </div>

                    <div class="actions-card-show mt-3" style="background: #f8fafc; padding: 20px; border-radius: 15px;">
                        <div class="actions-card-header mb-2" style="font-weight: 700;">
                            <i class="lni lni-star"></i> Votre Espace
                        </div>
                        <div class="actions-card-body">
                            <p class="small text-muted mb-3">Retrouvez vos candidatures envoyées sur Intellink.</p>
                            <a href="{{ path('showListe') }}" class="btn-liquid w-100 justify-content-center" style="background: #64748b; color: white; display: flex; padding: 10px; border-radius: 8px; text-decoration: none;">
                                <i class="lni lni-list me-2"></i> Mes participations
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}