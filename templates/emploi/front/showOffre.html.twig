{% extends 'emploi/base_emploi.html.twig' %}

{% block title %}Toutes les offres d'emploi{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="container">
        <div class="hero-content">
            <a href="{{ path('showoffre') }}" class="back-link" style="color: rgba(255,255,255,0.7);">
                <i class="lni lni-arrow-left"></i> Accueil
            </a>
            {# On utilise 'liste' qui est le nom envoyé par ton contrôleur #}
            <h1>Nos {{ offre|length }} offres d'emploi</h1>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">
        <div class="row g-4">
            
            <div class="col-lg-8">
            <div class="search-bar-wrapper mb-4">
                <form action="{{ path('showoffre') }}" method="get" class="d-flex gap-2">
                    <div class="input-group-custom flex-grow-1" style="position: relative;">
                        <i class="lni lni-search-alt" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #64748b;"></i>
                        <input type="text" 
                            name="search" 
                            value="{{ searchTerm }}" 
                            placeholder="Rechercher un poste ou une entreprise..." 
                            class="form-control-custom" 
                            style="padding-left: 45px; border: 1px solid #e2e8f0; border-radius: 12px; height: 50px; width: 100%;">
                    </div>
                    <button type="submit" class="btn-liquid px-4" style="height: 50px; border-radius: 12px; background: #2F80ED;">
                        Rechercher
                    </button>
                    {% if searchTerm %}
                        <a href="{{ path('showoffreRecruteur') }}" class="btn-liquid px-4" style="height: 50px; border-radius: 12px; background: #64748b; display: flex; align-items: center; justify-content: center;">
                            Réinitialiser
                        </a>
                    {% endif %}
                </form>
            </div>

            {% if searchTerm and offre is empty %}
                <div class="alert alert-info text-center" style="border-radius: 15px;">
                    <i class="lni lni-search"></i> Aucun résultat pour "<strong>{{ searchTerm }}</strong>"
                </div>
            {% endif %}
                {% for offre in offre %}
                    <div class="detail-card mb-4">
                        <div class="detail-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="detail-section-title">
                                    <i class="lni lni-briefcase"></i> {{ offre.titre }}
                                </div>
                                <span class="tag tag-primary">
                                    {{ offre.typeContrat ? offre.typeContrat.getLabel() : 'Contrat N/A' }}
                                </span>
                            </div>
                            
                            <p class="mt-3" style="color: var(--body-color); line-height: 1.6;">
                                {{ offre.description|slice(0, 200) }}...
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <span style="font-weight: 600; color: var(--primary);">
                                    <i class="lni lni-apartment"></i> {{ offre.nomEntreprise }}
                                </span>
                                <a href="#" class="btn-liquid px-3 py-2" style="font-size: 14px;">
                                    Voir les détails
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="detail-card text-center p-5">
                        <i class="lni lni-emoji-sad" style="font-size: 3rem; color: var(--primary);"></i>
                        <p class="mt-3">Aucune offre disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

            <div class="col-lg-4">
                <div class="sidebar-sticky">
                    <div class="info-card-show">
                        <div class="info-card-header">
                            <i class="lni lni-information"></i>
                            <span>Statistiques</span>
                        </div>
                        <div class="info-card-body">
                            <div class="info-item">
                                <span class="info-item-label">Disponibilité</span>
                                <span class="info-item-value">
                                    {{ offre|length }} Postes à pourvoir
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-item-label">Dernière mise à jour</span>
                                <span class="info-item-value">Aujourd'hui</span>
                            </div>
                        </div>
                    </div>

                    <div class="actions-card-show">
                        <div class="actions-card-header">
                            <i class="lni lni-star"></i>
                            <span>Votre Espace</span>
                        </div>
                        <div class="actions-card-body">
                            <p class="small text-muted mb-3">Postulez en un clic avec votre profil Intellink.</p>
                            <a href="#" class="btn-liquid w-100 justify-content-center">
                                <i class="lni lni-cloud-upload me-2"></i> Déposer mon CV
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}