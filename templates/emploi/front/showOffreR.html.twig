{% extends 'emploi/base_emploi.html.twig' %}

{% block title %}Espace Recruteur — Gestion des Offres{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="container">
        <div class="hero-content">
            <a href="{{ path('app_home') }}" class="back-link" style="color: rgba(255,255,255,0.7);">
                <i class="lni lni-arrow-left"></i> Tableau de bord
            </a>
            <h1>Vos {{ offre|length }} offres publiées</h1>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">
        <div class="row g-4">
            
            <div class="col-lg-8">
            <div class="search-bar-wrapper mb-4">
                <form action="{{ path('showoffreRecruteur') }}" method="get" class="row g-2 align-items-center">
                    
                    <div class="col-md-5">
                        <div class="input-group-custom" style="position: relative;">
                            <i class="lni lni-search-alt" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #64748b;"></i>
                            <input type="text" name="search" value="{{ searchTerm }}" 
                                placeholder="Rechercher..." class="form-control-custom" 
                                style="padding-left: 45px; height: 45px; width: 100%;">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <select name="sortBy" class="form-control-custom" style="height: 45px; cursor: pointer;" onchange="this.form.submit()">
                            <option value="" selected disabled>Options de tri</option>
                            <option value="salaire_desc" {{ currentSort == 'salaire_desc' ? 'selected' }}>Salaire : Plus élevé</option>
                            <option value="salaire_asc" {{ currentSort == 'salaire_asc' ? 'selected' }}>Salaire : Plus bas</option>
                            <option value="expiration_asc" {{ currentSort == 'expiration_asc' ? 'selected' }}>Expire bientôt</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        {% if searchTerm or currentSort %}
                            <a href="{{ path('showoffreRecruteur') }}" class="btn-liquid justify-content-center" style="height: 45px; background: #64748b;">
                                <i class="lni lni-close"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
                {% for o in offre %}
                    <div class="detail-card mb-4">
                        <div class="detail-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="detail-section-title">
                                    <i class="lni lni-briefcase"></i> {{ o.titre }}
                                </div>

                                <div class="d-flex flex-column align-items-end gap-2">
                                    {# 1. Type de Contrat #}
                                    <span class="tag tag-primary">
                                        {{ o.typeContrat ? o.typeContrat.getLabel() : 'Contrat N/A' }}
                                    </span>
                                    
                                    {# 2. Salaire #}
                                    <span class="tag tag-success" style="background: rgba(40, 167, 69, 0.1); color: #28a745; border: 1px solid #28a745;">
                                        <i class="lni lni-money-location"></i> {{ o.salaire ? o.salaire ~ ' DT' : 'Salaire N/A' }}
                                        {#time bundle#}
                                        <i class="lni lni-timer"></i> 
                                        {% if o.dateExpiration %}
                                            Expire {{ o.dateExpiration|ago }} (le {{ o.dateExpiration|date('d/m/Y') }})
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                            
                            <p class="mt-3" style="color: var(--body-color); line-height: 1.6;">
                                {{ o.description|slice(0, 180) }}...
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <span style="font-weight: 600; color: var(--primary);">
                                    <i class="lni lni-users"></i> 
                                    {# Utilise .listeParticipations|length pour compter les relations #}
                                    {{ o.listeParticipations|length }} Candidatures reçues
                                </span>
                                <div class="d-flex gap-2">
                                    <a href="{{path('updateOffre', {id: o.idOffre})}}" class="btn-liquid px-3 py-2" style="font-size: 14px; background: linear-gradient(135deg, #6c757d, #495057);">
                                        <i class="lni lni-pencil"></i> Modifier
                                    </a>
                                    <a href="{{ path ('deleteOffre', {id: o.idOffre}) }}" class="btn-liquid px-3 py-2" style="font-size: 14px; background: linear-gradient(135deg,rgb(231, 75, 75),rgb(165, 63, 63));">
                                        <i class="lni lni-pencil"></i> Supprimer
                                    </a>
                                    <a href="{{ path('showListe', {'id_offre': o.idOffre}) }}" class="btn-liquid px-3 py-2" style="font-size: 14px;">
                                        Participants
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="detail-card text-center p-5">
                        <i class="lni lni-empty-file" style="font-size: 3rem; color: var(--primary);"></i>
                        <p class="mt-3">Vous n'avez pas encore publié d'offre d'emploi.</p>
                    </div>
                {% endfor %}
                <div class="navigation d-flex justify-content-center mt-4">
                {{ knp_pagination_render(offre) }}
            </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-sticky">
                    <div class="info-card-show">
                        <div class="info-card-header">
                            <i class="lni lni-stats-up"></i>
                            <span>Performance</span>
                        </div>
                        <div class="info-card-body">
                            <div class="info-item">
                                <span class="info-item-label">Offres actives</span>
                                <h1>Vos {{ offre.getTotalItemCount }} offres publiées</h1>
                            </div>
                            <div class="info-item">
                                <span class="info-item-label">Vues totales</span>
                                <span class="info-item-value">{{ offre.getTotalItemCount }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="actions-card-show">
                        <div class="actions-card-header">
                            <i class="lni lni-plus"></i>
                            <span>Actions Recruteur</span>
                        </div>
                        <div class="actions-card-body">
                            <p class="small text-muted mb-3">Besoin de nouveaux talents ? Publiez une nouvelle annonce dès maintenant.</p>
                            {# Remplace 'app_emploi_new' par le nom de ta route de création #}
                            <a href="addOffre" class="btn-liquid w-100 justify-content-center">
                                <i class="lni lni-circle-plus me-2"></i> Ajouter une offre
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}