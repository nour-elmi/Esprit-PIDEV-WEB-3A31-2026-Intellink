{% extends 'emploi/base_emploi.html.twig' %}

{% block title %}Liste des Participations{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="container">
        <div class="hero-content">
            <a href="{{ path('showListe') }}" class="back-link" style="color: rgba(255,255,255,0.7);">
                <i class="lni lni-home"></i> Dashboard
            </a>
            {# On utilise la variable offre passée par le controller pour le count #}
            <h1>{{ lesParticipations.getTotalItemCount }} Candidatures enregistrées</h1>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="search-bar-wrapper mb-4">
                    <form action="{{ path('showListe') }}" method="get" class="d-flex gap-2">
                        <div class="input-group-custom flex-grow-1" style="position: relative;">
                            <i class="lni lni-search-alt" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #64748b;"></i>
                            <input type="text" name="search" value="{{ searchTerm|default('') }}" placeholder="Rechercher un candidat..." class="form-control-custom" style="padding-left: 45px; border: 1px solid #e2e8f0; border-radius: 12px; height: 50px; width: 100%;">
                        </div>
                        <button type="submit" class="btn-liquid px-4" style="height: 50px; border-radius: 12px; background: #2F80ED;">Rechercher</button>
                    </form>
                </div>

                {# Utilisation de la variable correcte définie dans le controller #}
                {% for p in lesParticipations %}
                    <div class="detail-card mb-4">
                        <div class="detail-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="detail-section-title">
                                    <i class="lni lni-user"></i> {{ p.prenomP }} {{ p.nomP }}
                                </div>
                                <span class="tag" style="background: #f1f5f9; padding: 5px 10px; border-radius: 5px;">
                                    {# On évite .name pour ne pas déclencher l'erreur de résolution d'ID #}
                                    {{ p.statut.value|default('En attente') }}
                                </span>
                            </div>
                            
                            <p class="mt-3" style="color: #64748b;">
                                <strong>Compétences :</strong> {{ p.skills|slice(0, 150) }}...
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <span style="font-weight: 600; color: #2F80ED;">
                                    <i class="lni lni-target"></i> Score : {{ p.score }} pts
                                </span>
                                <div class="ai-score-container" data-id="{{ p.idParticipation }}"></div>
                                <div class="d-flex gap-2">
                                    {# On utilise le vrai nom de ton getter id_participation #}
                                    <a href="{{ path('addListe', {'id_offre': p.idOffre.idOffre}) }}" class="btn-liquid px-3 py-2" style="font-size: 14px; background: #64748b; color: white; border-radius: 8px; text-decoration: none;">
                                        Modifier
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="detail-card text-center p-5">
                        <i class="lni lni-empty-file" style="font-size: 3rem; color: #2F80ED;"></i>
                        <p class="mt-3">Aucune participation trouvée.</p>
                    </div>
                {% endfor %}
                <div class="navigation d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(lesParticipations) }}
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-sticky">
                    <div class="info-card-show" style="background: #fff; padding: 20px; border-radius: 15px; border: 1px solid #eee;">
                        <div class="info-card-header mb-3">
                            <i class="lni lni-stats-up"></i>
                            <span class="ms-2" style="font-weight: 700;">Stats</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Total</span>
                            <strong>{{ lesParticipations.getTotalItemCount }}</strong>
                        </div>
                    </div>{#
                    <a href="{{ path('addListe') }}" class="btn-liquid w-100 justify-content-center mt-3" style="padding: 15px; background: #2F80ED; color: white; display: flex; border-radius: 10px; text-decoration: none;">
                        <i class="lni lni-plus me-2"></i> Ajouter
                    </a>#}
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const scoreContainers = document.querySelectorAll('.ai-score-container');
    
    // On suppose que tous les containers appartiennent à la même offre sur cette page
    // On récupère l'ID de l'offre depuis un attribut data sur un élément parent ou l'URL
    const idOffre = window.location.pathname.split('/').pop(); 

    fetch(`/api/recommendations/${idOffre}`)
        .then(response => response.json())
        .then(data => {
            // data est un tableau : [{id: 1, score: 49, level: "Moyenne"}, ...]
            scoreContainers.forEach(container => {
                const participantId = parseInt(container.getAttribute('data-id'));
                
                // On trouve les datas correspondant à CE participant
                const match = data.find(item => item.id === participantId);

                if (match) {
                    let badgeClass = 'bg-danger'; // Par défaut : Faible
                    if (match.score >= 75) badgeClass = 'bg-success';
                    else if (match.score >= 50) badgeClass = 'bg-primary';
                    else if (match.score >= 25) badgeClass = 'bg-warning';

                    container.innerHTML = `
                        <div class="mt-2">
                            <span class="badge ${badgeClass} p-2 shadow-sm animate__animated animate__fadeIn">
                                <i class="fas fa-robot"></i> Compatibilité ${match.level} : ${match.score}%
                            </span>
                        </div>
                    `;
                } else {
                    container.innerHTML = `<span class="badge bg-secondary">Analyse en attente</span>`;
                }
            });
        })
        .catch(error => console.error('Erreur IA:', error));
});
</script>
{% endblock %}