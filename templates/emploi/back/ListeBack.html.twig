{# templates/emploi/back/ListeBack.html.twig #}

{% extends 'emploi/back/back_emploi.html.twig' %}

{# 1. Sécurité sur le titre du bloc #}
{% block title %}Candidatures - {{ offreChoisie?.titre ?? 'Toutes les offres' }}{% endblock %}

{% block body %}
<div class="page-header">
    {# 2. Sécurité sur l'en-tête #}
    <h3 class="fw-bold mb-3">
        Candidatures — {{ offreChoisie ? offreChoisie.titre : 'Vue Globale' }}
    </h3>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card mb-3" style="border-left: 4px solid #4d8aff;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    {# 3. Sécurité sur les détails de l'offre #}
                    <h5 class="mb-1">
                        {% if offreChoisie %}
                            {{ offreChoisie.titre }} ({{ offreChoisie.nomEntreprise }})
                        {% else %}
                            Récapitulatif de toutes les participations
                        {% endif %}
                    </h5>
                    <span class="badge badge-primary">{{ lesParticipations.getTotalItemCount }} candidat(s) au total</span>
                </div>
                <a href="{{ path('showoffreBack') }}" class="btn btn-secondary btn-sm">
                    <i class="fa fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Liste des Participants</h4>
            </div>
            <div class="card-body">
                {% if lesParticipations is empty %}
                    <div class="text-center py-5">
                        <p class="text-muted">Aucune candidature enregistrée.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Nom du Candidat</th>
                                    <th>Date de Postulation</th>
                                    <th>Score / Match</th>
                                    <th>Statut </th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for p in lesParticipations %}
                                <tr>
                                    <td><strong>{{ p.NomP }}</strong></td>
                                    <td>{{ p.DateParticipation|date('d/m/Y') }}</td>
                                    <td>
                                        <span class="badge {% if p.score >= 7 %}badge-success{% else %}badge-warning{% endif %}">
                                            {{ p.score ?? '0' }}/10
                                        </span>
                                    </td>
                                    <td>
                                        {# Menu Déroulant pour le Statut #}
                                        <div class="dropdown">
                                            <button class="btn btn-sm dropdown-toggle 
                                                {% if p.statut.value == 'acceptee' %}btn-success
                                                {% elseif p.statut.value == 'refusee' %}btn-danger
                                                {% else %}btn-info{% endif %}" 
                                                type="button" 
                                                data-bs-toggle="dropdown" 
                                                aria-expanded="false">
                                                
                                                {# Affichage du texte avec la bonne orthographe pour le test #}
                                                {% if p.statut.value == 'acceptee' %}
                                                    Acceptée
                                                {% elseif p.statut.value == 'refusee' %}
                                                    Refusée
                                                {% else %}
                                                    En attente
                                                {% endif %}
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    {# Correction ici : 'en_attente' au lieu de 'aceptee' #}
                                                    <a class="dropdown-item" href="{{ path('updateStatut', {'id': p.idParticipation, 'nouveauStatut': 'en_attente'}) }}">
                                                        <i class="fa fa-clock text-info"></i> En attente
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="{{ path('updateStatut', {'id': p.idParticipation, 'nouveauStatut': 'acceptee'}) }}">
                                                        <i class="fa fa-check text-success"></i> Accepter
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="{{ path('updateStatut', {'id': p.idParticipation, 'nouveauStatut': 'refusee'}) }}">
                                                        <i class="fa fa-times text-danger"></i> Refuser
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                    <td>
                                        {# On ne garde que le bouton supprimer ici pour nettoyer l'interface #}
                                        <a href="{{ path('deleteListe', {'id': p.idParticipation}) }}" 
                                        class="btn btn-outline-danger btn-sm" 
                                        onclick="return confirm('Supprimer cette candidature ?')">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="navigation d-flex justify-content-center mt-4">
                        {{ knp_pagination_render(lesParticipations) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}