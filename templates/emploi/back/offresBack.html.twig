{% extends 'emploi/back/back_emploi.html.twig' %}

{% block title %}Gestion des Offres{% endblock %}

{% block body %}
<div class="page-header">
    <h3 class="fw-bold mb-3">Gestion des Offres d'Emploi</h3>
</div>

{# Section Statistiques #}
<div class="row mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-icon">
                        <div class="icon-big text-center icon-primary bubble-shadow-small" style="background: #2F80ED; color: white; border-radius: 50%; width: 50px; height: 50px; line-height: 50px;">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                    <div class="col col-stats ms-3">
                        <div class="numbers">
                            <p class="card-category" style="color: #64748b; font-size: 12px; margin-bottom: 0;">Moyenne Candidats / Offre</p>
                            <h4 class="card-title" style="font-weight: 700; font-size: 20px;">{{ stats.moyenne }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-icon">
                        <div class="icon-big text-center icon-warning bubble-shadow-small" style="background: #F2994A; color: white; border-radius: 50%; width: 50px; height: 50px; line-height: 50px;">
                            <i class="fas fa-hourglass-half"></i>
                        </div>
                    </div>
                    <div class="col col-stats ms-3">
                        <div class="numbers">
                            <p class="card-category" style="color: #64748b; font-size: 12px; margin-bottom: 0;">Alertes Expiration (15 sem.)</p>
                            <h4 class="card-title" style="font-weight: 700; font-size: 20px;">{{ stats.countAlert }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-icon">
                        <div class="icon-big text-center icon-success bubble-shadow-small" style="background: #27AE60; color: white; border-radius: 50%; width: 50px; height: 50px; line-height: 50px;">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                    <div class="col col-stats ms-3">
                        <div class="numbers">
                            <p class="card-category" style="color: #64748b; font-size: 12px; margin-bottom: 0;">Total Candidatures</p>
                            <h4 class="card-title" style="font-weight: 700; font-size: 20px;">{{ stats.totalCandidatures }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <h4 class="card-title mb-0">Liste des Offres ({{ offre.getTotalItemCount }})</h4>
                    
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <input type="text" id="searchInput" placeholder="Rechercher une offre..." 
                               class="form-control" style="border-radius: 25px; width: 250px;">
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Titre du Poste</th>
                                <th>Entreprise</th>
                                <th>Type</th>
                                <th>Candidatures</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for emploi in offre %}
                            <tr class="offre-row" data-titre="{{ emploi.titre|lower }}">
                                <td><strong>{{ emploi.titre }}</strong></td>
                                <td>{{ emploi.nomEntreprise }}</td>
                                <td><span class="badge badge-info">{{ emploi.typeContrat.value }}</span></td>
                                <td>
                                    <span class="badge badge-primary">
                                        <i class="fas fa-users me-1"></i>{{ emploi.listeParticipations|length }}
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="{{ path('showListeBack', {'id': emploi.id}) }}" class="btn btn-primary btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        {# NOUVEAU BOUTON GAP ANALYSIS #}
                                        <button type="button" 
                                                class="btn btn-info btn-sm gap-analysis-btn" 
                                                data-id="{{ emploi.id }}"
                                                data-bs-toggle="tooltip" 
                                                data-bs-html="true" 
                                                title="Chargement de l'analyse...">
                                            <i class="fas fa-brain"></i>
                                        </button>

                                        <a href="#" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="navigation d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(offre) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function () {
    $('#searchInput').on('input', function() {
        var value = $(this).val().toLowerCase();
        $('.offre-row').filter(function() {
            $(this).toggle($(this).data('titre').indexOf(value) > -1)
        });
    });
});

//analysis gap
$(document).ready(function () {
    // Initialisation des tooltips Bootstrap
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });

    // Gestion du survol dynamique
    $('.gap-analysis-btn').on('mouseenter', function () {
        const btn = $(this);
        const id = btn.data('id');
        const tooltip = bootstrap.Tooltip.getInstance(this);

        // On ne fait l'appel que si on n'a pas déjà chargé l'info
        if (btn.attr('data-loaded') !== 'true') {
            fetch(`/api/gap-analysis/${id}`)
                .then(res => res.json())
                .then(data => {
                    btn.attr('data-bs-original-title', data.html);
                    tooltip.show(); // Forcer la mise à jour de l'affichage
                    btn.attr('data-loaded', 'true');
                });
        }
    });

    // Ton code de recherche existant
    $('#searchInput').on('input', function() {
        var value = $(this).val().toLowerCase();
        $('.offre-row').filter(function() {
            $(this).toggle($(this).data('titre').indexOf(value) > -1)
        });
    });
});
</script>
{% endblock %}