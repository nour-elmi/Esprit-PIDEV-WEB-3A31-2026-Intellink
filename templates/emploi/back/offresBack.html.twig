{% extends 'emploi/back_emploi.html.twig' %}

{% block title %}Gestion des Offres — Intellink{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="page-header mb-4">
        <h3 class="fw-bold mb-1">Gestion des Offres d'Emploi</h3>
        <p class="text-muted small">Administration du module recrutement</p>
    </div>

    {# Section Statistiques #}
    <div class="row mb-4 g-3">
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box text-center" style="background: #eef2ff; color: #2F80ED; border-radius: 12px; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-chart-line fa-lg"></i>
                        </div>
                        <div class="ms-3">
                            <p class="text-muted mb-0 small">Moyenne Candidats / Offre</p>
                            <h2 class="mb-0 fw-bold">{{ stats.moyenne }}</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box text-center" style="background: #fff7ed; color: #F2994A; border-radius: 12px; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-hourglass-half fa-lg"></i>
                        </div>
                        <div class="ms-3">
                            <p class="text-muted mb-0 small">Alertes Expiration (15 sem.)</p>
                            <h2 class="mb-0 fw-bold">{{ stats.countAlert }}</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box text-center" style="background: #f0fdf4; color: #27AE60; border-radius: 12px; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-user-check fa-lg"></i>
                        </div>
                        <div class="ms-3">
                            <p class="text-muted mb-0 small">Total Candidatures</p>
                            <h2 class="mb-0 fw-bold">{{ stats.totalCandidatures }}</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Tableau des Offres #}
    <div class="row">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                <div class="card-header bg-white border-0 py-4 px-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap">
                        <h4 class="card-title mb-0 fw-bold">Liste des Offres ({{ offre.getTotalItemCount }})</h4>
                        <div class="search-box">
                            <input type="text" id="searchInput" placeholder="Rechercher une offre..." 
                                   class="form-control border-0 bg-light px-4" style="border-radius: 10px; width: 280px; height: 40px;">
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr style="text-transform: uppercase; font-size: 11px; letter-spacing: 1px; color: #64748b;">
                                    <th class="ps-4 py-3">Titre du Poste</th>
                                    <th>Entreprise</th>
                                    <th>Type</th>
                                    <th class="text-center">Candidatures</th>
                                    <th class="text-center pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for emploi in offre %}
                                <tr class="offre-row" data-titre="{{ emploi.titre|lower }}" style="border-bottom: 1px solid #f1f5f9; transition: 0.3s;">
                                    <td class="ps-4">
                                        <span class="fw-semibold text-dark">{{ emploi.titre }}</span>
                                    </td>
                                    <td class="text-muted">{{ emploi.nomEntreprise }}</td>
                                    <td>
                                        {% if emploi.typeContrat.value == 'Freelance' %}
                                            <span class="badge" style="background-color: #e0f2fe; color: #0369a1;">Freelance</span>
                                        {% elseif emploi.typeContrat.value == 'CDI' %}
                                            <span class="badge" style="background-color: #e0e7ff; color: #4338ca;">CDI</span>
                                        {% else %}
                                            <span class="badge" style="background-color: #ccfbf1; color: #0f766e;">Stage</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-light text-primary px-3">
                                            <i class="fas fa-users me-1"></i>{{ emploi.listeParticipations|length }}
                                        </span>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <div class="d-flex gap-2 justify-content-center">
                                            <a href="{{ path('showListeBack', {'id': emploi.id}) }}" class="btn btn-sm btn-light text-primary border shadow-none">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-light text-info border gap-analysis-btn shadow-none" 
                                                    data-id="{{ emploi.id }}" data-bs-toggle="tooltip" data-bs-html="true" title="Analyse IA">
                                                <i class="fas fa-brain"></i>
                                            </button>
                                            <a href="#" class="btn btn-sm btn-light text-danger border shadow-none" onclick="return confirm('Supprimer définitivement ?')">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="navigation d-flex justify-content-center py-4">
                        {{ knp_pagination_render(offre) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    // Tooltips Bootstrap 5
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });

    // Recherche instantanée
    $('#searchInput').on('input', function() {
        var value = $(this).val().toLowerCase();
        $('.offre-row').filter(function() {
            $(this).toggle($(this).data('titre').indexOf(value) > -1)
        });
    });

    // Gap Analysis (IA)
$('.gap-analysis-btn').on('mouseenter', function () {
    const btn = $(this);
    const id = btn.data('id');
    
    if (btn.attr('data-loaded') !== 'true') {
        // Optionnel : Ajouter un spinner pendant le chargement
        btn.html('<i class="fas fa-spinner fa-spin"></i>');

        fetch(`/api/gap-analysis/${id}`)
            .then(res => res.json())
            .then(data => {
                // On met à jour le contenu
                btn.attr('data-bs-original-title', data.html);
                
                // On réinitialise le tooltip pour qu'il prenne en compte le nouveau HTML
                const tooltip = bootstrap.Tooltip.getInstance(btn[0]);
                tooltip.show();
                
                btn.html('<i class="fas fa-brain"></i>'); // Remet l'icône cerveau
                btn.attr('data-loaded', 'true');
            });
    }
});
});
</script>
{% endblock %}