<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Emploi App{% endblock %} — Intellink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.lineicons.com/4.0/lineicons.css">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/formation.css') }}">
    <style>
        .glass-navbar { 
            position: fixed !important; top: 0; left: 0; width: 100%; z-index: 9999;
            background: rgba(248, 250, 252, 0.9) !important; 
            backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0,0,0,0.05); 
            transition: transform 0.4s; 
        }
        .navbar-hidden { transform: translateY(-100%); }
        .glitch-logo { position: relative; display: inline-block; text-decoration: none; }
        .glitch-img-main { height: 35px; display: block; position: relative; z-index: 2; transition: 0.3s; }
        .glitch-img-layer { position: absolute; top: 0; left: 0; height: 35px; width: 100%; object-fit: contain; opacity: 0; z-index: 1; }
        .glitch-logo:hover .layer-1 { left: 2px; opacity: 1; filter: drop-shadow(-2px 0 #56CCF2); }
        .glitch-logo:hover .layer-2 { left: -2px; opacity: 1; filter: drop-shadow(2px 0 #2F80ED); }
        .btn-liquid { 
            position: relative; overflow: hidden; z-index: 1; transition: 0.3s; 
            background: linear-gradient(135deg, #2F80ED, #56CCF2); color: #ffffff !important; 
            border: none; padding: 10px 25px; border-radius: 14px; 
            font-weight: 700; cursor: pointer; display: inline-flex; align-items: center;
            text-decoration: none;
        }
        body { padding-top: 70px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<header class="header header-6 glass-navbar" id="smartNavbar">
    <div class="navbar-area">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <nav class="navbar navbar-expand-lg">
                        <a class="navbar-brand glitch-logo" href="{{ path('app_home') }}">
                            <img src="{{ asset('assets/img/logo.png') }}" alt="IntelLink" class="glitch-img-main">
                            <img src="{{ asset('assets/img/logo.png') }}" alt="" class="glitch-img-layer layer-1">
                            <img src="{{ asset('assets/img/logo.png') }}" alt="" class="glitch-img-layer layer-2">
                        </a>
                        <div class="header-action d-flex align-items-center ms-auto">
                            {% if app.user %}
                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" id="profileMenu" data-bs-toggle="dropdown">
                                        {% if app.user.image %}
                                            <img src="{{ asset('uploads/profiles/' ~ app.user.image) }}" alt="Profil" style="width: 35px; height: 35px; border-radius: 50%;">
                                        {% endif %}
                                        <span class="ms-2" style="color: #0f172a; font-weight: 700;">{{ app.user.nom }}</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="{{ path('app_profile') }}">Mon Profil</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Se déconnecter</a></li>
                                    </ul>
                                </div>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="btn-liquid">🔐 Console d'Accès</a>
                            {% endif %}
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</header>

{% block body %}{% endblock %}



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let lastScrollTop = 0;
    const navbar = document.getElementById('smartNavbar');
    window.addEventListener('scroll', function() {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        if (scrollTop > lastScrollTop && scrollTop > 100) navbar.classList.add('navbar-hidden');
        else navbar.classList.remove('navbar-hidden');
        lastScrollTop = scrollTop;
    });
</script>
{% block javascripts %}{% endblock %}
</body>
</html>