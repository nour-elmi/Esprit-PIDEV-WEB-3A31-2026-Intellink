{% extends 'base.html.twig' %}

{% block title %}Configuration Authenticator - IntelLink{% endblock %}

{% block body %}
<div style="background-color: #e2e8f0; min-height: 100vh; padding-top: 80px; font-family: 'Heebo', sans-serif;">
    <div style="max-width: 600px; margin: 0 auto; text-align: center; background: #ffffff; padding: 50px; border-radius: 24px; box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);">
        
        <div style="width: 70px; height: 70px; background: rgba(47, 128, 237, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: #2F80ED; font-size: 32px;">
            <i class="lni lni-mobile"></i>
        </div>

        <h2 style="color: #0f172a; font-weight: 800; font-size: 28px;">Liez votre Smartphone</h2>
        <p style="color: #64748b; font-size: 15px; margin-bottom: 30px;">Ouvrez l'application <strong>Google Authenticator</strong> et scannez le QR Code ci-dessous pour sécuriser votre compte IntelLink.</p>
        
        <div style="background: #f8fafc; padding: 20px; border-radius: 16px; display: inline-block; margin-bottom: 30px; border: 2px dashed #cbd5e1;">
            <img src="{{ qrCodeUrl }}" alt="QR Code Google Authenticator" style="border-radius: 8px;">
        </div>

        <div style="margin-bottom: 40px;">
            <p style="font-size: 13px; color: #94a3b8; margin-bottom: 10px; text-transform: uppercase; font-weight: 700;">Impossible de scanner ? Saisissez cette clé :</p>
            <code style="background: rgba(47, 128, 237, 0.05); border: 1px solid rgba(47, 128, 237, 0.2); padding: 12px 24px; border-radius: 12px; font-size: 20px; color: #2F80ED; font-weight: 800; letter-spacing: 3px;">
                {{ secret }}
            </code>
        </div>

        <a href="{{ path('app_profile') }}" style="background: #10b981; color: white; padding: 14px 35px; border-radius: 50px; text-decoration: none; font-weight: 700; display: inline-block; transition: 0.3s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);">
            <i class="lni lni-checkmark-circle me-1"></i> J'ai scanné le code, retour au profil
        </a>
    </div>
</div>
{% endblock %}