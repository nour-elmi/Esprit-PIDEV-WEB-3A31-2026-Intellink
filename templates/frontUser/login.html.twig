        <div id="forgot-step-1">
            <div class="input-group" style="max-width: 100%;">
                <input type="email" id="reset_email_input" placeholder="Entrez votre e-mail..." style="width: 100%; border: 2px solid #e8edf5; padding-left: 40px; border-radius: 8px; margin-bottom: 10px;" required onfocus="this.style.borderColor='#2F80ED'" onblur="this.style.borderColor='#e8edf5'">
