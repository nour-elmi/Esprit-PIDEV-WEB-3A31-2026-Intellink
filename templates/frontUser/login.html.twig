{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.7.2/vanilla-tilt.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tsparticles-slim@2.0.6/tsparticles.slim.bundle.min.js"></script>

<script>
    // 1. ANIMATION DES PANNEAUX COULISSANTS
    const signUpButton = document.getElementById('signUpBtn');
    const signInButton = document.getElementById('signInBtn');
    const container = document.getElementById('auth-container');

    signUpButton.addEventListener('click', () => { container.classList.add("right-panel-active"); });
    signInButton.addEventListener('click', () => { container.classList.remove("right-panel-active"); });

    // 2. TOGGLE MOT DE PASSE (Sans conflit d'icônes natives)
    function togglePassword(inputId, buttonElement) {
        const input = document.getElementById(inputId);
        const icon = buttonElement.querySelector('i');
        if (input.type === "password") { input.type = "text"; icon.className = "lni lni-eye-crossed"; } 
        else { input.type = "password"; icon.className = "lni lni-eye"; }
    }

    // 3. BARRE DE FORCE ET VALIDATION MOT DE PASSE
    function checkStrength(password) {
        const bar = document.getElementById('strength-bar');
        const len = password.length;
        let percentage = Math.min((len / 8.0) * 100, 100);
        bar.style.width = percentage + "%";
        if (len >= 8) { bar.style.backgroundColor = "#2F80ED"; } 
        else if (len >= 5) { bar.style.backgroundColor = "#56CCF2"; } 
        else { bar.style.backgroundColor = "#e74c3c"; }
        validateRegistration();
    }

    function validateRegistration() {
        const password = document.getElementById('signup-password').value;
        const confirm = document.getElementById('confirm-password').value;
        const submitBtn = document.getElementById('regSubmitBtn');
        const errorMsg = document.getElementById('match-error');
        const isMatch = (password === confirm && password !== "");
        if (confirm !== "" && !isMatch) { errorMsg.style.display = "block"; } else { errorMsg.style.display = "none"; }
        if (isMatch && password.length >= 8) { submitBtn.disabled = false; } else { submitBtn.disabled = true; }
    }

    // 4. ANIMATION POP DE L'AVATAR
    function triggerAvatarPop() {
        const img = document.getElementById('avatar-preview');
        img.classList.remove('pop'); void img.offsetWidth; img.classList.add('pop');
    }
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) { document.getElementById('avatar-preview').src = e.target.result; document.getElementById('avatar_url_input').value = ""; triggerAvatarPop(); }
            reader.readAsDataURL(input.files[0]);
        }
    }
    function selectAvatar(url) {
        document.getElementById('avatar-preview').src = url; document.getElementById('avatar_url_input').value = url; 
        document.getElementById('image_profil').value = ''; document.getElementById('avatarModal').style.display = 'none'; triggerAvatarPop();
    }
    function closeModal(event) { if (event.target.id === 'avatarModal') { document.getElementById('avatarModal').style.display = 'none'; } }
    function updateFileName(input) {
        const label = document.getElementById('pdf-file-name');
        if (input.files && input.files[0]) { label.textContent = input.files[0].name; label.style.color = "#0598ff"; label.style.fontWeight = "bold"; } 
        else { label.textContent = "Aucun fichier"; label.style.color = "gray"; label.style.fontWeight = "normal"; }
    }

    // 5. MOUSE TILT & PARTICULES
    container.addEventListener("mousemove", (e) => {
        const rect = container.getBoundingClientRect();
        container.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        container.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
    });
    tsParticles.load("tsparticles", {
        fpsLimit: 60, interactivity: { events: { onHover: { enable: true, mode: "grab" }, onClick: { enable: true, mode: "push" } }, modes: { grab: { distance: 150, links: { opacity: 0.5 } } } },
        particles: { color: { value: "#0598ff" }, links: { color: "#2F80ED", distance: 150, enable: true, opacity: 0.3, width: 1 }, move: { enable: true, speed: 1.2, direction: "none", random: false, straight: false, outModes: { default: "bounce" } }, number: { density: { enable: true, area: 800 }, value: 50 }, opacity: { value: 0.5 }, shape: { type: "circle" }, size: { value: { min: 1, max: 3 } } }, detectRetina: true
    });

    // =========================================================================
    // DÉCLENCHEURS INTELLIGENTS DE MODALS DE CONNEXION (Générés par PHP)
    // =========================================================================
    {% if require_face_2fa is defined and require_face_2fa %}
        document.addEventListener("DOMContentLoaded", function() { openFace2faModal(); });
    {% endif %}

    {% if require_voice_2fa is defined and require_voice_2fa %}
        document.addEventListener("DOMContentLoaded", function() { openVoice2faModal(); });
    {% endif %}

    {% if require_email_2fa is defined and require_email_2fa %}
        document.addEventListener("DOMContentLoaded", function() { openEmail2faModal("{{ user_email|default('') }}"); });
    {% endif %}


    // =========================================================================
    // LOGIQUE DE LA RECONNAISSANCE VOCALE (VOICE ID) - SANS FALLBACK
    // =========================================================================
    let mediaRecorder;
    let audioChunks = [];

    async function convertToWav(blob) {
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const arrayBuffer = await blob.arrayBuffer();
        const audioBuffer = await audioContext.decodeAudioData(arrayBuffer);
        
        const numOfChan = audioBuffer.numberOfChannels;
        const length = audioBuffer.length * numOfChan * 2 + 44;
        const buffer = new ArrayBuffer(length);
        const view = new DataView(buffer);
        const channels = [];
        let sample = 0, offset = 0, pos = 0;

        const setUint16 = (data) => { view.setUint16(pos, data, true); pos += 2; };
        const setUint32 = (data) => { view.setUint32(pos, data, true); pos += 4; };

        // Write WAV Header
        setUint32(0x46464952); // "RIFF"
        setUint32(length - 8); // file length - 8
        setUint32(0x45564157); // "WAVE"
        setUint32(0x20746d66); // "fmt " chunk
        setUint32(16);         // length = 16
        setUint16(1);          // PCM (uncompressed)
        setUint16(numOfChan);
        setUint32(audioBuffer.sampleRate);
        setUint32(audioBuffer.sampleRate * 2 * numOfChan); // avg. bytes/sec
        setUint16(numOfChan * 2); // block-align
        setUint16(16);         // 16-bit
        setUint32(0x61746164); // "data" - chunk
        setUint32(length - pos - 4); // chunk length

        // Write interleaved data
        for (let i = 0; i < audioBuffer.numberOfChannels; i++) {
            channels.push(audioBuffer.getChannelData(i));
        }

        while (pos < length) {
            for (let i = 0; i < numOfChan; i++) {
                sample = Math.max(-1, Math.min(1, channels[i][offset])); // clamp
                sample = (0.5 + sample < 0 ? sample * 32768 : sample * 32767)|0; // array to int16
                view.setInt16(pos, sample, true); pos += 2;
            }
            offset++; 
        }

        return new Blob([buffer], {type: "audio/wav"});
    }

    function openVoice2faModal() {
        document.getElementById('voice2faModal').style.display = 'flex';
        const status = document.getElementById('voice-status');
        const btn = document.getElementById('btn-voice-scan');

        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
                mediaRecorder = new MediaRecorder(stream);
                mediaRecorder.ondataavailable = e => { audioChunks.push(e.data); };
                mediaRecorder.onstop = async () => {
                    const actualMime = mediaRecorder.mimeType;
                    const audioBlob = new Blob(audioChunks, { type: actualMime });
                    
                    // Convertir le webm/ogg en vrai WAV PCM (que Wit.ai comprend parfaitement)
                    const convertedBlob = await convertToWav(audioBlob);

                    let formData = new FormData();
                    formData.append("audio", convertedBlob, "voice.wav");
                    formData.append("mimeType", "audio/wav");
                    
                    sendAudioToServer(formData);
                };
                status.innerText = "Micro prêt. Cliquez pour enregistrer.";
                btn.disabled = false;
            }).catch(err => {
                status.innerText = "Micro bloqué. Veuillez autoriser le microphone ou annuler.";
                status.style.color = "#e74c3c";
            });
        } else {
            status.innerText = "Micro non supporté par votre navigateur.";
            status.style.color = "#e74c3c";
        }
    }

    function startVoiceScan() {
        audioChunks = [];
        const status = document.getElementById('voice-status');
        const btn = document.getElementById('btn-voice-scan');
        const micAnim = document.getElementById('mic-animation');

        btn.disabled = true;
        micAnim.style.transform = "scale(1.2)";
        micAnim.style.backgroundColor = "#e74c3c";
        micAnim.style.animation = "pulseShadow 1s infinite";
        status.innerText = "🔴 Enregistrement... Prononcez le secret !";
        status.style.color = "#e74c3c";

        mediaRecorder.start();

        // Arrêt automatique après 4 secondes
        setTimeout(() => {
            mediaRecorder.stop();
            micAnim.style.transform = "scale(1)";
            micAnim.style.backgroundColor = "#2F80ED";
            micAnim.style.animation = "none";
            status.innerText = "🧠 Analyse de la voix en cours... Patientez.";
            status.style.color = "#3498db";
        }, 4000);
    }

    function sendAudioToServer(formData) {
        const status = document.getElementById('voice-status');
        const btn = document.getElementById('btn-voice-scan');

        fetch('{{ path('app_verify_voice_ajax') }}', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        }).then(res => res.json()).then(data => {
            if(data.success) {
                status.innerText = "✅ Identité confirmée ! Redirection...";
                status.style.color = "#2ecc71";
                window.location.href = '{{ path('app_admin_users') }}';
            } else {
                // PAS DE FALLBACK : On affiche l'erreur et on permet de réessayer
                status.innerText = "❌ " + data.message;
                status.style.color = "#e74c3c";
                btn.disabled = false;
                btn.innerText = "🎤 Réessayer (4s)";
            }
        }).catch(err => {
            status.innerText = "❌ Erreur réseau. Veuillez réessayer.";
            status.style.color = "#e74c3c";
            btn.disabled = false;
            btn.innerText = "🎤 Réessayer (4s)";
        });
    }

    function cancelVoiceLogin() {
        window.location.href = '{{ path('app_login') }}';
    }


    // =========================================================================
    // LOGIQUE DE LA RECONNAISSANCE FACIALE (FACE ID) - AVEC FALLBACK
    // =========================================================================
    function openFace2faModal() {
        document.getElementById('face2faModal').style.display = 'flex';
        const video = document.getElementById('face-webcam');
        const status = document.getElementById('face-status');
        const btn = document.getElementById('btn-face-scan');

        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: true }).then(stream => {
                video.srcObject = stream;
                video.play();
                status.innerText = "Caméra prête. Regardez l'objectif.";
                btn.disabled = false;
            }).catch(err => {
                status.innerText = "Caméra bloquée. Basculement sur l'email dans 2s...";
                status.style.color = "#e74c3c";
                setTimeout(() => fallbackToEmail(), 2000);
            });
        } else {
            status.innerText = "Caméra non supportée. Basculement sur l'email...";
            setTimeout(() => fallbackToEmail(), 2000);
        }
    }

    function startFaceScan() {
        const video = document.getElementById('face-webcam');
        const canvas = document.getElementById('face-canvas');
        const status = document.getElementById('face-status');
        const btn = document.getElementById('btn-face-scan');
        const laser = document.getElementById('laser-beam');

        btn.disabled = true;
        laser.style.display = 'block'; 
        status.innerText = "Analyse biométrique en cours... Patientez.";
        status.style.color = "#f39c12";

        canvas.width = video.videoWidth; canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
        const base64Image = canvas.toDataURL('image/jpeg');

        fetch('{{ path('app_verify_face_ajax') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ image: base64Image })
        }).then(res => res.json()).then(data => {
            laser.style.display = 'none'; 
            if(data.success) {
                status.innerText = "Identité confirmée ! Redirection...";
                status.style.color = "#2ecc71";
                if(video.srcObject) video.srcObject.getTracks().forEach(t => t.stop());
                window.location.href = '{{ path('app_redirect_user') }}';
            } else {
                status.innerText = "Visage non reconnu. Basculement sur l'email dans 2s...";
                status.style.color = "#e74c3c";
                setTimeout(() => fallbackToEmail(), 2500);
            }
        }).catch(err => {
            laser.style.display = 'none';
            status.innerText = "Erreur réseau. Basculement sur l'email...";
            status.style.color = "#e74c3c";
            setTimeout(() => fallbackToEmail(), 2500);
        });
    }

    function fallbackToEmail() {
        const video = document.getElementById('face-webcam');
        if(video && video.srcObject) video.srcObject.getTracks().forEach(t => t.stop());
        
        fetch('{{ path('app_fallback_2fa_email_ajax') }}', { method: 'POST', headers: {'X-Requested-With': 'XMLHttpRequest'}  })
        .then(res => res.json()).then(data => {
            document.getElementById('face2faModal').style.display = 'none';
            if(data.success) {
                openEmail2faModal(data.email);
            } else {
                window.location.href = '{{ path('app_login') }}';
            }
        }).catch(err => {
            window.location.href = '{{ path('app_login') }}';
        });
    }

    function cancelFaceLogin() {
        const video = document.getElementById('face-webcam');
        if(video && video.srcObject) video.srcObject.getTracks().forEach(t => t.stop());
        window.location.href = '{{ path('app_login') }}';
    }


    // =========================================================================
    // LOGIQUE DE LA VÉRIFICATION EMAIL 2FA
    // =========================================================================
    function openEmail2faModal(email) {
        document.getElementById('email2faModal').style.display = 'flex';
        if (email) {
            document.getElementById('email-2fa-desc').innerHTML = "Un code de sécurité a été envoyé à <strong>" + email + "</strong>.";
        }
        setTimeout(() => { document.getElementById('lc1').focus(); }, 100);
    }

    function submitEmail2fa() {
        const code = document.getElementById('lc1').value + document.getElementById('lc2').value + document.getElementById('lc3').value + document.getElementById('lc4').value + document.getElementById('lc5').value + document.getElementById('lc6').value;
        const err = document.getElementById('email-2fa-error');
        const btn = document.getElementById('btn-email-2fa');
        if(code.length !== 6) { err.style.display = 'block'; err.innerText = "Saisissez les 6 chiffres."; return; }
        btn.innerText = "Vérification..."; btn.disabled = true; err.style.display = 'none';

        fetch('{{ path('app_verify_email_2fa_ajax') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ code: code })
        }).then(res => res.json()).then(data => {
            if(data.success) {
                btn.innerText = "Succès ! Redirection...";
                window.location.href = '{{ path('app_redirect_user') }}';
            } else {
                err.style.display = 'block'; err.innerText = data.message || "Code incorrect.";
                btn.innerText = "Valider le code"; btn.disabled = false;
                document.getElementById('lc1').focus();
            }
        }).catch(err => {
            err.style.display = 'block'; err.innerText = "Erreur réseau.";
            btn.innerText = "Valider le code"; btn.disabled = false;
        });
    }

    // =========================================================================
    // LOGIQUE DU MOT DE PASSE OUBLIÉ
    // =========================================================================
    function moveToNext(current, nextFieldID) { if (current.value.length >= 1) { document.getElementById(nextFieldID).focus(); } }
    function openForgotPasswordModal() {
        document.getElementById('forgotPwdModal').style.display = 'flex';
        document.getElementById('forgot-step-1').style.display = 'block'; document.getElementById('forgot-step-2').style.display = 'none'; document.getElementById('forgot-step-3').style.display = 'none';
        document.getElementById('forgot-title').innerText = "Mot de passe oublié ?"; document.getElementById('forgot-desc').innerText = "Saisissez votre e-mail pour commencer la récupération sécurisée.";
        document.getElementById('forgot-icon').className = "lni lni-lock"; document.getElementById('reset_email_input').value = ""; document.getElementById('forgot-error').style.display = 'none';
    }
    function submitForgotStep1() {
        const email = document.getElementById('reset_email_input').value;
        const btn = document.getElementById('btn-step-1'); const err = document.getElementById('forgot-error');
        if(!email) { err.innerText = "Veuillez saisir une adresse email."; err.style.display = 'block'; return; }
        btn.innerText = "Recherche..."; btn.disabled = true; err.style.display = 'none';
        fetch('{{ path('app_forgot_password_request_ajax') }}', { method: 'POST', body: JSON.stringify({ email: email }) })
        .then(res => res.json()).then(data => {
            btn.innerText = "Rechercher mon compte"; btn.disabled = false;
            if(data.success) {
                document.getElementById('forgot-step-1').style.display = 'none'; document.getElementById('forgot-step-2').style.display = 'block';
                document.getElementById('forgot-title').innerText = "Vérification de sécurité"; document.getElementById('forgot-icon').className = "lni lni-shield";
                document.getElementById('forgot-desc').innerHTML = (data.type === '2FA') ? "Ouvrez <strong>Google Authenticator</strong>." : "Code envoyé à <strong>"+data.email+"</strong>.";
            }
        });
    }
    function submitForgotStep2() {
        const code = document.getElementById('fc1').value+document.getElementById('fc2').value+document.getElementById('fc3').value+document.getElementById('fc4').value+document.getElementById('fc5').value+document.getElementById('fc6').value;
        const btn = document.getElementById('btn-step-2'); const err = document.getElementById('forgot-error');
        btn.innerText = "Vérification..."; btn.disabled = true; err.style.display = 'none';
        fetch('{{ path('app_forgot_password_verify_ajax') }}', { method: 'POST', body: JSON.stringify({ code: code }) })
        .then(res => res.json()).then(data => {
            btn.innerText = "Vérifier le code"; btn.disabled = false;
            if(data.success) {
                document.getElementById('forgot-step-2').style.display = 'none'; document.getElementById('forgot-step-3').style.display = 'block';
                document.getElementById('forgot-title').innerText = "Nouveau départ"; document.getElementById('forgot-desc').innerText = "Créez un nouveau mot de passe."; document.getElementById('forgot-icon').className = "lni lni-key";
            } else { err.innerText = "Code incorrect."; err.style.display = 'block'; }
        });
    }
    function submitForgotStep3() {
        const pwd = document.getElementById('reset_new_pwd').value;
        fetch('{{ path('app_forgot_password_new_ajax') }}', { method: 'POST', body: JSON.stringify({ password: pwd }) })
        .then(res => res.json()).then(data => { if(data.success) location.reload(); });
    }

    function checkResetStrength() {
        const password = document.getElementById('reset_new_pwd').value;
        const confirm = document.getElementById('reset_confirm_pwd').value;
        const bar = document.getElementById('reset-strength-bar');
        const submitBtn = document.getElementById('btn-step-3');
        const errorMsg = document.getElementById('reset-match-error');
        
        const len = password.length;
        let percentage = Math.min((len / 8.0) * 100, 100);
        bar.style.width = percentage + "%";
        
        if (len >= 8) { bar.style.backgroundColor = "#2F80ED"; } 
        else if (len >= 5) { bar.style.backgroundColor = "#56CCF2"; } 
        else { bar.style.backgroundColor = "#e74c3c"; }

        const isMatch = (password === confirm && password !== "");
        if (confirm !== "" && !isMatch) { 
            errorMsg.style.display = "block"; 
        } else { 
            errorMsg.style.display = "none"; 
        }
        
        if (isMatch && password.length >= 8) { 
            submitBtn.disabled = false; 
        } else { 
            submitBtn.disabled = true; 
        }
    }
</script>
{% endblock %}