{% extends 'base.html.twig' %}

{% block title %}Vérification Email - Intel_link{% endblock %}

{% block stylesheets %}
<style>
    body {
        background-color: #f5f7fa;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .verify-container {
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        padding: 40px;
        width: 500px;
        text-align: center;
    }

    h1 { color: #0598ff; margin-bottom: 10px; }
    p { color: #64748b; font-size: 14px; margin-bottom: 30px; }
    
    .email-highlight { font-weight: bold; color: #2c3e50; }

    .otp-container {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .otp-input {
        width: 45px;
        height: 55px;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.3s;
    }

    .otp-input:focus { border-color: #0598ff; }

    .btn-primary {
        border-radius: 20px;
        background-color: #0598ff;
        color: #FFFFFF;
        border: none;
        font-size: 14px;
        font-weight: bold;
        padding: 12px 0;
        width: 250px;
        cursor: pointer;
        transition: transform 80ms ease-in;
    }

    .btn-primary:active { transform: scale(0.95); }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #64748b;
        text-decoration: underline;
        font-size: 13px;
    }

    .error-msg { color: #e74c3c; font-size: 13px; margin-bottom: 15px; }
</style>
{% endblock %}

{% block body %}
<div class="verify-container">
    <h1>Vérification de l'email</h1>
    <p>Saisissez le code à 6 chiffres envoyé à<br><span class="email-highlight">{{ email }}</span></p>

    {% for message in app.flashes('error') %}
        <div class="error-msg">{{ message }}</div>
    {% endfor %}

    <form method="POST">
        <div class="otp-container">
            <input type="text" name="code1" class="otp-input" maxlength="1" required autocomplete="off">
            <input type="text" name="code2" class="otp-input" maxlength="1" required autocomplete="off">
            <input type="text" name="code3" class="otp-input" maxlength="1" required autocomplete="off">
            <input type="text" name="code4" class="otp-input" maxlength="1" required autocomplete="off">
            <input type="text" name="code5" class="otp-input" maxlength="1" required autocomplete="off">
            <input type="text" name="code6" class="otp-input" maxlength="1" required autocomplete="off">
        </div>

        <button type="submit" class="btn-primary">Confirmer mon inscription</button>
    </form>

    <a href="{{ path('app_login') }}" class="back-link">← Modifier l'adresse email</a>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Le même comportement qu'en Java : on passe automatiquement à la case suivante
    const inputs = document.querySelectorAll('.otp-input');

    inputs.forEach((input, index) => {
        input.addEventListener('keyup', (e) => {
            // Passe au suivant si on tape un chiffre
            if (e.key >= 0 && e.key <= 9) {
                if (index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            } 
            // Revient en arrière si on efface (Backspace)
            else if (e.key === 'Backspace') {
                if (index > 0) {
                    inputs[index - 1].focus();
                }
            }
        });
    });

    // Sélectionne la première case au chargement de la page
    window.onload = () => inputs[0].focus();
</script>
{% endblock %}