{% extends 'base.html.twig' %}
{% block title %}Nouvelle Réclamation - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { 
            background-color: #e2e8f0 !important; 
            background-image: radial-gradient(rgba(47, 128, 237, 0.05) 1px, transparent 1px), radial-gradient(rgba(47, 128, 237, 0.05) 1px, transparent 1px);
            background-position: 0 0, 20px 20px; background-size: 40px 40px;
            font-family: "Heebo", sans-serif; margin: 0; color: #0f172a; 
        }
        *, *::before, *::after { box-sizing: border-box; }
        ::-webkit-scrollbar { width: 8px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; } ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        .scroll-progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); z-index: 100000; width: 0%; box-shadow: 0 0 15px rgba(86, 204, 242, 0.8); border-radius: 0 5px 5px 0; }
        
        .glass-navbar { background: rgba(255, 255, 255, 0.8) !important; backdrop-filter: blur(25px); border-bottom: 1px solid rgba(0,0,0,0.05); transition: transform 0.4s; }
        .navbar-hidden { transform: translateY(-100%); }
        .glitch-logo { position: relative; display: inline-block; color: #0f172a; font-weight: 900; letter-spacing: -1px; margin: 0;}

        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo { font-size: 3rem; font-weight: 900; color: #2F80ED; animation: pulse-glow 1.5s infinite alternate; }

        /* BOUTONS */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: 0.3s; background: #2F80ED; color: #ffffff !important; border: none; padding: 12px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; display: inline-block; box-shadow: 0 4px 12px rgba(47, 128, 237, 0.25);}
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(135deg, #1e293b, #334155); z-index: -1; transition: top 0.6s ease; border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(47, 128, 237, 0.4); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }
        
        .btn-outline-custom { background: #ffffff; color: #0f172a; border: 1px solid rgba(0,0,0,0.1); padding: 8px 24px; border-radius: 50px; font-size: 14px; font-weight: bold; text-decoration: none; transition: all 0.3s; display: inline-block;}
        .btn-outline-custom:hover { background: #f8fafc; color: #2F80ED; border-color: #2F80ED; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(47, 128, 237, 0.15); }

        /* FORMULAIRE DESIGN (Cartes blanches avec bordures) */
        .formation-form-wrapper { 
            background: #ffffff !important; border: 1px solid #cbd5e1 !important; border-radius: 24px; padding: 40px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08) !important; position: relative; overflow: hidden; transition: 0.3s ease;
        }
        .formation-form-wrapper:hover { box-shadow: 0 15px 35px rgba(15, 23, 42, 0.12) !important; border-color: #2F80ED !important; }
        .formation-form-wrapper::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); }

        .form-group-custom { margin-bottom: 24px; position: relative; }
        .form-group-custom label { display: block; font-family: "Fira Sans", sans-serif; font-weight: 700; color: #64748b; font-size: 12px; margin-bottom: 8px; letter-spacing: 0.5px;}
        .form-control-custom { width: 100%; padding: 13px 18px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 15px; color: #0f172a; background: #ffffff; transition: all 0.3s ease; outline: none; }
        
        /* Styles de validation visuelle */
        .form-control-custom:focus { border-color: #2F80ED; box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.1); }
        .form-control-custom.is-invalid { border-color: #ef4444; background-color: #fef2f2; }
        .form-control-custom.is-valid { border-color: #10b981; }
        
        .error-message { color: #ef4444; font-size: 11px; font-weight: 600; margin-top: 5px; display: none; position: absolute; bottom: -18px; left: 5px; }
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div id="preloader"><h1 class="loader-logo">Intel_link<span style="color: #56CCF2;">.</span></h1></div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            <a class="navbar-brand" href="{{ path('app_home') }}">
                                <h3 class="glitch-logo" data-text="Intel_link">Intel_link<span style="color: #56CCF2;">.</span></h3> 
                            </a>
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer; background: #ffffff; padding: 5px 15px 5px 5px; border-radius: 50px; border: 1px solid #e2e8f0;">
                                            {% if app.user.image %}
                                                {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            {% else %}
                                                {% set avatar_src = 'https://ui-avatars.com/api/?name=' ~ app.user.nom|url_encode ~ '&background=2F80ED&color=fff&rounded=true&bold=true' %}
                                            {% endif %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 35px; height: 35px; object-fit: cover; margin-right: 10px; border-radius: 50%;">
                                            <span style="color: #0f172a; font-weight: 700;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 12px; border: 1px solid #e2e8f0; background: #ffffff; box-shadow: 0 20px 50px rgba(0,0,0,0.1); padding: 15px 0;">
                                            <li><a class="dropdown-item fw-bold" href="{{ path('app_profile') }}"><i class="lni lni-user mr-10 text-primary"></i> Mon Profil</a></li>
                                            <li><a class="dropdown-item fw-bold" href="{{ path('app_reclamation_index') }}"><i class="lni lni-bullhorn mr-10 text-primary"></i> Mes Réclamations</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="main-content" style="padding: 40px 0;">
        <div style="max-width: 800px; margin: 0 auto; padding: 0 20px;">
            <a href="{{ path('app_reclamation_index') }}" class="btn-outline-custom" style="margin-bottom: 20px;" data-aos="fade-right">&larr; Mes Réclamations</a>
            
            <div class="formation-form-wrapper" data-aos="fade-up" data-aos-duration="1000">
                <h2 style="font-family: 'Fira Sans', sans-serif; font-weight: 900; color: #0f172a; font-size: 2.2rem; letter-spacing: -1px; margin-bottom: 10px;">Créer un <span style="color: #2F80ED;">Ticket</span></h2>
                <p style="color: #64748b; font-weight: 500; margin-bottom: 30px; font-size: 1.1rem;">Remplissez le formulaire ci-dessous pour que notre équipe d'experts analyse votre demande.</p>

                <form id="reclamationForm" action="{{ path('app_reclamation_new') }}" method="POST" enctype="multipart/form-data" novalidate>
                    
                    <div class="form-group-custom">
                        <label>OBJET DE LA DEMANDE</label>
                        <input type="text" id="objet" name="objet" class="form-control-custom" placeholder="Ex: Problème technique sur le forum..." required minlength="5" maxlength="100">
                        <span class="error-message" id="error-objet">L'objet doit contenir entre 5 et 100 caractères.</span>
                    </div>

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                            <label>TYPE</label>
                            <select id="type" name="type" class="form-control-custom" required>
                                <option value="" disabled selected>Sélectionnez un type</option>
                                <option value="Technique">Technique</option>
                                <option value="Facturation">Facturation</option>
                                <option value="Service Client">Service Client</option>
                                <option value="Autre">Autre</option>
                            </select>
                            <span class="error-message" id="error-type">Veuillez sélectionner un type de demande.</span>
                        </div>
                        <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                            <label>PRIORITÉ</label>
                            <select id="priorite" name="priorite" class="form-control-custom" required>
                                <option value="FAIBLE">🟢 Faible</option>
                                <option value="MOYENNE" selected>🟡 Moyenne</option>
                                <option value="ELEVEE">🔴 Élevée</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group-custom">
                        <label>DESCRIPTION DÉTAILLÉE</label>
                        <textarea id="description" name="description" class="form-control-custom" rows="6" placeholder="Soyez le plus précis possible pour nous aider à vous répondre rapidement... (minimum 20 caractères)" required minlength="20" maxlength="1000"></textarea>
                        <span class="error-message" id="error-description">La description doit contenir au moins 20 caractères.</span>
                    </div>

                    <div class="form-group-custom">
                        <label>PIÈCE JOINTE <span style="color: #8b92a5; font-weight: 400;">(Image ou PDF, max 5Mo)</span></label>
                        <input type="file" id="pieceJointe" name="pieceJointe" class="form-control-custom" style="padding: 10px;" accept=".png, .jpg, .jpeg, .pdf">
                        <span class="error-message" id="error-pieceJointe">Le fichier doit être une image ou un PDF, et peser moins de 5Mo.</span>
                    </div>

                    <div style="text-align: right; margin-top: 30px;">
                        <button type="submit" id="submitBtn" class="btn-liquid"><i class="lni lni-telegram-original"></i> Envoyer la demande</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        window.addEventListener('load', () => { setTimeout(() => { document.getElementById('preloader').style.opacity = '0'; setTimeout(() => document.getElementById('preloader').style.display = 'none', 800); }, 500); });
        AOS.init({ once: true, offset: 50 });

        let lastScrollTop = 0; const navbar = document.getElementById('smartNavbar'), progressBar = document.getElementById('scrollBar');
        window.addEventListener('scroll', () => {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            progressBar.style.width = ((scrollTop / (document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100) + "%";
            scrollTop > lastScrollTop && scrollTop > 100 ? navbar.classList.add('navbar-hidden') : navbar.classList.remove('navbar-hidden');
            lastScrollTop = scrollTop;
        });

        // =========================================================================
        // VALIDATION DU FORMULAIRE DE RÉCLAMATION EN TEMPS RÉEL
        // =========================================================================
        const form = document.getElementById('reclamationForm');
        const inputObjet = document.getElementById('objet');
        const inputType = document.getElementById('type');
        const inputDesc = document.getElementById('description');
        const inputFile = document.getElementById('pieceJointe');
        
        // Fonction générique pour afficher/masquer les erreurs
        function setValidationState(inputElement, isValid, errorElementId) {
            const errorElement = document.getElementById(errorElementId);
            if (isValid) {
                inputElement.classList.remove('is-invalid');
                inputElement.classList.add('is-valid');
                errorElement.style.display = 'none';
            } else {
                inputElement.classList.remove('is-valid');
                inputElement.classList.add('is-invalid');
                errorElement.style.display = 'block';
            }
            return isValid;
        }

        // Validateurs spécifiques
        function validateObjet() {
            const value = inputObjet.value.trim();
            return setValidationState(inputObjet, value.length >= 5 && value.length <= 100, 'error-objet');
        }

        function validateType() {
            return setValidationState(inputType, inputType.value !== "", 'error-type');
        }

        function validateDescription() {
            const value = inputDesc.value.trim();
            return setValidationState(inputDesc, value.length >= 20, 'error-description');
        }

        function validateFile() {
            // Le fichier est optionnel
            if (inputFile.files.length === 0) {
                inputFile.classList.remove('is-invalid', 'is-valid');
                document.getElementById('error-pieceJointe').style.display = 'none';
                return true; 
            }

            const file = inputFile.files[0];
            const fileSize = file.size / 1024 / 1024; // in MB
            const allowedTypes = ['image/jpeg', 'image/png', 'application/pdf'];
            
            const isValid = allowedTypes.includes(file.type) && fileSize <= 5;
            return setValidationState(inputFile, isValid, 'error-pieceJointe');
        }

        // Validation en temps réel lors de la saisie
        inputObjet.addEventListener('input', validateObjet);
        inputType.addEventListener('change', validateType);
        inputDesc.addEventListener('input', validateDescription);
        inputFile.addEventListener('change', validateFile);

        // Validation finale à la soumission
        form.addEventListener('submit', function(event) {
            const isObjetValid = validateObjet();
            const isTypeValid = validateType();
            const isDescValid = validateDescription();
            const isFileValid = validateFile();

            if (!isObjetValid || !isTypeValid || !isDescValid || !isFileValid) {
                event.preventDefault(); // Empêche l'envoi du formulaire si une erreur est détectée
                
                // Petit effet visuel pour montrer que ça a bloqué
                const submitBtn = document.getElementById('submitBtn');
                submitBtn.style.transform = 'translateY(2px)';
                setTimeout(() => { submitBtn.style.transform = 'translateY(0)'; }, 150);
            }
        });
    </script>
{% endblock %}