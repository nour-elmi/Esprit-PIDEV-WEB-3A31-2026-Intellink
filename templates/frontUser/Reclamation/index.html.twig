{% extends 'base.html.twig' %}
{% block title %}Mes Réclamations - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        /* =========================================================================
           1. ESTHÉTIQUE GLOBALE (Contraste Amélioré)
           ========================================================================= */
        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { 
            /* CORRECTION : Rétablissement de l'arrière-plan original */
            background-color: #e2e8f0 !important; 
            background-image: 
                radial-gradient(rgba(47, 128, 237, 0.05) 1px, transparent 1px),
                radial-gradient(rgba(47, 128, 237, 0.05) 1px, transparent 1px);
            background-position: 0 0, 20px 20px;
            background-size: 40px 40px;
            font-family: "Heebo", sans-serif; margin: 0; color: #0f172a; 
        }
        *, *::before, *::after { box-sizing: border-box; }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        .scroll-progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); z-index: 100000; width: 0%; box-shadow: 0 0 15px rgba(86, 204, 242, 0.8); border-radius: 0 5px 5px 0; }
        .glass-navbar { background: rgba(255, 255, 255, 0.8) !important; backdrop-filter: blur(25px); border-bottom: 1px solid rgba(0,0,0,0.05); transition: transform 0.4s; }
        .navbar-hidden { transform: translateY(-100%); }
        .glitch-logo { position: relative; display: inline-block; color: #0f172a; font-weight: 900; letter-spacing: -1px; margin: 0;}

        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo { font-size: 3rem; font-weight: 900; color: #2F80ED; animation: pulse-glow 1.5s infinite alternate; }
        @keyframes pulse-glow { 0% { transform: scale(0.95); text-shadow: 0 0 10px rgba(47, 128, 237, 0.2); } 100% { transform: scale(1.05); text-shadow: 0 0 30px rgba(86, 204, 242, 0.8); } }

        /* BOUTONS */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: 0.3s; background: #2F80ED; color: #ffffff !important; border: none; padding: 12px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; display: inline-block; box-shadow: 0 4px 12px rgba(47, 128, 237, 0.25);}
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(135deg, #1e293b, #334155); z-index: -1; transition: top 0.6s ease; border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(47, 128, 237, 0.4); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }
        
        .btn-outline-custom { background: #ffffff; color: #0f172a; border: 1px solid rgba(0,0,0,0.1); padding: 8px 24px; border-radius: 50px; font-size: 14px; font-weight: bold; text-decoration: none; transition: all 0.3s; display: inline-block;}
        .btn-outline-custom:hover { background: #f8fafc; color: #2F80ED; border-color: #2F80ED; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(47, 128, 237, 0.15); }
        .btn-danger-custom { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); padding: 8px 18px; border-radius: 50px; font-weight: 600; transition: all 0.3s; }
        .btn-danger-custom:hover { background: #ef4444; color: white; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3); }

        /* CARTES ET FILTRES (Blanc pur & Bordures) */
        .form-control-custom { width: 100%; padding: 13px 18px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 15px; color: #0f172a; background: #ffffff; transition: all 0.3s ease; outline: none; }
        .form-control-custom:focus { border-color: #2F80ED; box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.1); }

        /* MODIFICATIONS GRID CARD (Effets graphiques originaux conservés) */
        .rec-card { 
            background: #ffffff !important; 
            border: 1px solid #cbd5e1 !important; 
            border-radius: 20px; padding: 25px; 
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08) !important; 
            position: relative; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; 
            transform-style: preserve-3d; cursor: pointer;
        }
        .rec-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(15, 23, 42, 0.12) !important; border-color: #2F80ED !important; }
        .rec-card::before { content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(180deg, #2F80ED, #56CCF2); transform: scaleY(0); transform-origin: top; transition: transform 0.4s ease; }
        .rec-card:hover::before { transform: scaleY(1); }
        
        .badge-status { padding: 5px 12px; border-radius: 20px; color: white; font-weight: bold; font-size: 11px; letter-spacing: 0.5px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); white-space: nowrap; }
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div id="preloader"><h1 class="loader-logo">Intel_link<span style="color: #56CCF2;">.</span></h1></div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar" data-aos="fade-down">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            <a class="navbar-brand" href="{{ path('app_home') }}">
                                <h3 class="glitch-logo" data-text="Intel_link">Intel_link<span style="color: #56CCF2;">.</span></h3> 
                            </a>
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer; background: #ffffff; padding: 5px 15px 5px 5px; border-radius: 50px; border: 1px solid #e2e8f0;">
                                            {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 35px; height: 35px; object-fit: cover; margin-right: 10px; border-radius: 50%;">
                                            <span style="color: #0f172a; font-weight: 700;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 15px; border: 1px solid #e2e8f0; background: #ffffff; box-shadow: 0 20px 50px rgba(0,0,0,0.1); padding: 15px 0;">
                                            <li><a class="dropdown-item fw-bold" href="{{ path('app_profile') }}"><i class="lni lni-user mr-10 text-primary"></i> Mon Profil</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="main-content" style="padding: 40px 0;">
        <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <a href="{{ path('app_home') }}" class="btn-outline-custom" style="margin-bottom: 20px;" data-aos="fade-right">&larr; Retour</a>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;" data-aos="fade-up">
                <div>
                    <h2 style="font-family: 'Fira Sans', sans-serif; font-weight: 900; color: #0f172a; font-size: 2.5rem; letter-spacing: -1px; margin-bottom: 5px;">Mes <span style="color: #2F80ED;">Réclamations</span></h2>
                    <p style="color: #64748b; font-size: 1.1rem; margin: 0;">Gérez vos tickets de support et suivez leur avancement en temps réel.</p>
                </div>
                <a href="{{ path('app_reclamation_new') }}" class="btn-liquid"><i class="lni lni-plus"></i> Nouvelle Réclamation</a>
            </div>

            {% for message in app.flashes('success') %}
                <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #047857; padding: 15px; border-radius: 12px; margin-bottom: 20px; font-weight:bold;" data-aos="fade-down">{{ message }}</div>
            {% endfor %}

            <div style="display: flex; gap: 15px; margin-bottom: 30px;" data-aos="fade-up" data-aos-delay="100">
                <input type="text" id="searchInput" class="form-control-custom" placeholder="🔍 Rechercher un ticket..." style="max-width: 350px;">
                <select id="statusFilter" class="form-control-custom" style="max-width: 200px;">
                    <option value="Tous">Tous les statuts</option>
                    <option value="OUVERT">Ouvert</option>
                    <option value="TRAITE">Traité</option>
                    <option value="REJETE">Rejeté</option>
                </select>
            </div>

            <div id="reclamationsList" class="row">
                {% for rec in reclamations %}
                    <div class="col-12 col-md-6 col-lg-4 mb-4 rec-wrapper" data-status="{{ rec.statut }}" data-text="{{ rec.objet|lower }} {{ rec.description|lower }}">
                        
                        <div class="rec-card h-100 d-flex flex-column" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 50 }}">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; gap: 10px;">
                                <h4 style="margin: 0; color: #0f172a; font-weight: 800; font-family: 'Fira Sans', sans-serif; transform: translateZ(10px); font-size: 1.2rem; line-height: 1.3;">{{ rec.objet }}</h4>
                                <span class="badge-status" style="{% if rec.statut == 'OUVERT' %}background: linear-gradient(45deg, #f39c12, #f1c40f);{% elseif rec.statut == 'TRAITE' %}background: linear-gradient(45deg, #10b981, #34d399);{% else %}background: linear-gradient(45deg, #ef4444, #f87171);{% endif %} transform: translateZ(20px);">
                                    {{ rec.statut }}
                                </span>
                            </div>
                            
                            <p style="margin: 0 0 20px 0; font-size: 14px; color: #64748b; line-height: 1.6; transform: translateZ(10px); flex-grow: 1;">
                                {{ rec.description|length > 100 ? rec.description|slice(0, 100) ~ '...' : rec.description }}
                            </p>
                            
                            <div style="display: flex; justify-content: flex-end; gap: 8px; transform: translateZ(20px); margin-top: auto;">
                                <a href="{{ path('app_reclamation_show', {'id': rec.id}) }}" class="btn-outline-custom" style="padding: 6px 15px; font-size: 12px;"><i class="lni lni-eye"></i> Détails</a>
                                {% if rec.statut == 'OUVERT' %}
                                    <form method="post" action="{{ path('app_reclamation_delete', {'id': rec.id}) }}" onsubmit="return confirm('Supprimer ce ticket ?');" style="margin: 0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id) }}">
                                        <button type="submit" class="btn-danger-custom" style="padding: 6px 12px;"><i class="lni lni-trash"></i></button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center" data-aos="zoom-in">
                        <div style="padding: 50px; background: #ffffff; border-radius: 20px; border: 1px dashed #cbd5e1;">
                            <i class="lni lni-empty-file" style="font-size: 40px; color: #cbd5e1; margin-bottom: 15px; display: block;"></i>
                            <p style="font-size: 1.2rem; color: #64748b; font-weight: 600; margin: 0;">Vous n'avez aucune réclamation pour le moment.</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.7.2/vanilla-tilt.min.js"></script>

    <script>
        window.addEventListener('load', () => { setTimeout(() => { document.getElementById('preloader').style.opacity = '0'; setTimeout(() => document.getElementById('preloader').style.display = 'none', 800); }, 500); });
        AOS.init({ once: true, offset: 50 });

        let lastScrollTop = 0; const navbar = document.getElementById('smartNavbar'), progressBar = document.getElementById('scrollBar');
        window.addEventListener('scroll', () => {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            progressBar.style.width = ((scrollTop / (document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100) + "%";
            scrollTop > lastScrollTop && scrollTop > 100 ? navbar.classList.add('navbar-hidden') : navbar.classList.remove('navbar-hidden');
            lastScrollTop = scrollTop;
        });

        // Filtrage dynamique adapté à la Grille
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        
        function filterList() {
            const searchText = searchInput.value.toLowerCase();
            const status = statusFilter.value;
            
            // Cacher/afficher le wrapper de la colonne
            document.querySelectorAll('.rec-wrapper').forEach(wrapper => {
                const matchesText = wrapper.dataset.text.includes(searchText);
                const matchesStatus = status === 'Tous' || wrapper.dataset.status === status;
                
                wrapper.style.display = matchesText && matchesStatus ? 'block' : 'none';
            });
        }
        
        searchInput.addEventListener('input', filterList);
        statusFilter.addEventListener('change', filterList);
        
        VanillaTilt.init(document.querySelectorAll(".rec-card"), { max: 3, speed: 400, glare: true, "max-glare": 0.1 });
    </script>
{% endblock %}