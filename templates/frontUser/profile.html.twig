{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Intel_link{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-5.0.0-beta1.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lindy-uikit.css') }}">
    <link href="https://cdn.lineicons.com/2.0/LineIcons.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        /* =========================================================================
           1. ESTHÉTIQUE GLOBALE (Avec contraste)
           ========================================================================= */
        html { scroll-behavior: smooth; overflow-x: hidden; }
        
        body { 
            background-color: #e2e8f0 !important; 
            background-image: 
                radial-gradient(rgba(47, 128, 237, 0.05) 1px, transparent 1px),
                radial-gradient(rgba(47, 128, 237, 0.05) 1px, transparent 1px);
            background-position: 0 0, 20px 20px;
            background-size: 40px 40px;
            font-family: "Heebo", sans-serif; 
            margin: 0; color: #0f172a; 
        }
        *, *::before, *::after { box-sizing: border-box; }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #2F80ED; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #56CCF2; }

        .noise-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 99998; opacity: 0.03; background: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E'); }
        .scroll-progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); z-index: 100000; width: 0%; }
        
        /* PRELOADER IMAGE */
        #preloader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 999999; display: flex; justify-content: center; align-items: center; transition: opacity 0.8s ease-out, visibility 0.8s; }
        .loader-logo-img { height: 60px; animation: pulse-glow-img 1.5s infinite alternate; }
        @keyframes pulse-glow-img { 
            0% { transform: scale(0.95); filter: drop-shadow(0 0 15px rgba(86, 204, 242, 0.2)); } 
            100% { transform: scale(1.05); filter: drop-shadow(0 0 30px rgba(86, 204, 242, 0.6)); } 
        }

        .glass-navbar { background: rgba(255, 255, 255, 0.8) !important; backdrop-filter: blur(25px); border-bottom: 1px solid rgba(0,0,0,0.05); transition: transform 0.4s; }
        .navbar-hidden { transform: translateY(-100%); }
        
        /* CYBER GLITCH ADAPTÉ POUR L'IMAGE DU LOGO */
        .glitch-logo { position: relative; display: inline-block; text-decoration: none; }
        .glitch-img-main { height: 35px; display: block; position: relative; z-index: 2; transition: 0.3s; }
        .glitch-img-layer { position: absolute; top: 0; left: 0; height: 35px; width: 100%; object-fit: contain; opacity: 0; z-index: 1; }
        
        .glitch-logo:hover .layer-1 {
            left: 2px; opacity: 1;
            filter: drop-shadow(-2px 0 #56CCF2);
            animation: glitch-anim-1 0.2s infinite linear alternate-reverse;
        }
        .glitch-logo:hover .layer-2 {
            left: -2px; opacity: 1;
            filter: drop-shadow(2px 0 #2F80ED);
            animation: glitch-anim-2 0.3s infinite linear alternate-reverse;
        }
        @keyframes glitch-anim-1 { 0% { clip-path: inset(20% 0 80% 0); } 100% { clip-path: inset(50% 0 30% 0); } }
        @keyframes glitch-anim-2 { 0% { clip-path: inset(10% 0 60% 0); } 100% { clip-path: inset(80% 0 10% 0); } }

        /* BOUTONS LIQUID WAVE */
        .btn-liquid { position: relative; overflow: hidden; z-index: 1; transition: color 0.4s ease; background: #2F80ED; color: #ffffff !important; border: none; padding: 12px 28px; border-radius: 50px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; box-shadow: 0 4px 12px rgba(47, 128, 237, 0.25);}
        .btn-liquid::before { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 200%; background: linear-gradient(135deg, #1e293b, #334155); z-index: -1; transition: top 0.6s ease; border-radius: 50% 50% 0 0; }
        .btn-liquid:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(47, 128, 237, 0.4); }
        .btn-liquid:hover::before { top: -20%; border-radius: 0; }
        
        .btn-liquid-success { background: #10b981; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); }
        .btn-liquid-success::before { background: linear-gradient(135deg, #047857, #10b981); }

        /* =========================================================================
           2. COMPOSANTS SPÉCIFIQUES AU PROFIL
           ========================================================================= */
        .formation-form-wrapper { 
            background: #ffffff !important; border: 1px solid #cbd5e1 !important; border-radius: 24px; padding: 40px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08) !important; position: relative; overflow: hidden; transition: 0.3s ease;
        }
        .formation-form-wrapper:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(15, 23, 42, 0.12) !important; border-color: #2F80ED !important; }
        .profile-main.formation-form-wrapper::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #2F80ED, #56CCF2); }

        .profile-layout { display: flex; gap: 40px; max-width: 1100px; margin: 40px auto; position: relative; z-index: 2; }
        .profile-sidebar { width: 300px; display: flex; flex-direction: column; align-items: center; gap: 20px; }
        .profile-main { flex: 1; }
        
        .profile-avatar { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid #ffffff; box-shadow: 0 10px 25px rgba(47, 128, 237, 0.2); transition: 0.3s; }
        .profile-avatar:hover { transform: scale(1.05); box-shadow: 0 15px 35px rgba(47, 128, 237, 0.3); }
        
        .cv-box { display: flex; align-items: center; justify-content: space-between; padding: 15px; border: 1px dashed #2F80ED; border-radius: 10px; background: rgba(47, 128, 237, 0.05); transition: 0.3s;}
        
        .btn-outline-custom { background: #ffffff; color: #0f172a; border: 1px solid rgba(0,0,0,0.1); padding: 10px 26px; border-radius: 50px; font-weight: 600; cursor: pointer; transition: all 0.3s; display: inline-block; text-decoration: none;}
        .btn-outline-custom:hover { background: #f8fafc; color: #2F80ED; border-color: #2F80ED; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(47, 128, 237, 0.15); }
        
        .btn-danger-custom { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); padding: 12px 28px; border-radius: 50px; font-weight: 600; cursor: pointer; transition: all 0.3s; width: 100%; display: block; text-align: center; }
        .btn-danger-custom:hover { background: #ef4444; color: white; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3); }

        .form-group-custom { margin-bottom: 24px; }
        .form-group-custom label { display: block; font-family: "Fira Sans", sans-serif; font-weight: 700; color: #64748b; font-size: 12px; margin-bottom: 8px; letter-spacing: 0.5px; text-transform: uppercase;}
        .form-control-custom { width: 100%; padding: 13px 18px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 15px; color: #0f172a; background: #ffffff; transition: all 0.3s ease; outline: none; }
        .form-control-custom:focus { border-color: #2F80ED; box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.1); }
        .form-control-custom:disabled { background-color: rgba(241, 245, 249, 0.6); color: #94a3b8; border-color: transparent; font-weight: 500;}

        /* =========================================================================
           3. NOUVEAU : LE MODAL DE SÉCURITÉ (PASSWORD VAULT)
           ========================================================================= */
        .security-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(10px); z-index: 100001; justify-content: center; align-items: center; }
        .security-box { background: #ffffff; padding: 40px; border-radius: 24px; width: 450px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); animation: scaleIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        
        .pwd-input-group { position: relative; margin-bottom: 20px; }
        .pwd-input-group i.toggle-pwd { position: absolute; right: 18px; bottom: 15px; cursor: pointer; color: #94a3b8; font-size: 18px; transition: 0.3s; }
        .pwd-input-group i.toggle-pwd:hover { color: #2F80ED; }
        
        .strength-meter { height: 6px; background: #e2e8f0; border-radius: 10px; margin-top: 10px; overflow: hidden; width: 100%; }
        .strength-bar { height: 100%; width: 0%; transition: 0.4s ease; border-radius: 10px; }
        .strength-text { font-size: 12px; font-weight: 700; color: #64748b; margin-top: 6px; text-align: right; }

        /* Modal Avatar */
        .avatar-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(10px); z-index: 100000; justify-content: center; align-items: center; }
        .avatar-grid { background: #ffffff; padding: 40px; border-radius: 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; width: 450px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); animation: scaleIn 0.3s ease-out;}
        @keyframes scaleIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .avatar-grid img { width: 80px; height: 80px; cursor: pointer; transition: 0.3s; border-radius: 50%; border: 3px solid transparent;}
        .avatar-grid img:hover { transform: scale(1.1); border-color: #2F80ED;}
    </style>
{% endblock %}

{% block body %}
    <div class="scroll-progress-bar" id="scrollBar"></div>
    <div class="noise-overlay"></div>
    
    <div id="preloader">
        <img src="{{ asset('assets/img/logo.png') }}" alt="IntelLink" class="loader-logo-img">
    </div>

    <header class="header header-6 sticky-top glass-navbar" id="smartNavbar">
        <div class="navbar-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <nav class="navbar navbar-expand-lg">
                            
                            <a class="navbar-brand glitch-logo" href="{{ path('app_home') }}">
                                <img src="{{ asset('assets/img/logo.png') }}" alt="IntelLink" class="glitch-img-main">
                                <img src="{{ asset('assets/img/logo.png') }}" alt="" class="glitch-img-layer layer-1">
                                <img src="{{ asset('assets/img/logo.png') }}" alt="" class="glitch-img-layer layer-2">
                            </a>
                            
                            <div class="collapse navbar-collapse"></div>
                            <div class="header-action d-flex align-items-center">
                                {% if app.user %}
                                    <div class="dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer; background: #ffffff; padding: 5px 15px 5px 5px; border-radius: 50px; border: 1px solid #e2e8f0;">
                                            {% set avatar_src = app.user.image starts with 'http' ? app.user.image : asset('uploads/profiles/' ~ app.user.image) %}
                                            <img src="{{ avatar_src }}" alt="Profil" class="radius-full" style="width: 35px; height: 35px; object-fit: cover; margin-right: 10px; border-radius: 50%;">
                                            <span style="color: #0f172a; font-weight: 700; font-size: 14px;">{{ app.user.nom }}</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileMenu" style="border-radius: 12px; border: 1px solid #e2e8f0; background: #ffffff; box-shadow: 0 15px 40px rgba(0,0,0,0.08); padding: 10px;">
                                            <li><a class="dropdown-item fw-bold" href="{{ path('app_profile') }}" style="border-radius: 8px;"><i class="lni lni-user mr-10 text-primary"></i> Mon Profil</a></li>
                                            <li><a class="dropdown-item fw-bold" href="{{ path('app_reclamation_index') }}" style="border-radius: 8px;"><i class="lni lni-bullhorn mr-10 text-primary"></i> Mes Réclamations</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}" style="border-radius: 8px;"><i class="lni lni-exit mr-10"></i> Se déconnecter</a></li>
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="main-content" style="padding-top: 40px;">
        <div style="max-width: 1100px; margin: 0 auto; padding: 0 20px 20px 20px;" data-aos="fade-right" data-aos-duration="1000">
            <a href="{{ path('app_home') }}" class="btn-outline-custom" style="padding: 6px 20px; font-size: 14px;">
                &larr; Retour à l'accueil
            </a>
            <h2 style="margin-top: 25px; font-family: 'Fira Sans', sans-serif; font-weight: 900; color: #0f172a; font-size: 2.5rem; letter-spacing: -1px;">Espace <span style="color: #2F80ED;">Personnel</span></h2>
            <p style="color: #64748b; font-size: 1.1rem; font-weight: 500;">Gérez vos informations, votre sécurité et vos documents professionnels.</p>
        </div>

        <div class="profile-layout">
            
            <div class="profile-sidebar formation-form-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                {% set avatar_src = user.image starts with 'http' ? user.image : asset('uploads/profiles/' ~ user.image) %}
                <img src="{{ avatar_src }}" alt="Avatar" class="profile-avatar" id="avatar-preview">
                
                <div id="image-actions" style="display: none; width: 100%; margin-top: 20px;">
                    <label for="image_profil" class="btn-outline-custom" style="display: block; width: 100%; box-sizing: border-box; text-align: center; margin-bottom: 12px; padding: 10px 5px; font-size: 13px; cursor: pointer;">
                        <i class="lni lni-upload"></i> Importer photo
                    </label>
                    <button type="button" class="btn-outline-custom" style="display: block; width: 100%; box-sizing: border-box; text-align: center; padding: 10px 5px; font-size: 13px;" onclick="document.getElementById('avatarModal').style.display='flex'">
                        <i class="lni lni-emoji-smile"></i> Choisir avatar
                    </button>
                </div>

                <hr style="width: 100%; border: 0; border-top: 1px dashed #cbd5e1; margin: 25px 0;">

                <form action="{{ path('app_profile_delete') }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer votre compte ? Cette action est irréversible.');" style="width: 100%;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                    <button type="submit" class="btn-danger-custom"><i class="lni lni-trash"></i> Supprimer le compte</button>
                </form>
            </div>

            <div class="profile-main formation-form-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
                    <h3 style="color: #0f172a; font-weight: 800; margin: 0;">Informations Personnelles</h3>
                    <button type="button" class="btn-liquid" id="btn-edit" onclick="toggleEditMode(true)" style="padding: 10px 25px; font-size: 14px;">
                        <i class="lni lni-pencil me-1"></i> Modifier le profil
                    </button>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success fw-bold" style="border-radius: 12px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16,185,129,0.3); color: #047857;">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('danger') %}
                    <div class="alert alert-danger fw-bold" style="border-radius: 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444;">{{ message }}</div>
                {% endfor %}

                <form action="{{ path('app_profile') }}" method="POST" enctype="multipart/form-data">
                    <input type="file" id="image_profil" name="image_profil" accept="image/png, image/jpeg" style="display: none;" onchange="previewLocalImage(this)">
                    <input type="hidden" id="avatar_url" name="avatar_url">
                    <input type="file" id="cv_pdf" name="cv_pdf" accept="application/pdf" style="display: none;" onchange="document.getElementById('lbl-cv').innerText = this.files[0].name">

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label>NOM COMPLET</label>
                            <input type="text" name="nom" class="form-control-custom editable-field" value="{{ user.nom }}" disabled required>
                        </div>
                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label>ADRESSE EMAIL</label>
                            <input type="email" name="email" class="form-control-custom editable-field" value="{{ user.email }}" disabled required>
                        </div>
                    </div>

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label>RÔLE SYSTÈME</label>
                            <input type="text" class="form-control-custom" value="{{ user.role }}" disabled>
                        </div>
                        <div class="form-group-custom" style="flex: 1; min-width: 250px;">
                            <label style="color: #2F80ED;"><i class="lni lni-shield me-1"></i> SÉCURITÉ (2FA)</label>
                            <select name="auth_method" class="form-control-custom editable-field" disabled>
                                <option value="NONE" {% if user.authMethod == 'NONE' %}selected{% endif %}>Désactivée</option>
                                <option value="EMAIL" {% if user.authMethod == 'EMAIL' %}selected{% endif %}>Par Email</option>
                                <option value="FACE" {% if user.authMethod == 'FACE' %}selected{% endif %}>Reconnaissance Faciale</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group-custom mt-3">
                        <label>MOT DE PASSE & ACCÈS</label>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc;">
                            <div>
                                <div style="font-weight: 800; color: #0f172a; font-size: 15px;">Mot de passe du compte</div>
                                <div style="font-size: 13px; color: #64748b; margin-top: 2px;">Assurez-vous d'utiliser un mot de passe robuste.</div>
                            </div>
                            <button type="button" class="btn-outline-custom" style="padding: 8px 20px; font-size: 13px;" onclick="document.getElementById('securityModal').style.display='flex'">
                                <i class="lni lni-lock me-1"></i> Modifier
                            </button>
                        </div>
                    </div>

                    <div class="form-group-custom mt-4">
                        <label>CV / COMPÉTENCES (PDF)</label>
                        <div class="cv-box">
                            <div style="display: flex; align-items: center;">
                                <i class="lni lni-empty-file" style="font-size: 24px; color: #2F80ED; margin-right: 15px;"></i>
                                <span id="lbl-cv" style="font-weight: 600; color: #0f172a; font-size: 15px;">
                                    {% if user.skills %}CV_{{ user.nom|replace({' ': '_'}) }}.pdf{% else %}Aucun document lié{% endif %}
                                </span>
                            </div>
                            <div id="cv-read-actions">
                                {% if user.skills %}
                                    <a href="{{ asset('uploads/CV/' ~ user.skills) }}" target="_blank" class="btn-outline-custom" style="padding: 6px 18px; font-size: 13px;"><i class="lni lni-eye"></i> Ouvrir</a>
                                {% endif %}
                            </div>
                            <div id="cv-edit-actions" style="display: none;">
                                <label for="cv_pdf" class="btn-liquid" style="padding: 6px 18px; font-size: 13px; margin: 0; cursor: pointer;"><i class="lni lni-upload"></i> Remplacer</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions mt-4 pt-4" id="save-actions" style="display: none; justify-content: flex-end; gap: 15px; border-top: 1px solid #f1f5f9;">
                        <button type="button" class="btn-outline-custom" onclick="toggleEditMode(false)">Annuler</button>
                        <button type="submit" class="btn-liquid btn-liquid-success">Enregistrer les modifications</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="security-modal" id="securityModal" onclick="closeSecurityModal(event)">
        <div class="security-box">
            <div class="text-center mb-4">
                <div style="width: 60px; height: 60px; background: rgba(47, 128, 237, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto; color: #2F80ED; font-size: 28px;">
                    <i class="lni lni-shield"></i>
                </div>
                <h4 class="fw-bold" style="color: #0f172a; margin: 0;">Sécurité du compte</h4>
                <p style="color: #64748b; font-size: 13px; margin-top: 5px;">Veuillez confirmer votre identité.</p>
            </div>

            <form action="{{ path('app_profile_password') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">
                
                <div class="pwd-input-group">
                    <label class="form-group-custom"><span style="font-size:11px; font-weight:700; color:#64748b;">MOT DE PASSE ACTUEL</span></label>
                    <input type="password" name="old_password" class="form-control-custom" placeholder="Saisissez le mot de passe actuel" required>
                    <i class="lni lni-eye toggle-pwd" onclick="toggleVisibility(this)"></i>
                </div>

                <div class="pwd-input-group">
                    <label class="form-group-custom"><span style="font-size:11px; font-weight:700; color:#64748b;">NOUVEAU MOT DE PASSE</span></label>
                    <input type="password" name="new_password" id="new_password" class="form-control-custom" placeholder="8 caractères minimum" required onkeyup="checkStrength(this.value)">
                    <i class="lni lni-eye toggle-pwd" onclick="toggleVisibility(this)"></i>
                    <div class="strength-meter"><div class="strength-bar" id="strengthBar"></div></div>
                    <div class="strength-text" id="strengthText">Saisissez un mot de passe</div>
                </div>

                <div class="pwd-input-group mb-4">
                    <label class="form-group-custom"><span style="font-size:11px; font-weight:700; color:#64748b;">CONFIRMER LE MOT DE PASSE</span></label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control-custom" placeholder="Répétez le nouveau mot de passe" required onkeyup="checkMatch()">
                    <i class="lni lni-eye toggle-pwd" onclick="toggleVisibility(this)"></i>
                    <div class="strength-text text-danger" id="matchText" style="display:none; text-align: left;">Les mots de passe ne correspondent pas.</div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-light fw-bold w-50" style="border-radius: 50px; padding: 12px; border: 1px solid #e2e8f0; color: #64748b;" onclick="document.getElementById('securityModal').style.display='none'">Annuler</button>
                    <button type="submit" class="btn-liquid btn-liquid-success w-50" id="btnSubmitPwd" style="padding: 12px;" disabled>Mettre à jour</button>
                </div>
            </form>
        </div>
    </div>

    <div class="avatar-modal" id="avatarModal" onclick="closeModal(event)">
        <div class="avatar-grid">
            <h4 style="grid-column: span 4; text-align: center; margin-bottom: 10px; color: #0f172a; font-weight: 800;">Choisir un avatar</h4>
            {% set avatars = [
                "https://cdn-icons-png.flaticon.com/512/4140/4140047.png", "https://cdn-icons-png.flaticon.com/512/1144/1144709.png",
                "https://cdn-icons-png.flaticon.com/512/6997/6997662.png", "https://cdn-icons-png.flaticon.com/512/147/147140.png",
                "https://cdn-icons-png.flaticon.com/512/147/147144.png", "https://cdn-icons-png.flaticon.com/512/4140/4140048.png",
                "https://cdn-icons-png.flaticon.com/512/147/147142.png", "https://cdn-icons-png.flaticon.com/512/147/147129.png"
            ] %}
            {% for url in avatars %}
                <img src="{{ url }}" alt="Avatar" onclick="selectAvatar('{{ url }}')">
            {% endfor %}
            <button type="button" class="btn-outline-custom mt-3" style="grid-column: span 4;" onclick="document.getElementById('avatarModal').style.display='none'">Fermer</button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        AOS.init({ once: true, offset: 50 });

        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('preloader').style.opacity = '0';
                setTimeout(function() { document.getElementById('preloader').style.display = 'none'; }, 800);
            }, 500); 
        });

        let lastScrollTop = 0;
        const navbar = document.getElementById('smartNavbar');
        const progressBar = document.getElementById('scrollBar');
        
        window.addEventListener('scroll', function() {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            let docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            progressBar.style.width = ((scrollTop / docHeight) * 100) + "%";

            if (scrollTop > lastScrollTop && scrollTop > 100) {
                navbar.classList.add('navbar-hidden');
            } else {
                navbar.classList.remove('navbar-hidden');
            }
            lastScrollTop = scrollTop;
        });

        function toggleEditMode(active) {
            document.querySelectorAll('.editable-field').forEach(field => field.disabled = !active);
            document.getElementById('btn-edit').style.display = active ? 'none' : 'inline-block';
            document.getElementById('save-actions').style.display = active ? 'flex' : 'none';
            document.getElementById('image-actions').style.display = active ? 'block' : 'none';
            document.getElementById('cv-read-actions').style.display = active ? 'none' : 'block';
            document.getElementById('cv-edit-actions').style.display = active ? 'block' : 'none';
        }

        function previewLocalImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatar-preview').src = e.target.result;
                    document.getElementById('avatar_url').value = ''; 
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function selectAvatar(url) {
            document.getElementById('avatar-preview').src = url;
            document.getElementById('avatar_url').value = url;
            document.getElementById('image_profil').value = ''; 
            document.getElementById('avatarModal').style.display = 'none';
        }

        function closeModal(event) {
            if (event.target.id === 'avatarModal') { document.getElementById('avatarModal').style.display = 'none'; }
        }

        /* ✅ LOGIQUE DU MODAL DE SÉCURITÉ */
        function closeSecurityModal(event) {
            if (event.target.id === 'securityModal') { document.getElementById('securityModal').style.display = 'none'; }
        }

        function toggleVisibility(icon) {
            let input = icon.previousElementSibling;
            if (input.type === "password") {
                input.type = "text";
                icon.style.color = "#2F80ED";
            } else {
                input.type = "password";
                icon.style.color = "#94a3b8";
            }
        }

        function checkStrength(pwd) {
            let bar = document.getElementById('strengthBar');
            let text = document.getElementById('strengthText');
            let strength = 0;
            
            if(pwd.length === 0) {
                bar.style.width = '0%'; text.innerText = 'Saisissez un mot de passe'; text.style.color = '#64748b'; return checkMatch();
            }

            if(pwd.length >= 8) strength += 25;
            if(pwd.match(/[a-z]+/)) strength += 25;
            if(pwd.match(/[A-Z]+/)) strength += 25;
            if(pwd.match(/[0-9]+/) || pwd.match(/[\W]+/)) strength += 25;

            bar.style.width = strength + '%';
            
            if(strength <= 25) { bar.style.background = '#ef4444'; text.innerText = 'Faible (Ajoutez des majuscules/chiffres)'; text.style.color = '#ef4444'; }
            else if(strength <= 50) { bar.style.background = '#f59e0b'; text.innerText = 'Moyen (Pas mal)'; text.style.color = '#f59e0b'; }
            else if(strength <= 75) { bar.style.background = '#3b82f6'; text.innerText = 'Bon'; text.style.color = '#3b82f6'; }
            else { bar.style.background = '#10b981'; text.innerText = 'Excellent (Sécurisé)'; text.style.color = '#10b981'; }
            
            checkMatch();
        }

        function checkMatch() {
            let pwd1 = document.getElementById('new_password').value;
            let pwd2 = document.getElementById('confirm_password').value;
            let matchText = document.getElementById('matchText');
            let btn = document.getElementById('btnSubmitPwd');

            if(pwd2.length > 0 && pwd1 !== pwd2) {
                matchText.style.display = 'block';
                btn.disabled = true;
            } else {
                matchText.style.display = 'none';
                // Active le bouton uniquement si le mdp fait au moins 8 caractères et correspond
                if (pwd1.length >= 8 && pwd1 === pwd2) {
                    btn.disabled = false;
                } else {
                    btn.disabled = true;
                }
            }
        }
    </script>
{% endblock %}