{% extends 'admin/base_admin.html.twig' %}


{% block title %}Participations - {{ formation.titre }}{% endblock %}

{% block body %}
<div class="page-header">
    <h3 class="fw-bold mb-3">Participations — {{ formation.titre }}</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home"><a href="#"><i class="icon-home"></i></a></li>
        <li class="separator"><i class="icon-arrow-right"></i></li>
        <li class="nav-item"><a href="{{ path('app_admin_formations') }}">Formations</a></li>
        <li class="separator"><i class="icon-arrow-right"></i></li>
        <li class="nav-item"><a href="#">Participations</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">

        <!-- Info formation -->
        <div class="card mb-3" style="border-left: 4px solid #4d8aff;">
            <div class="card-body d-flex align-items-center gap-3 flex-wrap">
                <div style="width: 52px; height: 52px; background: #ebf4ff; border-radius: 12px;
                            display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <i class="fas fa-graduation-cap fa-lg text-primary"></i>
                </div>
                <div>
                    <h5 class="mb-1" style="font-size: 17px;">{{ formation.titre }}</h5>
                    <div class="d-flex gap-2 flex-wrap">
                        {% if formation.domaine %}
                            <span class="badge badge-info" style="font-size: 12px; padding: 5px 10px;">{{ formation.domaine }}</span>
                        {% endif %}
                        {% if formation.niveau == 'Débutant' %}
                            <span class="badge badge-success" style="font-size: 12px; padding: 5px 10px;">{{ formation.niveau }}</span>
                        {% elseif formation.niveau == 'Intermédiaire' %}
                            <span class="badge badge-warning" style="font-size: 12px; padding: 5px 10px;">{{ formation.niveau }}</span>
                        {% else %}
                            <span class="badge badge-danger" style="font-size: 12px; padding: 5px 10px;">{{ formation.niveau }}</span>
                        {% endif %}
                        <span class="badge badge-primary" style="font-size: 12px; padding: 5px 10px;">
                            <i class="fas fa-users me-1"></i>{{ participations|length }} participant(s)
                        </span>
                    </div>
                </div>
                <a href="{{ path('app_admin_formations') }}" class="btn btn-secondary btn-sm ms-auto">
                    <i class="fa fa-arrow-left me-1"></i> Retour aux formations
                </a>
            </div>
        </div>

        <!-- Table participations -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <h4 class="card-title mb-0">Liste des Participants</h4>

                    <!-- BARRE DE RECHERCHE + FILTRES -->
                    <div class="d-flex align-items-center gap-2 ms-auto flex-wrap">
                        <div style="position: relative;">
                            <i class="fa fa-search" style="position: absolute; left: 12px; top: 50%;
                               transform: translateY(-50%); color: #aaa; font-size: 14px;"></i>
                            <input type="text" id="searchInput" placeholder="Rechercher un participant..."
                                style="padding: 8px 14px 8px 36px; border: 1.5px solid #e0e0e0;
                                       border-radius: 25px; font-size: 14px; width: 240px; outline: none;
                                       transition: border-color 0.2s;"
                                onfocus="this.style.borderColor='#4d8aff'"
                                onblur="this.style.borderColor='#e0e0e0'">
                        </div>

                        <select id="filterScore"
                            style="padding: 8px 16px; border: 1.5px solid #e0e0e0; border-radius: 25px;
                                   font-size: 14px; outline: none; cursor: pointer; background: #f8f9fa;">
                            <option value="">Tous les scores</option>
                            <option value="high">Excellent (≥7)</option>
                            <option value="mid">Moyen (4-6)</option>
                            <option value="low">Faible (&lt;4)</option>
                            <option value="none">Non noté</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}

                {% if participations is empty %}
                    <div class="text-center py-5">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <p class="text-muted" style="font-size: 16px;">Aucune participation pour cette formation.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" style="font-size: 15px;">
                            <thead>
                                <tr style="font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px;">
                                    <th>Participant</th>
                                    <th>Poste actuel</th>
                                    <th>Attentes</th>
                                    <th>Date inscription</th>
                                    <th>Score</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="participationsBody">
                            {% for participation in participations %}
{% set score = participation.score %}
{% set scoreClass = score is not null ? (score >= 7 ? 'high' : (score >= 4 ? 'mid' : 'low')) : 'none' %}
{% set user = utilisateurs[participation.idUtilisateur] ?? null %}
<tr class="participation-row"
    data-nom="{{ user ? user.nom|lower : '' }}"
    data-poste="{{ participation.posteActuel ? participation.posteActuel|lower : '' }}"
    data-score="{{ scoreClass }}">
                                    <!-- Participant -->
                                    <td style="vertical-align: middle;">
                                        {% set user = utilisateurs[participation.idUtilisateur] ?? null %}
                                        {% if user %}
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                {% if user.image %}
                                                    <img src="{{ asset('uploads/' ~ user.image) }}"
                                                         style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 2px solid #e0e0e0;">
                                                {% else %}
                                                    <div style="width: 38px; height: 38px; border-radius: 50%;
                                                                background: linear-gradient(135deg, #4d8aff, #1a6fd8);
                                                                display: flex; align-items: center; justify-content: center;
                                                                color: white; font-weight: 700; font-size: 15px; flex-shrink: 0;">
                                                        {{ user.nom|first|upper }}
                                                    </div>
                                                {% endif %}
                                                <div>
                                                    <strong style="font-size: 15px;">{{ user.nom }}</strong><br>
                                                    <small class="text-muted">{{ user.email }}</small>
                                                </div>
                                            </div>
                                        {% else %}
                                            <span class="badge badge-secondary" style="font-size: 13px; padding: 6px 10px;">
                                                Utilisateur #{{ participation.idUtilisateur }}
                                            </span>
                                        {% endif %}
                                    </td>

                                    <!-- Poste -->
                                    <td style="vertical-align: middle; font-size: 15px;">
                                        {{ participation.posteActuel ?? '—' }}
                                    </td>

                                    <!-- Attentes -->
                                    <td style="vertical-align: middle; font-size: 14px; color: #666; max-width: 200px;">
                                        {% if participation.attentes %}
                                            <span data-bs-toggle="tooltip" title="{{ participation.attentes }}">
                                                {{ participation.attentes|slice(0, 50) }}{% if participation.attentes|length > 50 %}...{% endif %}
                                            </span>
                                        {% else %}—{% endif %}
                                    </td>

                                    <!-- Date -->
                                    <td style="vertical-align: middle;">
                                        {% if participation.dateInscription %}
                                            <span style="font-size: 14px;">
                                                <i class="fa fa-calendar me-1 text-muted"></i>
                                                {{ participation.dateInscription|date('d/m/Y') }}
                                            </span>
                                        {% else %}—{% endif %}
                                    </td>

                                    <!-- Score -->
                                    <td style="vertical-align: middle;">
                                        {% if participation.score is not null %}
                                            {% if participation.score >= 7 %}
                                                <span class="badge badge-success" style="font-size: 14px; padding: 7px 12px;">
                                                    {{ participation.score }}/10
                                                </span>
                                            {% elseif participation.score >= 4 %}
                                                <span class="badge badge-warning" style="font-size: 14px; padding: 7px 12px;">
                                                    {{ participation.score }}/10
                                                </span>
                                            {% else %}
                                                <span class="badge badge-danger" style="font-size: 14px; padding: 7px 12px;">
                                                    {{ participation.score }}/10
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge badge-light" style="font-size: 13px; padding: 6px 10px; color: #888;">
                                                Non noté
                                            </span>
                                        {% endif %}
                                    </td>

                                    <!-- Actions -->
                                    <td style="vertical-align: middle;">
                                        <a href="{{ path('app_admin_participation_delete', {id: participation.idParticipation}) }}"
                                           class="btn btn-danger btn-sm"
                                           title="Supprimer"
                                           onclick="return confirm('Supprimer cette participation ?')"
                                           style="padding: 6px 10px; font-size: 15px;">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>

                        <!-- Empty state après filtre -->
                        <div id="noResults" style="display:none; text-align:center; padding: 40px;">
                            <i class="fa fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted" style="font-size: 16px;">Aucun participant ne correspond à votre recherche.</p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function () {

    // Tooltips
    $('[data-bs-toggle="tooltip"]').tooltip();

    // Recherche + Filtre
    function filterRows() {
        var search = $('#searchInput').val().toLowerCase();
        var score = $('#filterScore').val();
        var visible = 0;

        $('.participation-row').each(function () {
            var nom = $(this).data('nom');
            var poste = $(this).data('poste');
            var rowScore = $(this).data('score');

            var matchSearch = nom.includes(search) || poste.includes(search);
            var matchScore = score === '' || rowScore === score;

            if (matchSearch && matchScore) {
                $(this).show();
                visible++;
            } else {
                $(this).hide();
            }
        });

        $('#noResults').toggle(visible === 0);
    }

    $('#searchInput').on('input', filterRows);
    $('#filterScore').on('change', filterRows);
});
</script>
{% endblock %}
