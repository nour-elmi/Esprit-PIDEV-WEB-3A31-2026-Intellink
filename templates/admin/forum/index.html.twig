{% extends 'admin/base_back.html.twig' %}

{% block title %}Admin Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forum.css') }}">
{% endblock %}

{% block body %}
<div class="page-content">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2 class="mb-0">Admin • Forum</h2>

        <form method="get" action="{{ path('app_admin_forum') }}" class="d-flex gap-2 flex-wrap">
            <input
                type="text"
                name="q"
                value="{{ search }}"
                placeholder="Rechercher…"
                class="form-control"
                style="min-width: 280px;"
            >
            <input type="hidden" name="filter" value="{{ filter }}">
            <input type="hidden" name="status" value="{{ statusFilter }}">
            <a href="{{ path('app_post_create') }}" class="btn btn-primary">Créer</a>
        </form>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('app_admin_forum', {filter: 'Tous', status: statusFilter, q: search}) }}"
                   class="btn {{ filter == 'Tous' ? 'btn-primary' : 'btn-outline-primary' }}">
                    Tous
                </a>

                <a href="{{ path('app_admin_forum', {filter: 'Populaire', status: statusFilter, q: search}) }}"
                   class="btn {{ filter == 'Populaire' ? 'btn-primary' : 'btn-outline-primary' }}">
                    Populaire
                </a>

                <a href="{{ path('app_admin_forum', {filter: '24h', status: statusFilter, q: search}) }}"
                   class="btn {{ filter == '24h' ? 'btn-primary' : 'btn-outline-primary' }}">
                    24h
                </a>
            </div>

            <form method="get" action="{{ path('app_admin_forum') }}">
                <input type="hidden" name="q" value="{{ search }}">
                <input type="hidden" name="filter" value="{{ filter }}">

                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="Tous" {{ statusFilter == 'Tous' ? 'selected' : '' }}>Tous</option>
                    <option value="Masqués" {{ statusFilter == 'Masqués' ? 'selected' : '' }}>Masqués</option>
                    <option value="Actifs" {{ statusFilter == 'Actifs' ? 'selected' : '' }}>Actifs</option>
                </select>
            </form>
        </div>
    </div>

    <div class="d-flex flex-column gap-3">
        {% for post in posts %}
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <div class="fw-bold text-primary">
                                u/{{ post.author ? post.author.nom : 'Unknown' }}
                            </div>
                            <div class="text-muted small">
                                • {{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '' }}
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            {% if post.isPinned %}
                                <span class="badge bg-primary">📌 PINNÉ</span>
                            {% endif %}
                            {% if post.isLocked %}
                                <span class="badge bg-dark">🔒 LOCK</span>
                            {% endif %}
                            {% if post.status and post.status != 'ACTIVE' %}
                                <span class="badge bg-secondary">{{ post.status }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mb-3" style="white-space: pre-wrap;">
                        {{ post.content }}
                    </div>

                    {% if post.images is not empty %}
                        <div class="mb-3">
                            <div class="reddit-media">
                                {% for image in post.images %}
                                    <img
                                        src="{{ asset('uploads/posts/' ~ image.imageUrl) }}"
                                        alt="Post image"
                                        class="post-image"
                                    >
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <span class="text-muted">Score: {{ postScores[post.id] ?? 0 }}</span>

                        <a href="{{ path('app_admin_comments', {id: post.id}) }}" class="btn btn-sm btn-outline-secondary">
                            💬 commentaires
                        </a>

                        <form method="post" action="{{ path('app_admin_post_toggle_pin', {id: post.id}) }}" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                {{ post.isPinned ? 'Désépingler' : 'Épingler' }}
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_admin_post_toggle_lock', {id: post.id}) }}" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                {{ post.isLocked ? 'Déverrouiller' : 'Verrouiller' }}
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_admin_post_toggle_hide', {id: post.id}) }}" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                {{ post.status == 'HIDDEN' ? 'Afficher' : 'Masquer' }}
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_admin_post_delete', {id: post.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce post ?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="card">
                <div class="card-body text-muted">Aucun post trouvé.</div>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}