{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Projets{% endblock %}

{% block body %}
<div class="card admin-projects-card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="card-title mb-1">Gestion des projets</h4>
                <p class="admin-projects-subtitle mb-0">Suivi, consultation et suppression des projets</p>
            </div>
            <span class="admin-projects-counter">{{ projetsAvecStats|length }} projet(s)</span>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table id="table-projets" class="table admin-projects-table align-middle">
                <thead>
                    <tr>
                        <th>Projet</th>
                        <th>Créateur</th>
                        <th>Statut</th>
                        <th>Prix</th>
                        <th>Participants</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for item in projetsAvecStats %}
                        {% set projet = item.projet %}
                        <tr>
                            <td>
                                <div class="admin-project-title">{{ projet.titre }}</div>
                                <div class="admin-project-desc">{{ projet.description ?: 'Aucune description disponible' }}</div>
                            </td>

                            <td>
                                <span class="admin-creator-chip">
                                    <i class="fa fa-user-circle me-2"></i>{{ projet.createur }}
                                </span>
                            </td>

                            <td>
                                {% set statut = projet.statut|lower %}
                                {% if 'cours' in statut %}
                                    <span class="admin-badge blue">En cours</span>
                                {% elseif 'term' in statut %}
                                    <span class="admin-badge green">Terminé</span>
                                {% elseif 'attente' in statut %}
                                    <span class="admin-badge orange">En attente</span>
                                {% elseif 'refus' in statut %}
                                    <span class="admin-badge red">Refusé</span>
                                {% else %}
                                    <span class="admin-badge gray">{{ projet.statut }}</span>
                                {% endif %}
                            </td>

                            <td>
                                <span class="admin-price-chip">{{ projet.prix }} TND</span>
                            </td>

                            <td>
                                <span class="admin-count-bubble">{{ item.nbParticipations }}</span>
                            </td>

                            <td>
                                <div class="admin-actions">
                                    <a href="{{ path('admin_projet_participations', {'id': projet.id}) }}"
                                       class="btn btn-primary btn-sm">
                                        Voir
                                    </a>

                                    <a href="{{ path('admin_projet_delete', {'id': projet.id}) }}"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Supprimer ce projet ?');">
                                        Supprimer
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4">Aucun projet trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function () {
        $('#table-projets').DataTable({
            pageLength: 10,
            paging: false,
            info: false,
            autoWidth: false,
            responsive: false,
            language: {
                search: "Rechercher :",
                lengthMenu: "Afficher _MENU_ entrées",
                zeroRecords: "Aucun résultat",
                emptyTable: "Aucune donnée disponible"
            }
        });
    });
</script>
{% endblock %}