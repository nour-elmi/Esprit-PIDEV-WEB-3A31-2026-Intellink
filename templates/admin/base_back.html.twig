<!DOCTYPE html>
<html lang="fr">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{% block title %}Dashboard Administrateur{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0, shrink-to-fit=no" name="viewport" />

    <link rel="icon" href="{{ asset('assets/img/logo/logo.png') }}" type="image/x-icon" />

    <script src="{{ asset('assets/js/plugin/webfont/webfont.min.js') }}"></script>
    <script>
        WebFont.load({
            google: { families: ["Public Sans:300,400,500,600,700"] },
            custom: {
                families: [
                    "Font Awesome 5 Solid",
                    "Font Awesome 5 Regular",
                    "Font Awesome 5 Brands",
                    "simple-line-icons",
                ],
                urls: ["{{ asset('assets/css/fonts.min.css') }}"],
            },
            active: function () {
                sessionStorage.fonts = true;
            },
        });
    </script>

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}" />
        <link rel="stylesheet" href="{{ asset('assets/css/plugins.min.css') }}" />
        <link rel="stylesheet" href="{{ asset('assets/css/kaiadmin.min.css') }}" />
        <link rel="stylesheet" href="{{ asset('assets/css/demo.css') }}" />
        <link rel="stylesheet" href="{{ asset('css/forum.css') }}" />
    {% endblock %}
</head>
<body>
<div class="wrapper">
    <div class="sidebar" data-background-color="dark">
        <div class="sidebar-logo">
            <div class="logo-header" data-background-color="white">
                <a href="{{ path('app_admin_forum') }}" class="logo">
                    <img src="{{ asset('assets/img/logo.png') }}" alt="navbar brand" class="navbar-brand" height="50" />
                </a>
                <div class="nav-toggle">
                    <button class="btn btn-toggle toggle-sidebar">
                        <i class="gg-menu-right"></i>
                    </button>
                    <button class="btn btn-toggle sidenav-toggler">
                        <i class="gg-menu-left"></i>
                    </button>
                </div>
                <button class="topbar-toggler more">
                    <i class="gg-more-vertical-alt"></i>
                </button>
            </div>
        </div>

        <div class="sidebar-wrapper scrollbar scrollbar-inner">
            <div class="sidebar-content">
                {% set currentRoute = app.request.attributes.get('_route') %}

                <ul class="nav nav-secondary">
                    <li class="nav-item {{ currentRoute == 'app_admin_forum' ? 'active' : '' }}">
                        <a href="{{ path('app_admin_forum') }}">
                            <i class="fas fa-home"></i>
                            <p>Dashboard Forum</p>
                        </a>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon">
                            <i class="fa fa-ellipsis-h"></i>
                        </span>
                        <h4 class="text-section">Modules de Gestion</h4>
                    </li>

                    {% set forumOpen = currentRoute in ['app_admin_forum', 'app_admin_comments', 'app_admin_reports'] %}

                    <li class="nav-item {{ forumOpen ? 'active submenu' : '' }}">
                        <a data-bs-toggle="collapse" href="#gestionForum" aria-expanded="{{ forumOpen ? 'true' : 'false' }}">
                            <i class="fas fa-comments"></i>
                            <p>Gestion du Forum</p>
                            <span class="caret"></span>
                        </a>

                        <div class="collapse {{ forumOpen ? 'show' : '' }}" id="gestionForum">
                            <ul class="nav nav-collapse">
                                <li class="{{ currentRoute == 'app_admin_forum' ? 'active' : '' }}">
                                    <a href="{{ path('app_admin_forum') }}">
                                        <span class="sub-item">Liste des posts</span>
                                    </a>
                                </li>

                                <li class="{{ currentRoute == 'app_admin_reports' ? 'active' : '' }}">
                                    <a href="{{ path('app_admin_reports') }}">
                                        <span class="sub-item">Liste des reports</span>
                                    </a>
                                </li>

                                {% if currentRoute == 'app_admin_comments' %}
                                    <li class="active">
                                        <a href="javascript:void(0)">
                                            <span class="sub-item">Commentaires du post</span>
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item">
                        <a data-bs-toggle="collapse" href="#gestionFormations">
                            <i class="fas fa-graduation-cap"></i>
                            <p>Gestion des Formations</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse" id="gestionFormations">
                            <ul class="nav nav-collapse">
                                <li>
                                    <a href="{{ path('app_admin_formations')}}">
                                        <span class="sub-item">Liste des Formations</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item">
                        <a data-bs-toggle="collapse" href="#gestionEmplois">
                            <i class="fas fa-briefcase"></i>
                            <p>Gestion des Emplois</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse" id="gestionEmplois">
                            <ul class="nav nav-collapse">
                                <li>
                                    <a href="{{ path('showoffreBack')}}">
                                        <span class="sub-item">Offres d'Emploi</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item">
                        <a data-bs-toggle="collapse" href="#gestionProjets">
                            <i class="fas fa-handshake"></i>
                            <p>Gestion des Projets</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse" id="gestionProjets">
                            <ul class="nav nav-collapse">
                                <li>
                                    <a href="{{ path('admin_projets')}}">
                                        <span class="sub-item">Liste des Projets</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item">
                        <a data-bs-toggle="collapse" href="#gestionUtilisateurs">
                            <i class="fas fa-users-cog"></i>
                            <p>Gestion des Utilisateurs</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse" id="gestionUtilisateurs">
                            <ul class="nav nav-collapse">
                                <li>
                                    <a href="{{ path('app_admin_users')}}">
                                        <span class="sub-item">Liste des Utilisateurs</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="main-panel">
        <div class="main-header">
            <div class="main-header-logo">
                <div class="logo-header" data-background-color="dark2">
                    <a href="{{ path('app_admin_forum') }}" class="logo">
                        <img src="{{ asset('assets/img/logo.png') }}" alt="navbar brand" class="navbar-brand" height="20" />
                    </a>
                    <div class="nav-toggle">
                        <button class="btn btn-toggle toggle-sidebar">
                            <i class="gg-menu-right"></i>
                        </button>
                        <button class="btn btn-toggle sidenav-toggler">
                            <i class="gg-menu-left"></i>
                        </button>
                    </div>
                    <button class="topbar-toggler more">
                        <i class="gg-more-vertical-alt"></i>
                    </button>
                </div>
            </div>

            <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
                <div class="container-fluid">
                    <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
                        <li class="nav-item topbar-user dropdown hidden-caret">
                            <a class="dropdown-toggle profile-pic" data-bs-toggle="dropdown" href="#" aria-expanded="false">
                                <div class="avatar-sm">
                                    <img
                                        src="{{ asset('assets/img/profile.jpg') }}"
                                        alt="..."
                                        class="avatar-img rounded-circle"
                                        onerror="this.src='https://ui-avatars.com/api/?name=Admin&background=2F80ED&color=fff';"
                                    />
                                </div>
                                <span class="profile-username">
                                    <span class="op-7">Bonjour,</span>
                                    <span class="fw-bold">Admin</span>
                                </span>
                            </a>

                            <ul class="dropdown-menu dropdown-user animated fadeIn">
                                <div class="dropdown-user-scroll scrollbar-outer">
                                    <li>
                                        <div class="user-box">
                                            <div class="avatar-lg">
                                                <img
                                                    src="{{ asset('assets/img/profile.jpg') }}"
                                                    alt="image profile"
                                                    class="avatar-img rounded"
                                                    onerror="this.src='https://ui-avatars.com/api/?name=Admin&background=2F80ED&color=fff';"
                                                />
                                            </div>
                                            <div class="u-text">
                                                <h4>Administrateur</h4>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="javascript:void(0)">Mon Profil</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="javascript:void(0)">Déconnexion</a>
                                    </li>
                                </div>
                            </ul>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>

        <div class="container">
            <div class="page-inner">
                {% block body %}{% endblock %}
            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid d-flex justify-content-between">
                <nav class="pull-left">
                    <ul class="nav">
                        <li class="nav-item">
                            <a class="nav-link" href="javascript:void(0)">Forum Backend</a>
                        </li>
                    </ul>
                </nav>
                <div class="copyright">
                    2026, développé avec <i class="fa fa-heart heart text-danger"></i>
                </div>
            </div>
        </footer>
    </div>
</div>

{% block javascripts %}
    <script src="{{ asset('assets/js/core/jquery-3.7.1.min.js') }}"></script>
    <script src="{{ asset('assets/js/core/popper.min.js') }}"></script>
    <script src="{{ asset('assets/js/core/bootstrap.min.js') }}"></script>
    <script src="{{ asset('assets/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js') }}"></script>
    <script src="{{ asset('assets/js/kaiadmin.min.js') }}"></script>
{% endblock %}
</body>
</html>