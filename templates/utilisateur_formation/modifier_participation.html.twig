{% extends 'base.html.twig' %}

{% block title %}Modifier mon inscription{% endblock %}
{% block role_badge_class %}badge-utilisateur{% endblock %}
{% block role_label %}Apprenant{% endblock %}

{% block body %}

<section class="page-hero">
    <div class="container">
        <div class="hero-content">
            <a href="{{ path('app_utilisateur_mes_participations') }}" class="back-link" style="color: rgba(255,255,255,0.7);">
                <i class="lni lni-arrow-left"></i> Retour à mes inscriptions
            </a>
         
            <h1>Modifier mon inscription</h1>
            <p>{{ participation.formation.titre }}</p>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <!-- INFO FORMATION -->
                <div class="info-card-show" style="margin-bottom: 24px;">
                    <div class="info-card-header">
                        <i class="lni lni-graduation"></i>
                        <span>Formation</span>
                    </div>
                    <div class="info-card-body">
                        <div class="info-item">
                            <span class="info-item-label">Titre</span>
                            <span class="info-item-value">{{ participation.formation.titre }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-item-label">Domaine</span>
                            <span class="tag tag-primary">
                                <i class="lni lni-tag"></i> {{ participation.formation.domaine ?? 'N/A' }}
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-item-label">Niveau</span>
                            {% if participation.formation.niveau == 'Débutant' %}
                                <span class="tag tag-success">{{ participation.formation.niveau }}</span>
                            {% elseif participation.formation.niveau == 'Intermédiaire' %}
                                <span class="tag tag-warning">{{ participation.formation.niveau }}</span>
                            {% else %}
                                <span class="tag tag-dark">{{ participation.formation.niveau }}</span>
                            {% endif %}
                        </div>
                        {% if participation.dateInscription %}
                        <div class="info-item">
                            <span class="info-item-label">Inscrit le</span>
                            <span class="tag tag-dark">
                                <i class="lni lni-calendar"></i>
                                {{ participation.dateInscription|date('d/m/Y') }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- FORMULAIRE -->
                <div class="formation-form-wrapper">
                    <div class="detail-section-title" style="margin-bottom: 24px;">
                        <i class="lni lni-pencil"></i> Modifier mes informations
                    </div>

                    <form method="POST">
                        <div class="form-group-custom">
                            <label>
                                Poste actuel
                            </label>
                            <input
    type="text"
    name="posteActuel"
    class="form-control-custom"
    value="{{ old.posteActuel ?? participation.posteActuel }}"
>
{% if errors.posteActuel is defined %}
    <small class="text-danger">{{ errors.posteActuel }}</small>
{% endif %}
                        </div>

                        <div class="form-group-custom">
                            <label>
                                Attentes de la formation
                            </label>
                            <textarea name="attentes" class="form-control-custom" rows="5">
    {{ old.attentes ?? participation.attentes }}
</textarea>

{% if errors.attentes is defined %}
    <small class="text-danger">{{ errors.attentes }}</small>
{% endif %}
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary-custom">
                                <i class="lni lni-save"></i> Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_utilisateur_mes_participations') }}"
                               class="btn-secondary-custom">
                                <i class="lni lni-arrow-left"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

{% endblock %}