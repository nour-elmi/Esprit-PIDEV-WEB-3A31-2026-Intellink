<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Certificat de reussite - IntelLink</title>
    <style>
        @page {
            size: A4 landscape;
            margin: 0;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: DejaVu Sans, sans-serif;
            color: #1f2937;
            background: #e9eff8;
        }

        .sheet {
            width: 297mm;
            height: 210mm;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #d3dbea;
            position: relative;
            overflow: hidden;
            box-sizing: border-box;
        }

        .top-bar {
            height: 7px;
            background: #1f4ec8;
        }

        .bottom-bar {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 7px;
            background: #1f4ec8;
        }

        .content {
            padding: 11mm 14mm 8mm;
            box-sizing: border-box;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }

        .header-table td {
            vertical-align: middle;
        }

        .logo {
            max-height: 30px;
            max-width: 210px;
        }

        .badge {
            display: inline-block;
            border: 1px solid #a5c0ec;
            border-radius: 28px;
            background: #e9f1ff;
            color: #1f4ec8;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            padding: 5px 12px;
        }

        .rule {
            height: 1px;
            background: #dfe7f3;
            margin-bottom: 12px;
        }

        .label-top {
            text-align: center;
            font-size: 8.5px;
            color: #5e7aa5;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 5px;
            font-weight: 700;
        }

        .title {
            text-align: center;
            font-family: DejaVu Serif, serif;
            font-size: 34px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #0f172a;
            line-height: 1.15;
        }

        .title span {
            color: #2a61e8;
        }

        .subtitle {
            text-align: center;
            color: #7d90ae;
            font-size: 16px;
            margin-bottom: 4px;
            font-weight: 500;
        }

        .name {
            text-align: center;
            font-family: DejaVu Serif, serif;
            font-size: 34px;
            color: #1f4ec8;
            font-weight: 700;
            margin-bottom: 8px;
            word-break: break-word;
        }

        .desc {
            text-align: center;
            font-size: 16px;
            line-height: 1.35;
            color: #334155;
            margin-bottom: 10px;
            max-width: 90%;
            margin-left: auto;
            margin-right: auto;
        }

        .desc strong {
            color: #1f4ec8;
            font-size: 17px;
            word-break: break-word;
        }

        .score-wrap {
            text-align: center;
            margin-bottom: 10px;
        }

        .score-box {
            display: inline-block;
            min-width: 300px;
            border-radius: 14px;
            background: #1f4ec8;
            color: #ffffff;
            padding: 8px 18px;
            text-align: left;
        }

        .score-label {
            color: #c8dafd;
            font-size: 8px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .score-value {
            font-family: DejaVu Serif, serif;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.1;
        }

        .footer-rule {
            height: 1px;
            background: #dfe7f3;
            margin-bottom: 8px;
        }

        .footer-table {
            width: 100%;
            border-collapse: collapse;
        }

        .footer-table td {
            vertical-align: top;
            font-size: 10px;
            color: #64748b;
            line-height: 1.35;
        }

        .footer-table strong {
            color: #334155;
        }

        .sign {
            text-align: right;
            padding-top: 6px;
        }

        .sign-line {
            width: 180px;
            height: 1px;
            background: #a2b4d4;
            margin-left: auto;
            margin-bottom: 4px;
        }

        .sign-name {
            font-size: 14px;
            font-weight: 700;
            color: #1f2937;
        }

        .sign-role {
            font-size: 8px;
            color: #8aa0c1;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
<div class="sheet">
    <div class="top-bar"></div>

    <div class="content">
        <table class="header-table">
            <tr>
                <td>
                    {% if logoDataUri %}
                        <img src="{{ logoDataUri }}" alt="IntelLink Logo" class="logo">
                    {% else %}
                        <span style="font-size: 24px; color: #1f4ec8; font-weight: 700;">IntelLink</span>
                    {% endif %}
                </td>
                <td style="text-align: right;">
                    <span class="badge">Certifie Officiel</span>
                </td>
            </tr>
        </table>

        <div class="rule"></div>

        <div class="label-top">Plateforme IntelLink</div>
        <div class="title">Certificat de <span>Reussite</span></div>

        <div class="subtitle">Decerne a</div>
        <div class="name">{{ nom }}</div>

        <div class="desc">
            a valide avec succes le quiz de la formation<br>
            <strong>{{ formation.titre }}</strong>
        </div>

        <div class="score-wrap">
            <div class="score-box">
                <div class="score-label">Score obtenu</div>
                <div class="score-value">{{ score }} / {{ scoreMax }}</div>
            </div>
        </div>

        <div class="footer-rule"></div>

        <table class="footer-table">
            <tr>
                <td>
                    <strong>Email:</strong> {{ email }}<br>
                    <strong>Reference:</strong> {{ certificateRef }}<br>
                    <strong>Date:</strong> {{ generatedAt|date('d/m/Y H:i') }}
                </td>
                <td class="sign">
                    <div class="sign-line"></div>
                    <div class="sign-name">IntelLink</div>
                    <div class="sign-role">Plateforme de Formation</div>
                </td>
            </tr>
        </table>
    </div>

    <div class="bottom-bar"></div>
</div>
</body>
</html> 