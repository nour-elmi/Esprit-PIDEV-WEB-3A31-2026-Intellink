{% extends 'formation/base.html.twig' %}

{% block title %}Formations disponibles{% endblock %}
{% block role_badge_class %}badge-utilisateur{% endblock %}
{% block role_label %}Apprenant{% endblock %}

{% block stylesheets %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');
.alerte-progression-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #e8f1ff 0%, #f4f8ff 45%, #eef6ff 100%);
    border: 1px solid #9fc3f8;
    border-left: 6px solid #1d4ed8;
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    box-shadow: 0 10px 26px rgba(37, 99, 235, 0.18);
    animation: bannerGlow 2.6s ease-in-out infinite alternate;
}
.alerte-progression-banner::before {
    content: "";
    position: absolute;
    inset: -35% auto auto -20%;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.24) 0%, rgba(59, 130, 246, 0) 70%);
    pointer-events: none;
}
.alerte-prog-left {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 1;
}
.alerte-prog-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #bfdbfe 0%, #dbeafe 100%);
    color: #1e40af;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    animation: iconPulse 2s infinite;
}
.alerte-prog-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.alerte-prog-text strong {
    font-size: 15px;
    font-weight: 800;
    color: #1e3a8a;
    letter-spacing: 0.01em;
}
.alerte-prog-text span {
    font-size: 13px;
    color: #334155;
}
.alerte-prog-right {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 1;
}
.alerte-prog-bar-wrap {
    width: 120px;
    height: 6px;
    background: #FAC775;
    border-radius: 99px;
    overflow: hidden;
}
.alerte-prog-bar {
    height: 100%;
    background: #854F0B;
    border-radius: 99px;
    transition: width 0.4s ease;
}
.alerte-prog-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: linear-gradient(135deg, #2f80ed 0%, #2563eb 100%);
    color: #fff;
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid #2563eb;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
}
.alerte-prog-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 22px rgba(37, 99, 235, 0.4);
    color: #fff;
}
.alerte-prog-close {
    background: transparent;
    border: none;
    font-size: 18px;
    color: #64748b;
    cursor: pointer;
    padding: 0 2px;
    line-height: 1;
    opacity: 0.7;
}
.alerte-prog-close:hover { opacity: 1; color: #334155; }
@keyframes bannerGlow {
    from { box-shadow: 0 10px 26px rgba(37, 99, 235, 0.14); }
    to   { box-shadow: 0 14px 30px rgba(37, 99, 235, 0.24); }
}
@keyframes iconPulse {
    0%   { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.35); }
    70%  { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
    100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
}
.catalog-panel .alerte-progression-banner {
    margin-bottom: 16px;
}
.formations-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 960px) 260px;
    gap: 24px;
    align-items: start;
    justify-content: center;
}

.news-panel {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: 'DM Sans', sans-serif;
}

.suggestions-panel {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: 'DM Sans', sans-serif;
}


.news-card {
    background: #f0f6ff;
    border: 1.5px solid #b5d4f4;
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.news-card:hover { border-color: #85b7eb; box-shadow: 0 4px 20px rgba(24,95,165,0.10); }

.suggestions-card { background: #f2faf4; border-color: #c0dd97; margin-top: 0; }
.suggestions-card:hover { border-color: #97c459; box-shadow: 0 4px 20px rgba(59,109,17,0.10); }

.news-card-head {
    padding: 18px 20px 14px;
    border-bottom: 1px solid #daeafa;
    display: flex; align-items: flex-start; gap: 12px; margin-bottom: 0;
}
.suggestions-card .news-card-head { border-bottom-color: #d3eebb; }
.news-card-head-icon { width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:16px; }
.news-card-head-icon.icon-news { background: #b5d4f4; }
.news-card-head-icon.icon-suggest { background: #c0dd97; }
.news-card-head-text { flex: 1; }
.news-card-head h3 { font-family:'Syne',sans-serif;font-size:15px;font-weight:700;color:#0c447c;margin:0 0 2px;letter-spacing:-0.01em; }
.suggestions-card .news-card-head h3 { color: #27500a; }
.news-card-head p { margin:0;font-size:12px;color:#185fa5;opacity:0.8;line-height:1.4; }
.suggestions-card .news-card-head p { color: #3b6d11; }

.news-list { margin-top:0;display:flex;flex-direction:column; }
.news-item { padding:14px 20px;border-bottom:1px solid #daeafa;display:flex;flex-direction:column;gap:8px;transition:background 0.15s;text-decoration:none; }
.news-item:last-child { border-bottom: none; }
.news-item:hover { background: #e2effc; }
.news-item-rank { font-family:'DM Sans',sans-serif;font-size:10px;font-weight:800;color:#378add;letter-spacing:0.05em;text-transform:uppercase; }
.news-item-title { margin:0;font-size:13px;font-weight:500;color:#0f172a;line-height:1.5; }
.news-item-footer { display:flex;align-items:center;justify-content:space-between; }
.news-item-meta { display:flex;align-items:center;gap:6px;flex-wrap:wrap; }
.news-source-badge { font-size:10px;font-weight:500;color:#0c447c;background:#b5d4f4;padding:2px 8px;border-radius:20px; }
.news-pts-badge { font-size:10px;font-weight:500;color:#27500a;background:#c0dd97;padding:2px 8px;border-radius:20px; }
.news-date { font-size:10px;color:#185fa5;opacity:0.7; }

.suggestions-list { margin-top:0;display:flex;flex-direction:column; }
.suggestion-item { padding:14px 20px;border-bottom:1px solid #d3eebb;display:flex;align-items:center;gap:14px;transition:background 0.15s;text-decoration:none; }
.suggestion-item:last-child { border-bottom: none; }
.suggestion-item:hover { background: #e5f5e0; }
.suggestion-avatar { width:40px;height:40px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:13px;background:#85b7eb;color:#042c53; }
.suggestion-content { flex:1;min-width:0; }
.suggestion-title { margin:0 0 6px;font-size:13px;font-weight:500;color:#0f172a;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.suggestion-meta { display:flex;align-items:center;gap:5px;flex-wrap:wrap; }
.suggestion-tag { font-size:10px;font-weight:500;background:#c0dd97;color:#27500a;padding:2px 8px;border-radius:20px; }
.suggestion-tag.favori { background:#f5c4b3;color:#712b13; }
.suggestion-arrow { color:#3b6d11;flex-shrink:0; }
.empty-state { padding:20px;text-align:center;color:#64748b;font-size:13px; }

.catalog-panel { min-width: 0;}
.catalog-panel .search-filter-bar { margin-bottom: 24px; }
.catalog-panel #formationsGrid .formation-col { display: flex; }
.catalog-panel #formationsGrid .formation-item { width:100%;display:flex;flex-direction:column; }
.catalog-panel #formationsGrid .card-body-custom { padding: 26px; }
.catalog-panel #formationsGrid .card-title-custom { font-size:19px;margin-bottom:12px; }
.catalog-panel #formationsGrid .card-desc { margin-bottom: 18px; }
.catalog-panel #formationsGrid .card-footer-custom { padding:18px 24px;gap:12px;flex-wrap:wrap; }
.catalog-panel #formationsGrid .card-footer-custom .btn-outline-custom { padding:10px 20px;font-size:14px;white-space:nowrap; }

.favorite-form { margin: 0; }
.card-fav-form { position:absolute;top:12px;right:12px;z-index:5; }
.card-fav-btn { width:36px;height:36px;border-radius:50%;border:1px solid rgba(255,255,255,0.35);background:rgba(15,23,42,0.3);color:#ffffff;display:inline-flex;align-items:center;justify-content:center;font-size:16px;transition:all 0.2s ease; }
.card-fav-btn:hover { transform:scale(1.05);background:rgba(15,23,42,0.45); }
.card-fav-btn.loading { opacity:0.65;pointer-events:none; }
.card-fav-btn.active { background:#fff1f2;border-color:#fecaca;color:#e11d48; }

.favorites-filter-btn { border:1px solid #dbe7fb;background:#fff;color:#334155;border-radius:999px;padding:8px 14px;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:6px; }
.favorites-filter-btn.active { background:#eff6ff;border-color:#93c5fd;color:#1d4ed8; }

.catalog-title-row { display:flex;align-items:center;justify-content:space-between;gap:12px; }

.advisor-btn { border:none;border-radius:999px;padding:10px 18px;font-size:14px;font-weight:700;color:#ffffff;background:linear-gradient(135deg,#0ea5e9,#2563eb);box-shadow:0 10px 20px rgba(37,99,235,0.25);display:inline-flex;align-items:center;gap:8px; }
.advisor-btn:hover { transform:translateY(-1px);box-shadow:0 14px 24px rgba(37,99,235,0.33); }

/* Bannière de filtrage advisor */
.advisor-active-banner {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #eff6ff;
    border: 1px solid #93c5fd;
    border-radius: 12px;
    padding: 10px 16px;
    margin-bottom: 16px;
    font-size: 13px;
    color: #1d4ed8;
}
.advisor-active-banner.show { display: flex; }
.advisor-active-banner strong { font-weight: 700; }
.advisor-reset-btn {
    border: 1px solid #93c5fd;
    background: #fff;
    color: #1d4ed8;
    border-radius: 999px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    transition: background 0.15s;
}
.advisor-reset-btn:hover { background: #dbeafe; }

.advisor-overlay { position:fixed;inset:0;background:rgba(15,23,42,0.58);display:none;align-items:center;justify-content:center;z-index:12000;padding:16px; }
.advisor-overlay.show { display: flex; }
.advisor-modal { width:min(560px,100%);background:#ffffff;border-radius:16px;border:1px solid #dce7fb;box-shadow:0 24px 60px rgba(2,6,23,0.28);overflow:hidden; }
.advisor-head { padding:14px 18px;border-bottom:1px solid #edf2fb;background:linear-gradient(135deg,#eff6ff,#f8fbff); }
.advisor-head h4 { font-size:16px;margin:0; }
.advisor-body { padding:16px 18px 8px; }
.advisor-progress { font-size:12px;font-weight:700;color:#64748b;margin-bottom:10px; }
.advisor-question { font-size:17px;font-weight:700;color:#0f172a;margin-bottom:12px; }
.advisor-options { display:grid;gap:8px; }
.advisor-option { width:100%;text-align:left;border:1px solid #d8e4fb;border-radius:12px;background:#f8fbff;color:#1e293b;padding:10px 12px;font-weight:600; }
.advisor-option:hover,.advisor-option.active { border-color:#3b82f6;background:#eff6ff; }
.advisor-result { margin-top:12px;border:1px solid #e2e8f0;background:#f8fafc;border-radius:12px;padding:12px;font-size:14px;color:#334155;display:none; }
.advisor-result.show { display: block; }
.advisor-foot { padding:14px 18px 18px;display:flex;gap:8px;justify-content:flex-end; }
.advisor-btn-secondary { border:1px solid #cbd5e1;background:#ffffff;color:#334155;border-radius:999px;padding:8px 14px;font-weight:700; }
.advisor-btn-primary { border:none;background:linear-gradient(135deg,#2f80ed,#2563eb);color:#fff;border-radius:999px;padding:8px 14px;font-weight:700; }

.pagination-wrap { display:flex;justify-content:center;align-items:center;gap:8px;margin-top:24px;flex-wrap:wrap; }
.pagination-link { min-width:36px;height:36px;padding:0 10px;border:1px solid #dbe7fb;border-radius:999px;background:#fff;color:#334155;font-size:13px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;justify-content:center; }
.pagination-link:hover { border-color:#93c5fd;color:#1d4ed8; }
.pagination-link.active { background:#eff6ff;border-color:#93c5fd;color:#1d4ed8; }
@media (max-width:1399px) {
    .formations-layout { grid-template-columns: 230px minmax(0, 860px) 230px; gap:20px; }
}
@media (max-width:1199px) {
    .formations-layout { grid-template-columns: 1fr; }
    .news-panel, .suggestions-panel { position:static; margin-bottom:20px; }
}
@media (max-width:768px) {
    .catalog-title-row { flex-direction:column;align-items:flex-start; }
    .catalog-panel #formationsGrid .card-footer-custom { flex-direction:column;align-items:flex-start; }
}
</style>
{% endblock %}

{% block body %}

<section class="page-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-content">
                    <h1>Formations disponibles</h1>
                    <p>Explorez notre catalogue et inscrivez-vous aux formations qui vous intéressent.</p>
                </div>
            </div>
            <div class="col-lg-4 text-end">
                <a href="{{ path('app_utilisateur_mes_participations') }}" class="btn-outline-custom" style="color:#fff; border-color: rgba(255,255,255,0.4);">
                    <i class="lni lni-list"></i> Mes inscriptions
                </a>
            </div>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">

        {% for message in app.flashes('success') %}
            <div class="alert-custom alert-success-custom">
                <i class="lni lni-checkmark-circle"></i> {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('warning') %}
            <div class="alert-custom alert-warning-custom">
                <i class="lni lni-warning"></i> {{ message }}
            </div>
        {% endfor %}

    </div>

    <div class="container-fluid px-4">
        <div class="formations-layout">

            {# GAUCHE — News #}
            <aside class="news-panel">
                <div class="news-card">
                    <div class="news-card-head">
                        <div class="news-card-head-icon icon-news">&#9889;</div>
                        <div class="news-card-head-text">
                            <h3>News Tech</h3>
                            <p>Les tendances du moment pour mieux choisir votre parcours.</p>
                        </div>
                    </div>
                    {% if techNews is defined and techNews is not empty %}
                        <div class="news-list">
                            {% for news in techNews %}
                                <a href="{{ news.url }}" target="_blank" rel="noopener noreferrer" class="news-item">
                                    <span class="news-item-rank">#{{ loop.index }}{% if loop.first %} Trending{% endif %}</span>
                                    <p class="news-item-title">{{ news.title }}</p>
                                    <div class="news-item-footer">
                                        <div class="news-item-meta">
                                            <span class="news-source-badge">{{ news.source }}</span>
                                            {% if news.points is defined and news.points > 0 %}
                                                <span class="news-pts-badge">{{ news.points }} pts</span>
                                            {% endif %}
                                        </div>
                                        {% if news.publishedAt is defined and news.publishedAt %}
                                            <span class="news-date">{{ news.publishedAt|date('d/m H:i') }}</span>
                                        {% endif %}
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state"><p>Aucune news disponible pour le moment.</p></div>
                    {% endif %}
                </div>
            </aside>

            {# CENTRE — Catalogue #}
            <div class="catalog-panel">
                <div class="section-title">
                    <div class="catalog-title-row">
                        <h2>Catalogue des Formations</h2>
                        <button type="button" class="advisor-btn" id="openAdvisorBtn">
                            <i class="lni lni-comments-alt"></i> Aide-moi à choisir
                        </button>
                    </div>
                    <p>{{ formations.getTotalItemCount }} formation(s) disponible(s)</p>
                    <div class="title-line"></div>
                </div>

                {% if formationEnCours is defined and formationEnCours is not null %}
                <div class="alerte-progression-banner" id="alerteProgressionBanner">
                    <div class="alerte-prog-left">
                        <div class="alerte-prog-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        </div>
                        <div class="alerte-prog-text">
                            <strong>Reprends là où tu t'es arrêté !</strong>
                            <span>{{ formationEnCours.titre }} — vous êtes déjà inscrit.</span>
                        </div>
                    </div>
                    <div class="alerte-prog-right">
                        <a href="{{ path('app_utilisateur_formation_show', {id: formationEnCours.idFormation}) }}" class="alerte-prog-btn">
                            Continuer <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                        <button type="button" class="alerte-prog-close" onclick="document.getElementById('alerteProgressionBanner').style.display='none'" title="Fermer">×</button>
                    </div>
                </div>
                {% endif %}

                {% if formations is empty %}
                    <div class="formation-table-wrapper">
                        <div class="empty-state">
                            <div class="empty-icon"><i class="lni lni-book"></i></div>
                            <h5>Aucune formation disponible</h5>
                            <p>Revenez plus tard, de nouvelles formations seront bientôt disponibles.</p>
                        </div>
                    </div>
                {% else %}
                    <div class="advisor-active-banner" id="advisorBanner">
                        <span id="advisorBannerText"><strong>Recommandation IA :</strong> filtrage actif</span>
                        <button type="button" class="advisor-reset-btn" id="advisorResetBtn">
                            <i class="lni lni-close"></i> Voir toutes les formations
                        </button>
                    </div>

                    <div class="search-filter-bar">
                        <div class="search-box">
                            <i class="lni lni-search-alt"></i>
                            <input type="text" id="searchInput" placeholder="Rechercher une formation..." class="form-control-custom">
                        </div>
                        <div class="filter-group">
                            <button type="button" id="favoritesOnlyBtn" class="favorites-filter-btn">
                                <i class="lni lni-heart"></i> Mes favoris
                            </button>
                            <div class="custom-select-wrapper">
                                <div class="custom-select-trigger" onclick="toggleDropdown('domaine')">
                                    <span id="domaine-label">Tous les domaines</span>
                                    <i class="lni lni-chevron-down"></i>
                                </div>
                                <div class="custom-select-dropdown" id="dropdown-domaine">
                                    <div class="custom-option selected" onclick="selectOption('domaine', '', 'Tous les domaines')">Tous les domaines</div>
                                    {% set domaines = [] %}
                                    {% for formation in formations %}
                                        {% if formation.domaine and formation.domaine not in domaines %}
                                            {% set domaines = domaines|merge([formation.domaine]) %}
                                            <div class="custom-option" onclick="selectOption('domaine', '{{ formation.domaine|lower }}', '{{ formation.domaine }}')">{{ formation.domaine }}</div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="custom-select-wrapper">
                                <div class="custom-select-trigger" onclick="toggleDropdown('niveau')">
                                    <span id="niveau-label">Tous les niveaux</span>
                                    <i class="lni lni-chevron-down"></i>
                                </div>
                                <div class="custom-select-dropdown" id="dropdown-niveau">
                                    <div class="custom-option selected" onclick="selectOption('niveau', '', 'Tous les niveaux')">Tous les niveaux</div>
                                    <div class="custom-option" onclick="selectOption('niveau', 'débutant', 'Débutant')">Débutant</div>
                                    <div class="custom-option" onclick="selectOption('niveau', 'intermédiaire', 'Intermédiaire')">Intermédiaire</div>
                                    <div class="custom-option" onclick="selectOption('niveau', 'avancé', 'Avancé')">Avancé</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4" id="formationsGrid">
                        {% for formation in formations %}
                        <div class="col-lg-4 col-md-6 formation-col">
                            <div class="formation-card formation-item"
                                 data-titre="{{ formation.titre|lower }}"
                                 data-domaine="{{ formation.domaine|lower }}"
                                 data-niveau="{{ formation.niveau|lower }}"
                                 data-fav="{{ formation.idFormation in (favoriIds|default([])) ? '1' : '0' }}">
                                <form method="post"
                                      action="{{ path('app_utilisateur_favori_toggle', {id: formation.idFormation}) }}"
                                      class="favorite-form card-fav-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_favori_' ~ formation.idFormation) }}">
                                    <input type="hidden" name="return_route" value="list">
                                    <button type="submit"
                                            class="card-fav-btn {{ formation.idFormation in (favoriIds|default([])) ? 'active' : '' }}"
                                            title="{{ formation.idFormation in (favoriIds|default([])) ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
                                        <i class="lni lni-heart"></i>
                                    </button>
                                </form>
                                <div class="card-icon-wrapper"><i class="lni lni-graduation"></i></div>
                                <div class="card-body-custom">
                                    <h5 class="card-title-custom">{{ formation.titre }}</h5>
                                    <p class="card-desc">{{ formation.description ?? 'Aucune description disponible.' }}</p>
                                    <div class="d-flex gap-2 flex-wrap">
                                        {% if formation.domaine %}
                                            <span class="tag tag-primary"><i class="lni lni-tag"></i> {{ formation.domaine }}</span>
                                        {% endif %}
                                        {% if formation.niveau %}
                                            {% if formation.niveau == 'Débutant' %}
                                                <span class="tag tag-success">{{ formation.niveau }}</span>
                                            {% elseif formation.niveau == 'Intermédiaire' %}
                                                <span class="tag tag-warning">{{ formation.niveau }}</span>
                                            {% else %}
                                                <span class="tag tag-dark">{{ formation.niveau }}</span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="card-footer-custom">
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <span class="tag tag-dark"><i class="lni lni-users"></i> {{ formation.participations|length }} inscrits</span>
                                        {% if formation.idFormation in inscritIds %}
                                            <span class="tag tag-success"><i class="lni lni-checkmark-circle"></i> Inscrit</span>
                                        {% endif %}
                                    </div>
                                    <a href="{{ path('app_utilisateur_formation_show', {id: formation.idFormation}) }}"
                                       class="btn-outline-custom" style="padding:8px 18px;font-size:13px;">
                                        Voir détails <i class="lni lni-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    <div id="noResults" style="display:none;">
                        <div class="formation-table-wrapper">
                            <div class="empty-state">
                                <div class="empty-icon"><i class="lni lni-search-alt"></i></div>
                                <h5>Aucun résultat</h5>
                                <p>Aucune formation ne correspond à votre recherche.</p>
                            </div>
                        </div>
                    </div>

                    {% set paginationData = formations.getPaginationData %}
                    {% if paginationData.pageCount >= 1 %}
                        <nav class="pagination-wrap" aria-label="Pagination formations">
                            {% if paginationData.previous is defined %}
                                <a class="pagination-link" href="{{ path('app_utilisateur_formations', app.request.query.all|merge({'page': paginationData.previous})) }}">
                                    <i class="lni lni-chevron-left"></i>
                                </a>
                            {% endif %}
                            {% for page in paginationData.pagesInRange %}
                                <a class="pagination-link {{ page == paginationData.current ? 'active' : '' }}"
                                   href="{{ path('app_utilisateur_formations', app.request.query.all|merge({'page': page})) }}">{{ page }}</a>
                            {% endfor %}
                            {% if paginationData.next is defined %}
                                <a class="pagination-link" href="{{ path('app_utilisateur_formations', app.request.query.all|merge({'page': paginationData.next})) }}">
                                    <i class="lni lni-chevron-right"></i>
                                </a>
                            {% endif %}
                        </nav>
                    {% endif %}
                {% endif %}
            </div>

            {# DROITE — Suggestions #}
            <aside class="suggestions-panel">
                <div class="news-card suggestions-card">
                    <div class="news-card-head">
                        <div class="news-card-head-icon icon-suggest">&#128161;</div>
                        <div class="news-card-head-text">
                            <h3>Suggestions pour vous</h3>
                            <p>Basées sur vos participations et vos favoris.</p>
                        </div>
                    </div>
                    {% if suggestedFormations is defined and suggestedFormations is not empty %}
                        <div class="suggestions-list">
                            {% for formation in suggestedFormations %}
                                <a href="{{ path('app_utilisateur_formation_show', {id: formation.idFormation}) }}" class="suggestion-item">
                                    <div class="suggestion-avatar">{{ formation.domaine|default('?')|slice(0,2)|upper }}</div>
                                    <div class="suggestion-content">
                                        <p class="suggestion-title">{{ formation.titre }}</p>
                                        <div class="suggestion-meta">
                                            {% if formation.domaine %}<span class="suggestion-tag">{{ formation.domaine }}</span>{% endif %}
                                            {% if formation.idFormation in (favoriIds|default([])) %}<span class="suggestion-tag favori">Favori</span>{% endif %}
                                        </div>
                                    </div>
                                    <svg class="suggestion-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                        <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state"><p>Aucune suggestion pour le moment.</p></div>
                    {% endif %}
                </div>
            </aside>

        </div>
    </div>
</div>

{# Modal advisor #}
<div class="advisor-overlay" id="advisorOverlay" aria-hidden="true">
    <div class="advisor-modal" role="dialog" aria-modal="true" aria-labelledby="advisorTitle">
        <div class="advisor-head"><h4 id="advisorTitle">Assistant de choix</h4></div>
        <div class="advisor-body">
            <div class="advisor-progress" id="advisorProgress">Question 1 / 4</div>
            <div class="advisor-question" id="advisorQuestion"></div>
            <div class="advisor-options" id="advisorOptions"></div>
            <div class="advisor-result" id="advisorResult"></div>
        </div>
        <div class="advisor-foot">
            <button type="button" class="advisor-btn-secondary" id="advisorCloseBtn">Fermer</button>
            <button type="button" class="advisor-btn-primary" id="advisorNextBtn" disabled>Suivant</button>
        </div>
    </div>
</div>

<script>
let activeFilters   = { domaine: '', niveau: '' };
let advisorFilters  = { domaine: '', niveau: '' }; // filtres posés par l'advisor (séparés)
let showOnlyFavorites = false;
const advisorEndpoint = "{{ path('app_utilisateur_aide_choix') }}";

// -------------------------------------------------------------------
// Dropdowns manuels
// -------------------------------------------------------------------
function toggleDropdown(type) {
    const dropdown = document.getElementById('dropdown-' + type);
    const trigger  = dropdown.previousElementSibling;
    const isOpen   = dropdown.classList.contains('open');
    document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('open'));
    document.querySelectorAll('.custom-select-trigger').forEach(t => t.classList.remove('open'));
    if (!isOpen) { dropdown.classList.add('open'); trigger.classList.add('open'); }
}

function selectOption(type, value, label) {
    activeFilters[type] = value;
    document.getElementById(type + '-label').textContent = label;
    document.querySelectorAll('#dropdown-' + type + ' .custom-option').forEach(opt => opt.classList.remove('selected'));
    event.target.classList.add('selected');
    document.getElementById('dropdown-' + type).classList.remove('open');
    document.getElementById('dropdown-' + type).previousElementSibling.classList.remove('open');
    // Si l'utilisateur change les filtres manuellement, désactiver l'advisor
    resetAdvisorFilters(false);
    filterCards();
}

document.addEventListener('click', function(e) {
    if (!e.target.closest('.custom-select-wrapper')) {
        document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('open'));
        document.querySelectorAll('.custom-select-trigger').forEach(t => t.classList.remove('open'));
    }
});

// -------------------------------------------------------------------
// Filtrage des cartes
// -------------------------------------------------------------------
const searchInput     = document.getElementById('searchInput');
const noResults       = document.getElementById('noResults');
const favoritesOnlyBtn = document.getElementById('favoritesOnlyBtn');
const advisorBanner   = document.getElementById('advisorBanner');
const advisorBannerText = document.getElementById('advisorBannerText');
const advisorResetBtn = document.getElementById('advisorResetBtn');

function filterCards() {
    const search  = searchInput ? searchInput.value.toLowerCase() : '';
    // Combiner filtres manuels + filtres advisor (advisor en priorité s'il est actif)
    const domaine = advisorFilters.domaine || activeFilters.domaine;
    const niveau  = advisorFilters.niveau  || activeFilters.niveau;
    let visible = 0;

    document.querySelectorAll('.formation-col').forEach(col => {
        const card       = col.querySelector('.formation-item');
        const titre      = card.dataset.titre;
        const cardDomaine = card.dataset.domaine;
        const cardNiveau  = card.dataset.niveau;
        const isFav      = card.dataset.fav === '1';

        const matchSearch  = titre.includes(search);
        const matchDomaine = domaine === '' || cardDomaine === domaine;
        const matchNiveau  = niveau  === '' || cardNiveau  === niveau;
        const matchFav     = !showOnlyFavorites || isFav;

        if (matchSearch && matchDomaine && matchNiveau && matchFav) {
            col.style.display = '';
            visible++;
        } else {
            col.style.display = 'none';
        }
    });

    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
}

function resetAdvisorFilters(showBanner) {
    advisorFilters.domaine = '';
    advisorFilters.niveau  = '';
    if (advisorBanner) advisorBanner.classList.remove('show');
}

if (searchInput) searchInput.addEventListener('input', filterCards);

if (favoritesOnlyBtn) {
    favoritesOnlyBtn.addEventListener('click', () => {
        showOnlyFavorites = !showOnlyFavorites;
        favoritesOnlyBtn.classList.toggle('active', showOnlyFavorites);
        filterCards();
    });
}

if (advisorResetBtn) {
    advisorResetBtn.addEventListener('click', () => {
        resetAdvisorFilters(false);
        filterCards();
    });
}

// -------------------------------------------------------------------
// Favoris AJAX
// -------------------------------------------------------------------
document.querySelectorAll('.favorite-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('.card-fav-btn');
        if (!btn) { form.submit(); return; }
        btn.classList.add('loading');
        try {
            const response = await fetch(form.action, {
                method: 'POST', body: new FormData(form), credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const data    = await response.json();
            const isFavori = !!data.isFavori;
            btn.classList.toggle('active', isFavori);
            btn.title = isFavori ? 'Retirer des favoris' : 'Ajouter aux favoris';
            const card = form.closest('.formation-item');
            if (card) card.dataset.fav = isFavori ? '1' : '0';
            filterCards();
        } catch (err) { form.submit(); }
        finally { btn.classList.remove('loading'); }
    });
});

// -------------------------------------------------------------------
// Advisor modal
// -------------------------------------------------------------------
const advisorSteps = [
    { id:'q1', question:'Quel domaine vous attire le plus ?',
      options:['IA / Data','Développement Web','Réseaux / Cybersécurité','Gestion de projet / Soft Skills'] },
    { id:'q2', question:'Quel est votre niveau actuel ?',
      options:['Débutant','Intermédiaire','Avancé'] },
    { id:'q3', question:'Quel est votre objectif principal ?',
      options:['Trouver un emploi','Monter en compétences','Préparer une certification','Créer un projet perso'] },
    { id:'q4', question:'Combien de temps avez-vous par semaine ?',
      options:['Peu (moins de 3h)','Moyen (3h à 6h)','Élevé (plus de 6h)'] }
];

const advisorOverlay  = document.getElementById('advisorOverlay');
const openAdvisorBtn  = document.getElementById('openAdvisorBtn');
const advisorCloseBtn = document.getElementById('advisorCloseBtn');
const advisorQuestion = document.getElementById('advisorQuestion');
const advisorOptions  = document.getElementById('advisorOptions');
const advisorProgress = document.getElementById('advisorProgress');
const advisorNextBtn  = document.getElementById('advisorNextBtn');
const advisorResult   = document.getElementById('advisorResult');

let advisorIndex = 0, advisorAnswers = {}, advisorCurrentChoice = '';

function openAdvisor() {
    advisorOverlay.classList.add('show');
    advisorOverlay.setAttribute('aria-hidden', 'false');
    advisorIndex = 0; advisorAnswers = {}; advisorCurrentChoice = '';
    advisorNextBtn.onclick = null;
    advisorResult.classList.remove('show');
    advisorResult.textContent = '';
    renderAdvisorStep();
}
function closeAdvisor() {
    advisorOverlay.classList.remove('show');
    advisorOverlay.setAttribute('aria-hidden', 'true');
}
function renderAdvisorStep() {
    const step = advisorSteps[advisorIndex];
    advisorProgress.textContent = `Question ${advisorIndex + 1} / ${advisorSteps.length}`;
    advisorQuestion.textContent = step.question;
    advisorNextBtn.disabled = true;
    advisorNextBtn.textContent = advisorIndex === advisorSteps.length - 1 ? 'Obtenir la recommandation' : 'Suivant';
    advisorOptions.innerHTML = '';
    step.options.forEach((optionText) => {
        const btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'advisor-option'; btn.textContent = optionText;
        btn.addEventListener('click', () => {
            advisorCurrentChoice = optionText;
            advisorOptions.querySelectorAll('.advisor-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            advisorNextBtn.disabled = false;
        });
        advisorOptions.appendChild(btn);
    });
}

async function requestAdvisor() {
    advisorNextBtn.disabled = true;
    advisorNextBtn.textContent = 'Analyse...';
    try {
        const res  = await fetch(advisorEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(advisorAnswers),
            credentials: 'same-origin'
        });
        const data = await res.json();

        const domaine = String(data?.filters?.domaine || '');
        const niveau  = String(data?.filters?.niveau  || '');
        const advice  = String(data?.advice || 'Recommandation appliquée.');

        // Stocker dans les filtres advisor (indépendants des dropdowns)
        advisorFilters.domaine = domaine;
        advisorFilters.niveau  = niveau;

        // Filtrer les cartes directement — sans toucher ni la barre de recherche ni les dropdowns
        filterCards();

        // Afficher la bannière avec le conseil et le bouton reset
        if (advisorBanner) {
            advisorBannerText.innerHTML = '<strong>Recommandation IA :</strong> ' + advice;
            advisorBanner.classList.add('show');
        }

        // Résultat dans la modale
        advisorResult.innerHTML = '<strong>Conseil :</strong> ' + advice;
        advisorResult.classList.add('show');
        advisorOptions.innerHTML = '';
        advisorQuestion.textContent = 'Filtres appliqués — les formations correspondantes sont affichées.';
        advisorProgress.textContent = 'Terminé';
        advisorNextBtn.textContent  = 'Fermer';
        advisorNextBtn.disabled     = false;
        advisorNextBtn.onclick      = closeAdvisor;

    } catch (e) {
        advisorResult.innerHTML = 'Impossible de récupérer la recommandation. Réessayez.';
        advisorResult.classList.add('show');
        advisorNextBtn.disabled     = false;
        advisorNextBtn.textContent  = 'Réessayer';
    }
}

if (openAdvisorBtn)  openAdvisorBtn.addEventListener('click', openAdvisor);
if (advisorCloseBtn) advisorCloseBtn.addEventListener('click', closeAdvisor);
if (advisorOverlay)  advisorOverlay.addEventListener('click', e => { if (e.target === advisorOverlay) closeAdvisor(); });
if (advisorNextBtn) {
    advisorNextBtn.addEventListener('click', async () => {
        const step = advisorSteps[advisorIndex];
        if (!advisorCurrentChoice || !step) return;
        advisorAnswers[step.id] = advisorCurrentChoice;
        advisorCurrentChoice = '';
        if (advisorIndex < advisorSteps.length - 1) { advisorIndex++; renderAdvisorStep(); return; }
        await requestAdvisor();
    });
}
</script>

{% endblock %}
