{% extends 'base.html.twig' %}

{% block title %}Demandes{% endblock %}

{% block body %}
<section class="demandes-v2-page">
    <div class="container">

        <div class="demandes-v2-header">
            <div>
                <span class="demandes-v2-badge">Back Office</span>
                <h1>Demandes pour : {{ projet.titre }}</h1>
                <p>Gestion des candidatures de participation</p>
            </div>

            <a href="{{ path('app_back_projets') }}" class="demandes-v2-return">
                ← Retour aux projets
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="demandes-v2-alert success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="demandes-v2-alert danger">{{ message }}</div>
        {% endfor %}

        <div class="demandes-v2-grid">
            {% for d in demandes %}
                {% set etat = d.etat|upper %}

                <article class="demande-v2-card">
                    <div class="demande-v2-top">
                        <div class="demande-v2-icon">📩</div>

                        <div class="demande-v2-head-content">
                            <h3>Demande #{{ d.id }}</h3>
                            <p>Projet concerné : <strong>{{ projet.titre }}</strong></p>
                        </div>

                        <div class="demande-v2-status
                            {% if etat == 'ACCEPTEE' %}status-success
                            {% elseif etat == 'REFUSEE' %}status-danger
                            {% else %}status-warning{% endif %}
                        ">
                            {% if etat == 'ACCEPTEE' %}
                                Acceptée
                            {% elseif etat == 'REFUSEE' %}
                                Refusée
                            {% else %}
                                En attente
                            {% endif %}
                        </div>
                    </div>

                    <div class="demande-v2-body">
                        <div class="demande-v2-info-box">
                            <span>Référence</span>
                            <strong>#{{ d.id }}</strong>
                        </div>

                        <div class="demande-v2-info-box">
                            <span>Projet</span>
                            <strong>{{ projet.titre }}</strong>
                        </div>
                    </div>

                    {% if etat == 'EN_ATTENTE' %}
                        <div class="demande-v2-actions">
                            <a href="{{ path('app_back_demande_accept', {id: d.id}) }}" class="btn-v2 btn-v2-accept">
                                ✔ Accepter
                            </a>

                            <a href="{{ path('app_back_demande_refuse', {id: d.id}) }}" class="btn-v2 btn-v2-refuse">
                                ✖ Refuser
                            </a>
                        </div>
                    {% elseif etat == 'ACCEPTEE' %}
                        <div class="demande-v2-result accepted-box">
                            <div class="result-icon">✔</div>
                            <div>
                                <strong>Demande acceptée</strong>
                                <p>Cette candidature a déjà été validée.</p>
                            </div>
                        </div>
                    {% elseif etat == 'REFUSEE' %}
                        <div class="demande-v2-result refused-box">
                            <div class="result-icon">✖</div>
                            <div>
                                <strong>Demande refusée</strong>
                                <p>Cette candidature a déjà été refusée.</p>
                            </div>
                        </div>
                    {% endif %}
                </article>
            {% else %}
                <div class="demandes-v2-empty">
                    <div class="empty-icon">📭</div>
                    <h3>Aucune demande</h3>
                    <p>Il n’y a encore aucune candidature pour ce projet.</p>
                    <a href="{{ path('app_back_projets') }}" class="demandes-v2-return inline-back">
                        ← Retour aux projets
                    </a>
                </div>
            {% endfor %}
        </div>

    </div>
</section>
{% endblock %}