{% extends 'base_projet.html.twig' %}

{% block title %}Demandes{% endblock %}

{% block body %}
<style>
    .demandes-page {
        padding: 20px 0 40px;
        background: linear-gradient(180deg, #eef3fb 0%, #f8fbff 100%);
        border-radius: 24px;
    }

    .demandes-header {
        background: linear-gradient(135deg, #1d2f7a 0%, #2d3f95 100%);
        border-radius: 28px;
        padding: 28px 30px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        box-shadow: 0 16px 40px rgba(34, 54, 116, 0.16);
        margin-bottom: 22px;
    }

    .demandes-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .demandes-header h1 {
        margin: 0 0 5px;
        font-size: 36px;
        line-height: 1.1;
        font-weight: 900;
        color: #fff;
    }

    .demandes-header p {
        margin: 0;
        font-size: 16px;
        color: rgba(255, 255, 255, 0.88);
    }

    .demandes-return {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: #f4f7ff;
        color: #19306e;
        font-weight: 800;
        border-radius: 18px;
        padding: 14px 22px;
        min-width: 210px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
        transition: 0.2s ease;
    }

    .demandes-return:hover {
        transform: translateY(-2px);
        text-decoration: none;
        color: #19306e;
    }

    .demandes-alert {
        margin-bottom: 14px;
        border-radius: 14px;
        padding: 12px 16px;
        font-weight: 700;
    }

    .demandes-alert.success {
        background: #e9fff1;
        color: #14804a;
        border: 1px solid #bdeccf;
    }

    .demandes-alert.danger {
        background: #fff1f1;
        color: #b42318;
        border: 1px solid #f3c4c4;
    }

    .comparison-panel {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #dfebfb;
        box-shadow: 0 10px 26px rgba(16, 36, 82, 0.08);
        padding: 16px;
        margin-bottom: 14px;
    }

    .comparison-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .comparison-title {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #112a69;
    }

    .comparison-sub {
        margin: 3px 0 0;
        font-size: 13px;
        color: #6a7f9f;
        font-weight: 700;
    }

    .comparison-top-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 8px 14px;
        background: linear-gradient(135deg, #1f5eff 0%, #1dbf9f 100%);
        color: #fff;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 12px;
    }

    .comparison-card {
        border-radius: 14px;
        background: #f6f9ff;
        border: 1px solid #dce9fb;
        padding: 12px;
    }

    .comparison-card h4 {
        margin: 0 0 8px;
        font-size: 15px;
        color: #17326f;
        font-weight: 900;
    }

    .top-candidate-name {
        font-size: 20px;
        font-weight: 900;
        color: #0f2a66;
        margin-bottom: 4px;
    }

    .top-candidate-meta {
        color: #5f7393;
        font-size: 13px;
        margin-bottom: 8px;
        word-break: break-word;
    }

    .top-candidate-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .metric-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 900;
        background: #eaf1ff;
        color: #17326f;
    }

    .metric-chip.main {
        background: #e8fff7;
        color: #0f7a4a;
    }

    .comparison-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .comparison-row {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 8px;
        align-items: center;
        padding: 8px 10px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #e2ecfc;
        font-size: 12px;
    }

    .comparison-rank {
        width: 24px;
        height: 24px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        background: #eaf1ff;
        color: #17326f;
    }

    .comparison-name {
        color: #14306c;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .comparison-score {
        color: #0f7a4a;
        font-weight: 900;
    }

    .demandes-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .demande-compact {
        display: grid;
        grid-template-columns: 240px minmax(260px, 1fr) auto;
        align-items: center;
        gap: 16px;
        padding: 16px 18px;
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e4ecf7;
        box-shadow: 0 8px 24px rgba(16, 36, 82, 0.06);
    }

    .compact-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .compact-avatar {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #3c82f6 0%, #2cc58a 100%);
        color: #fff;
        font-size: 16px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(38, 120, 255, 0.18);
    }

    .compact-info {
        min-width: 0;
    }

    .compact-info strong {
        display: block;
        font-size: 16px;
        color: #0b225d;
        line-height: 1.2;
        font-weight: 900;
        margin-bottom: 2px;
        word-break: break-word;
    }

    .compact-info span {
        display: block;
        font-size: 12px;
        color: #7284a0;
        word-break: break-word;
    }

    .compact-middle {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .mini-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #eef3ff;
        color: #17326f;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
    }

    .mini-badge.role {
        background: #eef3ff;
        color: #17326f;
    }

    .mini-badge.dispo {
        background: #ecfff5;
        color: #157347;
    }

    .mini-badge.ref {
        background: #f5f7fb;
        color: #5d6f89;
    }

    .mini-badge.pref {
        background: #fff6d8;
        color: #8a5b00;
    }

    .mini-badge.badge-level {
        background: #e8f0ff;
        color: #1d3f9c;
    }

    .mini-badge.signed {
        background: #e9fff2;
        color: #157347;
    }

    .mini-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        background: #17326f;
        color: #fff;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        transition: 0.2s ease;
    }

    .mini-link:hover {
        text-decoration: none;
        color: #fff;
        background: #112754;
        transform: translateY(-1px);
    }

    .compact-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 95px;
        padding: 7px 11px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 12px;
        line-height: 1;
    }

    .status-pill.ok {
        background: #e6faed;
        color: #15803d;
    }

    .status-pill.no {
        background: #fdecec;
        color: #c62828;
    }

    .status-pill.wait {
        background: #fff4d6;
        color: #9a6700;
    }

    .btn-mini {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 10px;
        padding: 7px 11px;
        font-size: 12px;
        font-weight: 900;
        transition: 0.2s ease;
        line-height: 1;
    }

    .btn-mini:hover {
        text-decoration: none;
        transform: translateY(-1px);
    }

    .btn-mini.ok {
        background: #e6faed;
        color: #15803d;
        border: 1px solid #b4e5c7;
    }

    .btn-mini.no {
        background: #fdecec;
        color: #c62828;
        border: 1px solid #f3c3c3;
    }

    .btn-mini.contract {
        background: #e8f0ff;
        color: #1d4ed8;
        border: 1px solid #bfd3ff;
    }

    .score-trigger {
        border: 0;
        cursor: pointer;
        min-width: 128px;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.15);
    }

    .score-excellent {
        color: #0f6d3e;
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        border: 1px solid #9ce0b4;
    }

    .score-moyen {
        color: #9a6700;
        background: linear-gradient(135deg, #fff7dc, #ffe9b5);
        border: 1px solid #f4d58d;
    }

    .score-risque {
        color: #b42318;
        background: linear-gradient(135deg, #ffe4e6, #fecdd3);
        border: 1px solid #f7b1bb;
    }

    .motivation-box {
        grid-column: 1 / -1;
        margin-top: -2px;
        padding: 12px 14px;
        border-radius: 14px;
        background: #f8fbff;
        border: 1px solid #e2ebf9;
        color: #4b617f;
        font-size: 13px;
        line-height: 1.6;
    }

    .motivation-box strong {
        display: inline-block;
        margin-bottom: 6px;
        color: #17326f;
        font-size: 13px;
    }

    .empty-value {
        color: #8a9bb3;
        font-style: italic;
    }

    .demandes-empty {
        background: #fff;
        border-radius: 24px;
        padding: 40px 24px;
        text-align: center;
        border: 1px solid #e7edf9;
        box-shadow: 0 16px 40px rgba(15, 34, 83, 0.07);
    }

    .demandes-empty .empty-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .inline-back {
        margin-top: 14px;
        display: inline-flex;
    }

    .score-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(8, 18, 44, 0.66);
        backdrop-filter: blur(3px);
        z-index: 12000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
    }

    .score-modal {
        width: min(980px, 100%);
        max-height: 88vh;
        overflow-y: auto;
        border-radius: 24px;
        background: linear-gradient(180deg, #f7faff 0%, #eef3ff 100%);
        border: 1px solid #dce7fb;
        box-shadow: 0 30px 70px rgba(7, 25, 73, 0.38);
    }

    .score-modal-header {
        background: linear-gradient(135deg, #0d1f5f 0%, #1d3f9c 100%);
        color: #fff;
        border-radius: 24px 24px 0 0;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .score-modal-header h3 {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
    }

    .score-close {
        border: 0;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        font-size: 22px;
        line-height: 1;
        font-weight: 800;
        cursor: pointer;
    }

    .score-modal-body {
        padding: 20px;
    }

    .score-top {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        align-items: center;
        margin-bottom: 16px;
    }

    .score-candidat {
        font-size: 32px;
        font-weight: 900;
        color: #0f2a66;
        margin-bottom: 6px;
    }

    .score-sub {
        color: #617798;
        font-size: 18px;
        font-weight: 600;
    }

    .score-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 9px 14px;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.4px;
    }

    .score-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr 1.2fr;
        gap: 14px;
        margin-top: 12px;
    }

    .score-card {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid #d8e4fb;
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 10px 24px rgba(17, 42, 98, 0.08);
    }

    .score-card h4 {
        margin: 0 0 10px;
        color: #0f2a66;
        font-size: 20px;
        font-weight: 900;
    }

    .score-list {
        margin: 0;
        padding-left: 18px;
        color: #2f4768;
        font-size: 15px;
        line-height: 1.7;
    }

    .score-ring-wrap {
        text-align: center;
    }

    .score-ring-title {
        margin-bottom: 12px;
        font-size: 20px;
        color: #0f2a66;
        font-weight: 900;
    }

    .score-ring {
        width: 170px;
        height: 170px;
        margin: 0 auto;
        border-radius: 50%;
        display: grid;
        place-items: center;
        transition: background 0.25s ease;
    }

    .score-ring-inner {
        width: 128px;
        height: 128px;
        border-radius: 50%;
        background: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 0 1px #e2e8f8;
    }

    .score-value {
        font-size: 52px;
        font-weight: 900;
        line-height: 1;
        color: #0f2a66;
    }

    .score-denom {
        color: #6b7f9f;
        font-size: 20px;
        font-weight: 700;
    }

    .score-breakdown-item {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        border-bottom: 1px dashed #d8e4fb;
        padding: 8px 0;
        color: #2f4768;
        font-size: 14px;
        font-weight: 700;
    }

    .score-breakdown-item:last-child {
        border-bottom: 0;
    }

    .score-reco {
        margin-top: 14px;
        border-radius: 12px;
        background: #f5f8ff;
        border: 1px solid #d9e6ff;
        color: #1e3a8a;
        padding: 11px 12px;
        font-size: 14px;
        font-weight: 700;
    }

    @media (max-width: 1100px) {
        .demande-compact {
            grid-template-columns: 1fr;
            align-items: flex-start;
        }

        .compact-right {
            justify-content: flex-start;
        }

        .score-grid {
            grid-template-columns: 1fr;
        }

        .comparison-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .demandes-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 22px 18px;
        }

        .demandes-header h1 {
            font-size: 28px;
        }

        .demandes-return {
            width: 100%;
            min-width: unset;
        }

        .demande-compact {
            padding: 14px;
        }

        .compact-left {
            align-items: flex-start;
        }
    }
</style>

<section class="demandes-page">
    <div class="container">

        <div class="demandes-header">
            <div>
                <span class="demandes-badge">Back Office</span>
                <h1>Demandes pour : {{ projet.titre }}</h1>
                <p>Gestion des candidatures de participation</p>
            </div>

            <a href="{{ path('app_back_projets') }}" class="demandes-return">
                ← Retour aux projets
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="demandes-alert success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="demandes-alert danger">{{ message }}</div>
        {% endfor %}

        {% if demandeComparaison.top %}
            {% set topCandidate = demandeComparaison.top %}
            <div class="comparison-panel">
                <div class="comparison-head">
                    <div>
                        <h3 class="comparison-title">Comparaison intelligente des demandes</h3>
                        <p class="comparison-sub">Priorite basee sur IA + niveau badge + contrats deja signes.</p>
                    </div>
                    <span class="comparison-top-pill">Top recommande</span>
                </div>

                <div class="comparison-grid">
                    <div class="comparison-card">
                        <h4>Candidat prioritaire</h4>
                        <div class="top-candidate-name">{{ topCandidate.candidateName }}</div>
                        <div class="top-candidate-meta">{{ topCandidate.candidateEmail ?: 'Email non disponible' }}</div>
                        <div class="top-candidate-metrics">
                            <span class="metric-chip main">Preference {{ topCandidate.preferenceScore }}/100</span>
                            <span class="metric-chip">IA {{ topCandidate.iaScore }}/100</span>
                            <span class="metric-chip">{{ topCandidate.badgeLevel }}</span>
                            <span class="metric-chip">{{ topCandidate.signedContracts }} contrat(s) signe(s)</span>
                        </div>
                    </div>

                    <div class="comparison-card">
                        <h4>Classement rapide</h4>
                        <ul class="comparison-list">
                            {% for row in demandeComparaison.ranking %}
                                <li class="comparison-row">
                                    <span class="comparison-rank">{{ loop.index }}</span>
                                    <span class="comparison-name">{{ row.candidateName }}</span>
                                    <span class="comparison-score">{{ row.preferenceScore }}/100</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="demandes-list">
            {% for d in demandes %}
                {% set etat = d.etat|upper %}
                {% set user = utilisateursParId[d.userId] ?? null %}
                {% set contrat = contratsParDemande[d.id] ?? null %}
                {% set badgeData = badgesParUserId[d.userId] ?? null %}
                {% set compareData = demandeComparaison.byDemande[d.id] ?? null %}
                {% set signedCount = signedContractsByUserId[d.userId] ?? 0 %}

                <article class="demande-compact">
                    {% set scoreData = scoresParDemande[d.id] ?? null %}

                    <div class="compact-left">
                        <div class="compact-avatar">
                            {{ user and user.nom ? user.nom|slice(0,2)|upper : '??' }}
                        </div>

                        <div class="compact-info">
                            <strong>{{ user ? user.nom : 'Utilisateur introuvable' }}</strong>
                            <span>{{ user and user.email ? user.email : 'Email non disponible' }}</span>
                        </div>
                    </div>

                    <div class="compact-middle">
                        <span class="mini-badge ref">#{{ d.id }}</span>

                        <span class="mini-badge role">
                            👤 {{ d.roleSouhaite ?: 'Rôle non renseigné' }}
                        </span>

                        <span class="mini-badge dispo">
                            🕒 {{ d.disponibilite ?: 'Disponibilité non renseignée' }}
                        </span>

                        {% if compareData %}
                            <span class="mini-badge pref">Preference {{ compareData.preferenceScore }}/100</span>
                        {% endif %}

                        <span class="mini-badge badge-level">
                            Badge: {{ badgeData.levelLabel|default('Niveau debutant') }}
                        </span>

                        <span class="mini-badge signed">
                            Contrats signes: {{ signedCount }}
                        </span>

                        {% if d.portfolio %}
                            <a href="{{ d.portfolio }}" target="_blank" class="mini-link">
                                🌐 Portfolio
                            </a>
                        {% endif %}

                        {% if etat == 'ACCEPTEE' and contrat %}
                            <a href="{{ path('app_back_contrat_show', {id: contrat.id}) }}" class="btn-mini contract">
                                {% if contrat.statut == 'SIGNE' or contrat.userSignedAt %}
                                    Contrat signe
                                {% else %}
                                    Voir contrat
                                {% endif %}
                            </a>
                        {% endif %}
                    </div>

                    <div class="compact-right">
                        <button
                            type="button"
                            class="btn-mini score-trigger score-{{ scoreData.level|default('moyen') }}"
                            data-score="{{ scoreData.score|default(0) }}"
                            data-level="{{ scoreData.level|default('moyen') }}"
                            data-level-label="{{ scoreData.levelLabel|default('A CONSIDERER') }}"
                            data-recommendation="{{ scoreData.recommendation|default('Profil a verifier.')|e('html_attr') }}"
                            data-candidat="{{ user ? user.nom : 'Candidat' }}"
                            data-role="{{ d.roleSouhaite ?: 'Non renseigne' }}"
                            data-disponibilite="{{ d.disponibilite ?: 'Non renseignee' }}"
                            data-portfolio="{{ d.portfolio ?: 'Non fourni' }}"
                            data-motivation="{{ d.motivation ?: 'Aucune motivation fournie.' }}"
                            data-highlights="{{ (scoreData.highlights|default([]))|join('||')|e('html_attr') }}"
                            data-br-role="{{ scoreData.breakdown.role|default(0) }}"
                            data-br-dispo="{{ scoreData.breakdown.disponibilite|default(0) }}"
                            data-br-portfolio="{{ scoreData.breakdown.portfolio|default(0) }}"
                            data-br-motivation="{{ scoreData.breakdown.motivation|default(0) }}"
                            data-br-profil="{{ scoreData.breakdown.profil|default(0) }}"
                        >
                            IA {{ scoreData.score|default(0) }} / 100
                        </button>

                        <span class="status-pill
                            {% if etat == 'ACCEPTEE' %}ok
                            {% elseif etat == 'REFUSEE' %}no
                            {% else %}wait{% endif %}">
                            {% if etat == 'ACCEPTEE' %}
                                Acceptée
                            {% elseif etat == 'REFUSEE' %}
                                Refusée
                            {% else %}
                                En attente
                            {% endif %}
                        </span>

                        {% if etat == 'EN_ATTENTE' %}
                            <a href="{{ path('app_back_demande_accept', {id: d.id}) }}" class="btn-mini ok">
                                ✔ Accepter
                            </a>

                            <a href="{{ path('app_back_demande_refuse', {id: d.id}) }}" class="btn-mini no">
                                ✖ Refuser
                            </a>
                        {% endif %}
                    </div>

                    <div class="motivation-box">
                        <strong>Motivation :</strong><br>
                        {% if d.motivation %}
                            {{ d.motivation|nl2br }}
                        {% else %}
                            <span class="empty-value">Aucune motivation renseignée</span>
                        {% endif %}
                    </div>

                </article>
            {% else %}
                <div class="demandes-empty">
                    <div class="empty-icon">📭</div>
                    <h3>Aucune demande</h3>
                    <p>Il n’y a encore aucune candidature pour ce projet.</p>
                    <a href="{{ path('app_back_projets') }}" class="demandes-return inline-back">
                        ← Retour aux projets
                    </a>
                </div>
            {% endfor %}
        </div>

    </div>
</section>
<div id="scoreModalBackdrop" class="score-modal-backdrop">
    <div class="score-modal" role="dialog" aria-modal="true" aria-labelledby="scoreModalTitle">
        <div class="score-modal-header">
            <h3 id="scoreModalTitle">Details IA</h3>
            <button type="button" class="score-close" id="scoreCloseBtn">×</button>
        </div>
        <div class="score-modal-body">
            <div class="score-top">
                <div>
                    <div class="score-candidat" id="scoreCandidate">Candidat</div>
                    <div class="score-sub" id="scoreRole">Role</div>
                </div>
                <span id="scoreLevelChip" class="score-chip">A CONSIDERER</span>
            </div>

            <div class="score-grid">
                <div class="score-card">
                    <h4>Resume rapide</h4>
                    <ul class="score-list" id="scoreHighlights"></ul>
                    <div class="score-reco" id="scoreRecommendation"></div>
                </div>

                <div class="score-card score-ring-wrap">
                    <div class="score-ring-title">Score IA</div>
                    <div class="score-ring" id="aiScoreRing">
                        <div class="score-ring-inner">
                            <div class="score-value" id="scoreValue">0</div>
                            <div class="score-denom">/100</div>
                        </div>
                    </div>
                </div>

                <div class="score-card">
                    <h4>Breakdown</h4>
                    <div class="score-breakdown-item"><span>Role</span><strong id="brRole">0</strong></div>
                    <div class="score-breakdown-item"><span>Disponibilite</span><strong id="brDispo">0</strong></div>
                    <div class="score-breakdown-item"><span>Portfolio</span><strong id="brPortfolio">0</strong></div>
                    <div class="score-breakdown-item"><span>Motivation</span><strong id="brMotivation">0</strong></div>
                    <div class="score-breakdown-item"><span>Profil</span><strong id="brProfil">0</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const triggers = document.querySelectorAll('.score-trigger');
    const backdrop = document.getElementById('scoreModalBackdrop');
    const closeBtn = document.getElementById('scoreCloseBtn');
    const candidate = document.getElementById('scoreCandidate');
    const role = document.getElementById('scoreRole');
    const levelChip = document.getElementById('scoreLevelChip');
    const recommendation = document.getElementById('scoreRecommendation');
    const highlights = document.getElementById('scoreHighlights');
    const ring = document.getElementById('aiScoreRing');
    const scoreValue = document.getElementById('scoreValue');
    const brRole = document.getElementById('brRole');
    const brDispo = document.getElementById('brDispo');
    const brPortfolio = document.getElementById('brPortfolio');
    const brMotivation = document.getElementById('brMotivation');
    const brProfil = document.getElementById('brProfil');

    function levelColor(level) {
        if (level === 'excellent') return '#12b76a';
        if (level === 'risque') return '#ef4444';
        return '#f59e0b';
    }

    function levelChipStyle(level) {
        if (level === 'excellent') return ['#dcfce7', '#0f7a4a'];
        if (level === 'risque') return ['#fee2e2', '#b42318'];
        return ['#fff7dc', '#9a6700'];
    }

    function openModal(btn) {
        const score = Number(btn.dataset.score || 0);
        const level = btn.dataset.level || 'moyen';
        const levelLabel = btn.dataset.levelLabel || 'A CONSIDERER';
        const scoreDeg = Math.max(0, Math.min(100, score)) * 3.6;
        const color = levelColor(level);
        const chipStyle = levelChipStyle(level);
        const listItems = (btn.dataset.highlights || '').split('||').filter(Boolean);

        candidate.textContent = btn.dataset.candidat || 'Candidat';
        role.textContent = 'Role: ' + (btn.dataset.role || 'Non renseigne');
        recommendation.textContent = btn.dataset.recommendation || 'Aucune recommandation.';
        levelChip.textContent = levelLabel;
        levelChip.style.background = chipStyle[0];
        levelChip.style.color = chipStyle[1];

        ring.style.background = 'conic-gradient(' + color + ' ' + scoreDeg + 'deg, #e8edf7 ' + scoreDeg + 'deg 360deg)';
        scoreValue.textContent = String(score);
        scoreValue.style.color = color;

        brRole.textContent = '+' + (btn.dataset.brRole || '0');
        brDispo.textContent = '+' + (btn.dataset.brDispo || '0');
        brPortfolio.textContent = '+' + (btn.dataset.brPortfolio || '0');
        brMotivation.textContent = '+' + (btn.dataset.brMotivation || '0');
        brProfil.textContent = '+' + (btn.dataset.brProfil || '0');

        highlights.innerHTML = '';
        if (listItems.length === 0) {
            const li = document.createElement('li');
            li.textContent = 'Aucun detail disponible.';
            highlights.appendChild(li);
        } else {
            listItems.forEach(function (item) {
                const li = document.createElement('li');
                li.textContent = item;
                highlights.appendChild(li);
            });
        }

        backdrop.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        backdrop.style.display = 'none';
        document.body.style.overflow = '';
    }

    triggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
            openModal(btn);
        });
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', function (event) {
        if (event.target === backdrop) closeModal();
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && backdrop.style.display === 'flex') closeModal();
    });
});
</script>
{% endblock %}
