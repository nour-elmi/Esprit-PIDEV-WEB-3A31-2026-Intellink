{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Réclamations - Intel_link{% endblock %}

{% block body %}
<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
    <div>
        <h3 class="fw-bold mb-3"><i class="fas fa-exclamation-triangle me-2 text-warning"></i> Gestion des Réclamations</h3>
        <h6 class="op-7 mb-2">Consultez et traitez les demandes des utilisateurs</h6>
    </div>
    
    <div class="ms-md-auto py-2 py-md-0">
        <form action="{{ path('app_admin_reclamations') }}" method="GET" class="d-flex gap-2">
            {% if currentUserId %}
                <input type="hidden" name="user_id" value="{{ currentUserId }}">
            {% endif %}
            
            <select name="statut" class="form-select form-select-sm border-secondary fw-bold" onchange="this.form.submit()" style="cursor: pointer; min-width: 150px;">
                <option value="TOUT" {% if currentStatut == 'TOUT' or not currentStatut %}selected{% endif %}>TOUT (STATUT)</option>
                <option value="OUVERT" {% if currentStatut == 'OUVERT' %}selected{% endif %}>OUVERT</option>
                <option value="TRAITE" {% if currentStatut == 'TRAITE' %}selected{% endif %}>TRAITE</option>
                <option value="REJETE" {% if currentStatut == 'REJETE' %}selected{% endif %}>REJETE</option>
            </select>
            
            
        </form>
    </div>
</div>

<div class="row">
    {% for email, reclamations in groupedReclamations %}
        
        <div class="col-12 mt-4 mb-3">
            <div class="d-flex align-items-center border-bottom pb-2">
                <div class="avatar avatar-sm me-3">
                    <span class="avatar-title rounded-circle border border-white bg-primary">
                        <i class="fas fa-user text-white"></i>
                    </span>
                </div>
                <h4 class="mb-0 fw-bold text-primary" style="font-size: 18px;">{{ email }}</h4>
                <span class="badge badge-count bg-secondary ms-3">{{ reclamations|length }} réclamation(s)</span>
            </div>
        </div>

        {% for r in reclamations %}
            
                {% set borderStyle = 'border: 1px solid #cbd5e1; box-shadow: 0 4px 6px rgba(0,0,0,0.05);' %}
            

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 custom-rec-card" style="border-radius: 12px; {{ borderStyle }} transition: transform 0.2s ease, box-shadow 0.2s ease;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    
                    <div class="card-header d-flex justify-content-end align-items-center bg-white" style="border-radius: 12px 12px 0 0; border-bottom: 2px dashed #f1f5f9; padding: 15px 20px;">
                        
                        <div>
                            {% if r.statut|upper == 'OUVERT' %}
                                <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> OUVERT</span>
                            {% elseif r.statut|upper == 'TRAITE' %}
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> TRAITÉ</span>
                            {% elseif r.statut|upper == 'REJETE' %}
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> REJETÉ</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ r.statut|upper }}</span>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="card-body d-flex flex-column" style="padding: 20px;">
                        <span class="text-uppercase fw-bold d-block mb-1" style="font-size: 11px; letter-spacing: 1px; color: #64748b;"><i class="fas fa-tag me-1"></i> Objet de la demande</span>
                        <h5 class="card-title fw-bold mb-3" style="color: #0f172a; font-size: 16px; line-height: 1.4;">{{ r.objet }}</h5>
                        
                        <span class="text-uppercase fw-bold d-block mt-2 mb-1" style="font-size: 11px; letter-spacing: 1px; color: #64748b;"><i class="fas fa-align-left me-1"></i> Contenu</span>
                        <div class="bg-light rounded p-3 mb-3 d-flex flex-column" style="border: 1px solid #e2e8f0; flex-grow: 1;">
                            <p class="text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                {{ r.description }}
                            </p>
                        </div>
                        
                        <div class="mt-auto">
                            <a href="{{ path('app_admin_reclamation_treat', {'id': r.id}) }}" class="btn btn-primary w-100 fw-bold shadow-sm" style="border-radius: 8px; padding: 10px;">
                                <i class="fas fa-search-plus me-2"></i> Examiner la demande
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        {% endfor %}

    {% else %}
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-white shadow-sm" style="border-radius: 15px;">
                <i class="fas fa-check-circle text-success mb-3" style="font-size: 40px;"></i>
                <h4 class="text-muted fw-bold">Aucune réclamation trouvée.</h4>
                <p class="text-secondary">Tout est en ordre !</p>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}

