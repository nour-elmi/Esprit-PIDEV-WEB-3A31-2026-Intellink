{% extends 'base_back.html.twig' %}

{% block title %}Traiter la Réclamation - Intel_link{% endblock %}

{% block body %}
<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
    <div>
        <h3 class="fw-bold mb-3"><i class="fas fa-reply me-2 text-primary"></i> Traitement de la Réclamation</h3>
        <h6 class="op-7 mb-2">Analysez la demande et apportez une réponse à l'utilisateur</h6>
    </div>
    <div class="ms-md-auto py-2 py-md-0">
        <a href="{{ path('app_admin_reclamations') }}" class="btn btn-secondary btn-round">
            <i class="fas fa-arrow-left me-2"></i> Retour aux réclamations
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card card-round h-100 shadow-sm" style="border-top: 4px solid #fbbc04;">
            <div class="card-header">
                <div class="card-title fw-bold">Message de l'utilisateur</div>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <span class="text-muted small fw-bold">UTILISATEUR</span><br>
                    <div class="d-flex align-items-center mt-2">
                        <div class="avatar avatar-sm me-2">
                            <span class="avatar-title rounded-circle bg-primary"><i class="fas fa-user"></i></span>
                        </div>
                        <span class="fw-bold text-dark">{{ reclamation.utilisateur ? reclamation.utilisateur.email : 'Utilisateur inconnu' }}</span>
                    </div>
                </div>

                <div class="mb-4">
                    <span class="text-muted small fw-bold">OBJET DE LA DEMANDE</span><br>
                    <h5 class="fw-bold text-dark mt-1">{{ reclamation.objet }}</h5>
                </div>

                <div class="mb-4">
                    <span class="text-muted small fw-bold">DESCRIPTION COMPLÈTE</span><br>
                    <div class="p-3 mt-2 rounded bg-light border" style="min-height: 150px; font-size: 14px; color: #334155;">
                        {{ reclamation.description|nl2br }}
                    </div>
                </div>

                {% if reclamation.pieceJointe %} {# 🚨 Change 'pieceJointe' par ton vrai nom de variable si besoin #}
                    <div>
                        <span class="text-muted small fw-bold">PIÈCE JOINTE FOURNIE</span><br>
                        <div class="p-3 mt-2 rounded border d-flex align-items-center" style="background-color: #f8fafc;">
                            <i class="fas fa-paperclip text-primary fs-4 me-3"></i>
                            <a href="{{ asset('uploads/reclamations/' ~ reclamation.pieceJointe) }}" target="_blank" class="fw-bold text-primary text-decoration-none">
                                Ouvrir le fichier joint dans un nouvel onglet
                            </a>
                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card card-round h-100 shadow-sm" style="border-top: 4px solid #2F80ED;">
            <div class="card-header">
                <div class="card-title fw-bold">Votre Réponse (Admin)</div>
            </div>
            <div class="card-body">
                
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}

                <form action="{{ path('app_admin_reclamation_treat', {'id': reclamation.id}) }}" method="POST">
                    
                    <div class="form-group px-0 mb-3">
                        <label for="statut" class="fw-bold mb-2">Nouveau Statut <span class="text-danger">*</span></label>
                        <select name="statut" id="statut" class="form-select form-control-lg border-secondary" required>
                            <option value="TRAITE" {% if reclamation.statut == 'TRAITE' %}selected{% endif %}>✅ TRAITÉ (Résolu)</option>
                            <option value="REJETE" {% if reclamation.statut == 'REJETE' %}selected{% endif %}>❌ REJETÉ (Non justifié)</option>
                            <option value="OUVERT" {% if reclamation.statut == 'OUVERT' %}selected{% endif %}>⏳ OUVERT (En attente)</option>
                        </select>
                    </div>

                    <div class="form-group px-0 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label for="reponse" class="fw-bold mb-0">Message de réponse <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btn-reformulate">
                                <i class="fas fa-magic"></i> Rendre plus professionnel
                            </button>
                        </div>
                        <textarea name="reponse" id="reponse" rows="6" class="form-control border-secondary" placeholder="Rédigez votre réponse officielle ici..." required>{{ reclamation.reponseAdmin }}</textarea>
                        <small class="form-text text-muted">Ce message sera visible par l'utilisateur dans son espace personnel.</small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        <i class="fas fa-paper-plane me-2"></i> Enregistrer et envoyer la réponse
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btnReformulate = document.getElementById('btn-reformulate');
        const textarea = document.getElementById('reponse');

        if(btnReformulate && textarea) {
            btnReformulate.addEventListener('click', function(e) {
                e.preventDefault();
                let text = textarea.value.trim();
                
                if (text === "") {
                    textarea.value = "Bonjour,\n\nNous avons bien pris en compte votre réclamation et l'avons traitée avec soin.\n\nCordialement,\nL'équipe IntelLink";
                    return;
                }

                // Dictionnaire de remplacements de syntaxe
                const dictionnaireCorrigee = {
                    "\\bsalut\\b": "Bonjour",
                    "\\bcoucou\\b": "Bonjour",
                    "\\bc'est fait\\b": "votre requête a été traitée avec succès",
                    "\\bon va voir\\b": "nous allons examiner votre demande dans les plus brefs délais",
                    "\\bon s'occupe de ça\\b": "notre équipe prend en charge cette situation",
                    "\\bdésolé\\b": "nous vous prions de nous excuser pour le désagrément",
                    "\\bpardon\\b": "nous vous présentons toutes nos excuses",
                    "\\bproblème\\b": "désagrément",
                    "\\bsouci\\b": "difficulté rencontrée",
                    "\\bmerci\\b": "nous vous remercions de votre compréhension",
                    "\\bt'inquiète\\b": "soyez assuré(e)",
                    "\\bsvp\\b": "s'il vous plaît",
                };

                for (const [pattern, replacement] of Object.entries(dictionnaireCorrigee)) {
                    const regex = new RegExp(pattern, 'gi');
                    text = text.replace(regex, replacement);
                }

                text = text.replace(/(^\s*|\.\s+)([a-z])/g, function(match, separator, char) {
                    return separator + char.toUpperCase();
                });

                if (!/(bonjour|bonsoir)/i.test(text)) {
                    text = "Bonjour,\n\n" + text;
                }

                if (!/(cordialement|salutations|bien à vous|sincèrement|équipe)/i.test(text)) {
                    text = text + "\n\nCordialement,\nL'équipe IntelLink";
                }

                textarea.value = text;
                btnReformulate.innerHTML = '<i class="fas fa-check"></i> Texte amélioré';
                setTimeout(() => {
                    btnReformulate.innerHTML = '<i class="fas fa-magic"></i> Rendre plus professionnel';
                }, 2000);
            });
        }
    });
</script>
{% endblock %}