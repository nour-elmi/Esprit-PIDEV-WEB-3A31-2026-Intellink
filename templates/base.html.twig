
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <title>{% block title %}Intel_link{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>ðŸš€</text></svg>">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        
        {% block stylesheets %}{% endblock %}

        <style>
            /* VARIABLES INTEL_LINK / iMESSAGE */
            :root {
                --intel-blue: #007AFF; 
                --imessage-gray: #E9E9EB;
                --text-dark: #000000;
                --bg-panel: rgba(255, 255, 255, 0.85);
            }

            /* =========================================
               1. LE BOUTON DE LA NAVBAR
               ========================================= */
            .navbar-chat-container {
                position: fixed;
                top: 20px;
                right: 30px; /* Placée tout à fait à droite */
                z-index: 999990; /* Juste sous le preloader */
                list-style: none;
                pointer-events: auto !important;
                transform: translateZ(9999px);
            }
            .navbar-notif-container {
                position: fixed;
                top: 20px;
                right: 80px; /* Poussée un peu vers la droite, à gauche de la messagerie */
                z-index: 999990;
                list-style: none;
                pointer-events: auto !important;
                transform: translateZ(9999px);
            }

            .nav-messenger-link {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 45px;
                height: 45px;
                background: rgba(255, 255, 255, 0.9);
                border-radius: 50%;
                color: #64748b;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
                transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                text-decoration: none;
                pointer-events: auto !important;
            }

            .nav-messenger-link:hover {
                color: var(--intel-blue);
                transform: translateY(-3px) scale(1.05);
                box-shadow: 0 8px 25px rgba(0, 122, 255, 0.2);
            }

            .messenger-icon-wrapper { position: relative; width: 24px; height: 24px; }
            .messenger-svg { width: 100%; height: 100%; filter: drop-shadow(0 2px 3px rgba(0,0,0,0.1)); }

            /* Badge Global de Notifications (+99) */
            .messenger-badge {
                position: absolute; top: -5px; right: -5px; 
                background-color: #FF3B30; color: white; 
                font-size: 11px; font-weight: bold; 
                min-width: 18px; height: 18px; padding: 0 4px;
                display: flex; align-items: center; justify-content: center;
                border-radius: 10px; border: 2px solid #ffffff;
                box-shadow: 0 2px 4px rgba(255,59,48,0.3);
                transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }
            .messenger-badge.hidden { display: none !important; }
            .messenger-badge.pop { transform: scale(1.3); }

            /* =========================================
               2. LE PANNEAU DE MESSAGERIE
               ========================================= */
            .imessage-panel { 
                position: fixed; top: 80px; right: 30px; width: 360px; height: 550px; 
                background: var(--bg-panel); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); 
                border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.15); 
                border: 1px solid rgba(255,255,255,0.5); z-index: 999990; overflow: hidden; display: flex; 
                opacity: 0; pointer-events: none; transform: translateY(-20px) scale(0.95); 
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            }
            .imessage-panel.is-active { opacity: 1; pointer-events: auto !important; transform: translateY(0) scale(1); }

            /* Vues glissantes */
            .imessage-view { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1); background: transparent; }
            .view-active { transform: translateX(0); }
            .view-hidden-left { transform: translateX(-30%); opacity: 0; pointer-events: none; }
            .view-hidden-right { transform: translateX(100%); pointer-events: none; }

            /* En-tÃªtes et Recherche */
            .imessage-header { padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; z-index: 10; }
            .large-title h3 { margin: 10px 0 0 0; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-dark); }
            .icon-btn { background: #E9E9EB; border: none; width: 30px; height: 30px; border-radius: 50%; font-size: 14px; color: #8E8E93; cursor: pointer; transition: 0.2s;}
            .icon-btn:hover { background: #d1d1d6; }
            .blur-header { background: rgba(255,255,255,0.75); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0,0,0,0.05); padding: 10px 15px; }
            .back-btn { background: none; border: none; color: var(--intel-blue); font-size: 22px; cursor: pointer; padding: 0; display: flex; align-items: center; }
            .center-profile { display: flex; flex-direction: column; align-items: center; cursor: pointer; }
            .small-avatar { width: 40px; height: 40px; border-radius: 50%; margin-bottom: 2px; }
            .center-profile .name { font-size: 11px; font-weight: 500; color: var(--text-dark); display: flex; align-items: center; gap: 4px; }
            .details-arrow { font-size: 9px; color: #C7C7CC; }
            .imessage-search { padding: 5px 20px 15px; position: relative; }
            .imessage-search input { width: 100%; background: rgba(118, 118, 128, 0.12); border: none; border-radius: 10px; padding: 8px 10px 8px 30px; font-size: 15px; outline: none; }
            .imessage-search i { position: absolute; left: 28px; top: 14px; color: #8E8E93; font-size: 14px; }

            /* =========================================
               3. SUGGESTIONS HORIZONTALES
               ========================================= */
            .section-title { font-size: 13px; font-weight: 700; padding: 10px 20px 5px; color: #8E8E93; text-transform: uppercase; letter-spacing: 0.5px; }
            .imessage-suggestions-container { 
                display: flex; 
                overflow-x: auto; 
                padding: 10px 20px 15px; 
                gap: 15px; 
                border-bottom: 1px solid rgba(0,0,0,0.05); 
                -webkit-overflow-scrolling: touch; 
            }
            .imessage-suggestions-container::-webkit-scrollbar { height: 6px; }
            .imessage-suggestions-container::-webkit-scrollbar-track { background: transparent; margin: 0 20px; }
            .imessage-suggestions-container::-webkit-scrollbar-thumb { background: #d1d1d6; border-radius: 10px; }
            .imessage-suggestions-container::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }
            
            .suggestion-item { display: flex; flex-direction: column; align-items: center; cursor: pointer; min-width: 65px; transition: transform 0.2s; }
            .suggestion-item:hover { transform: scale(1.05); }
            .suggestion-avatar-wrapper { position: relative; width: 55px; height: 55px; border-radius: 50%; padding: 2px; border: 2px solid var(--intel-blue); }
            .suggestion-avatar-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
            .suggestion-add-badge { position: absolute; bottom: -4px; right: -4px; background: var(--intel-blue); color: white; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; border: 2px solid white; transition: 0.3s; }
            .suggestion-name { font-size: 12px; margin-top: 6px; color: var(--text-dark); font-weight: 500; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 65px; }

            /* =========================================
               4. LISTE DES CONVERSATIONS ACTIVES
               ========================================= */
            .imessage-contact-list { flex: 1; overflow-y: auto; }
            .imessage-contact-list::-webkit-scrollbar { width: 4px; }
            .imessage-contact-list::-webkit-scrollbar-thumb { background: #d1d1d6; border-radius: 10px; }
            .imessage-contact { display: flex; align-items: center; padding: 10px 20px; cursor: pointer; transition: 0.2s;}
            .imessage-contact:hover { background: rgba(0,0,0,0.03); }
            .imessage-contact .avatar { width: 45px; height: 45px; border-radius: 50%; margin-right: 12px; object-fit: cover;}
            .contact-content { flex: 1; border-bottom: 0.5px solid rgba(60,60,67,0.15); padding-bottom: 12px; margin-top: 2px; }
            .contact-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2px; }
            .contact-top .name { font-weight: 600; font-size: 16px; color: var(--text-dark); }
            .contact-top .time { font-size: 14px; color: #8E8E93; }
            .contact-bottom { display: flex; justify-content: space-between; align-items: center; }
            .contact-bottom .last-msg { font-size: 14px; color: #8E8E93; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }

            /* Mettre en gras les conversations non lues */
            .unread-bold .name { font-weight: 800 !important; color: var(--intel-blue) !important; }
            .unread-bold .last-msg { font-weight: 700 !important; color: var(--text-dark) !important; }

            /* =========================================
               5. VUE DISCUSSION (BULLES)
               ========================================= */
            .imessage-body { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }
            .imessage-body::-webkit-scrollbar { width: 4px; }
            .imessage-body::-webkit-scrollbar-thumb { background: #d1d1d6; border-radius: 10px; }
            .date-stamp { text-align: center; font-size: 11px; font-weight: 600; color: #8E8E93; margin: 15px 0; }
            .message-wrapper { display: flex; flex-direction: column; max-width: 75%; margin-bottom: 8px; }
            .message-wrapper.sent { align-self: flex-end; align-items: flex-end; }
            .message-wrapper.received { align-self: flex-start; align-items: flex-start; }
            .bubble { padding: 8px 14px; font-size: 15px; line-height: 1.35; position: relative; word-wrap: break-word; }
            .sent .bubble { background: var(--intel-blue); color: white; border-radius: 18px 18px 4px 18px; }
            .received .bubble { background: var(--imessage-gray); color: var(--text-dark); border-radius: 18px 18px 18px 4px; }
            
            /* =========================================
               6. LA MAGIE iMESSAGE (Typing & Statuts)
               ========================================= */
            .typing-indicator {
                background-color: var(--imessage-gray);
                will-change: transform;
                width: auto;
                border-radius: 18px 18px 18px 4px;
                padding: 12px 16px;
                display: inline-flex;
                align-items: center;
                gap: 4px;
                margin-bottom: 8px;
                align-self: flex-start;
                animation: fadeIn 0.3s ease-in-out;
            }

            .typing-indicator .dot {
                height: 7px; width: 7px; border-radius: 50%;
                background-color: #8E8E93;
                animation: typingBounce 1.4s infinite ease-in-out both;
            }
            .typing-indicator .dot:nth-child(1) { animation-delay: -0.32s; }
            .typing-indicator .dot:nth-child(2) { animation-delay: -0.16s; }

            @keyframes typingBounce {
                0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
                40% { transform: scale(1); opacity: 1; }
            }
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }

            /* Bulle de statut (Distribué/Lu) */
            .msg-info {
                font-size: 11px; color: #8E8E93; font-weight: 500;
                margin-top: 2px; text-align: right; margin-right: 5px;
                display: flex; justify-content: flex-end; gap: 4px; align-items: center;
            }

            .imessage-footer { padding: 10px 15px; background: transparent; padding-bottom: 15px; }
            .input-pill { display: flex; align-items: center; border: 1px solid rgba(0,0,0,0.15); border-radius: 20px; padding: 3px 4px 3px 15px; background: #ffffff; }
            .input-pill input { flex: 1; border: none; outline: none; font-size: 15px; background: transparent; }
            .send-circle-btn { width: 28px; height: 28px; border-radius: 50%; background: var(--intel-blue); color: white; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: opacity 0.2s; }
            .send-circle-btn:active { opacity: 0.7; }

            /* =========================================
               7. DESIGN DU LOGO ANIMÃ‰ DE L'IA
               ========================================= */
            .ai-logo-container {
                width: 45px;
                height: 45px;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                background: radial-gradient(circle, rgba(0, 122, 255, 0.1) 0%, transparent 70%);
                border-radius: 50%;
            }

            .ai-svg-brain {
                width: 32px;
                height: 32px;
                filter: drop-shadow(0 0 5px rgba(0, 122, 255, 0.5));
            }

            .brain-path {
                stroke-dasharray: 100;
                stroke-dashoffset: 100;
                animation: dashDraw 3s infinite alternate ease-in-out;
            }

            .brain-dot {
                animation: brainPulse 2s infinite ease-in-out;
            }

            @keyframes dashDraw {
                to { stroke-dashoffset: 0; }
            }

            @keyframes brainPulse {
                0%, 100% { opacity: 0.3; transform: scale(0.8); }
                50% { opacity: 1; transform: scale(1.2); filter: brightness(1.5); }
            }

            .ai-aura {
                position: absolute;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                background: conic-gradient(from 0deg, transparent, var(--intel-blue), transparent);
                animation: rotateAura 4s linear infinite;
                opacity: 0.2;
            }

            @keyframes rotateAura {
                from { transform: rotate(0deg); }
                to { transform: rotate(360deg); }
            }
        </style>
    </head>
    
    <body>
        {% block body %}
        {% endblock %}

        {% if app.user %}
        <!-- CHAT BUTTON (A Gauche du PDP) -->
        <div class="navbar-chat-container" style="display: flex; align-items: center;">
            <a href="#" id="navbarChatBtn" class="nav-messenger-link" onclick="document.getElementById('chatWidgetPanel').classList.toggle('is-active'); return false;">
                <div class="messenger-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="messenger-svg">
                        <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 13.5997 2.37562 15.1116 3.04348 16.4522L2 22L7.54783 20.9565C8.88837 21.6244 10.4003 22 12 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M8 9H16M8 13H13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </a>
        </div>

            <!-- NOTIFICATION BELL (A Droite du PDP) -->
            {% set unreadRecs = [] %}
            {% for r in app.user.reclamations %}
                {% if r.statut == 'TRAITE' and not r.isRead %}
                    {% set unreadRecs = unreadRecs|merge([r]) %}
                {% endif %}
            {% endfor %}
            {% set pendingFriends = get_pending_friend_requests(app.user) %}
            {% set totalNotifsCount = unreadRecs|length + pendingFriends|length %}

        <div class="navbar-notif-container" style="display: flex; align-items: center;">
            <div class="notification-dropdown-container" style="position: relative;">
                <a href="#" id="navbarNotifBtn" class="nav-messenger-link" onclick="document.getElementById('notifDropdown').classList.toggle('show'); return false;">
                    <div class="messenger-icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="messenger-svg">
                            <path d="M18 15v3H6v-3M12 2v2m-6 3l1.5 1.5M19.5 8.5L18 7m-6-3a5 5 0 0 0-5 5v5l-2 2v1h14v-1l-2-2v-5a5 5 0 0 0-5-5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10 21h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="messenger-badge {% if totalNotifsCount == 0 %}hidden{% endif %}" id="notifBadge">{{ totalNotifsCount }}</span>
                    </div>
                </a>

                <!-- DROPDOWN CONTENT -->
                <div id="notifDropdown" class="notif-dropdown">
                    <div class="notif-header">Notifications (<span id="totalNotifCount">{{ totalNotifsCount }}</span>)</div>
                    <div class="notif-body">
                        <!-- MESSENGER (Updated via JS) -->
                        <div class="notif-item messenger-notif hidden" id="messagerieNotifItem" onclick="document.getElementById('chatWidgetPanel').classList.add('is-active'); document.getElementById('notifDropdown').classList.remove('show');">
                            <div class="icon-circle" style="background:#e0f2fe; color:#2563eb;"><i class="lni lni-comments"></i></div>
                            <div class="content">
                                <h4>Messagerie</h4>
                                <p>Vous avez <span id="txtGlobalUnread">0</span> nouveau(x) message(s).</p>
                            </div>
                        </div>

                        <!-- AMIS: DEMANDES -->
                        {% for fr in pendingFriends %}
                        <div class="notif-item friend-request-notif" onclick="document.getElementById('chatWidgetPanel').classList.add('is-active'); document.getElementById('notifDropdown').classList.remove('show');">
                            <div class="icon-circle" style="background:#fce7f3; color:#db2777;"><i class="lni lni-users"></i></div>
                            <div class="content">
                                <h4>Demande d'ami</h4>
                                <p><strong>{{ fr.requester.nom }}</strong> vous a envoyÃ© une demande d'ami.</p>
                            </div>
                        </div>
                        {% endfor %}

                        <!-- RECLAMATIONS -->
                        {% for r in unreadRecs %}
                        <div class="notif-item reclamation-notif" id="rec-notif-{{ r.id }}" onclick="markRecAsRead({{ r.id }}, '{{ path('app_reclamation_show', {'id': r.id}) }}')">
                            <div class="icon-circle" style="background:#dcfce7; color:#059669;"><i class="lni lni-checkmark-circle"></i></div>
                            <div class="content">
                                <h4>RÃ©clamation TraitÃ©e</h4>
                                <p>Votre ticket "#{{ r.id }} - {{ r.objet|slice(0,15) }}..." a reÃ§u une rÃ©ponse.</p>
                            </div>
                        </div>
                        {% endfor %}
                        
                        {% if totalNotifsCount == 0 %}
                        <div class="notif-empty" id="emptyNotifMsg">Aucune nouvelle notification.</div>
                        {% endif %}
                    </div>
                </div>
            </div>
            
            <style>
                .notification-dropdown-container {
                    display: inline-block;
                }
                .notif-dropdown {
                    position: absolute;
                    top: 60px;
                    right: 0;
                    width: 320px;
                    background: rgba(255, 255, 255, 0.95);
                    backdrop-filter: blur(10px);
                    border-radius: 16px;
                    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                    border: 1px solid rgba(255,255,255,0.4);
                    opacity: 0;
                    visibility: hidden;
                    transform: translateY(10px);
                    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    z-index: 100;
                }
                .notif-dropdown.show {
                    opacity: 1;
                    visibility: visible;
                    transform: translateY(0);
                }
                .notif-header {
                    padding: 15px 20px;
                    font-weight: bold;
                    border-bottom: 1px solid rgba(0,0,0,0.05);
                    color: #0f172a;
                }
                .notif-body {
                    max-height: 400px;
                    overflow-y: auto;
                }
                .notif-item {
                    display: flex;
                    align-items: center;
                    padding: 12px 20px;
                    cursor: pointer;
                    transition: background 0.2s;
                    border-bottom: 1px solid rgba(0,0,0,0.03);
                }
                .notif-item:hover {
                    background: rgba(0,0,0,0.02);
                }
                .notif-item.hidden {
                    display: none;
                }
                .notif-item .icon-circle {
                    width: 40px; height: 40px;
                    border-radius: 50%;
                    display: flex; align-items: center; justify-content: center;
                    margin-right: 15px; font-size: 20px;
                }
                .notif-item .content h4 { margin: 0 0 3px 0; font-size: 14px; font-weight: 600; color: #1e293b; }
                .notif-item .content p { margin: 0; font-size: 12px; color: #64748b; line-height: 1.3; }
                .notif-empty { padding: 30px 20px; text-align: center; color: #94a3b8; font-size: 14px; }
            </style>
            
            <script>
                // Mark Reclamation as Read API call
                function markRecAsRead(id, url) {
                    fetch('/reclamation/' + id + '/read', { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        window.location.href = url;
                    });
                }
                
                // Hide dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    const dropdown = document.getElementById('notifDropdown');
                    const btn = document.getElementById('navbarNotifBtn');
                    if(dropdown && btn && !dropdown.contains(e.target) && !btn.contains(e.target)) {
                        dropdown.classList.remove('show');
                    }
                });
            </script>
        </div>
        
        <!-- BOUTON FLOTTANT INTELLINK AI (faÃ§on Meta d'Messenger) -->
        <div style="position: fixed; bottom: 30px; right: 30px; z-index: 999990; cursor: pointer;">
            <a href="#" id="floatingAiBtn" class="nav-messenger-link" style="width: 60px; height: 60px; background: white; border: 2px solid var(--intel-blue); box-shadow: 0 10px 25px rgba(0, 122, 255, 0.4); display: flex; align-items: center; justify-content: center;" onclick="document.getElementById('chatWidgetPanel').classList.toggle('is-active'); window.slideIntoDiscussion('IntelLink AI', 'ai-logo', 'ai'); return false;">
                <div class="ai-logo-container" style="width: 100%; height: 100%; background: transparent;">
                    <div class="ai-aura" style="opacity: 0.15;"></div>
                    <svg class="ai-svg-brain" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 36px; height: 36px;">
                        <path class="brain-path" d="M12 22C12 22 20 18 20 12C20 6 16 2 12 2C8 2 4 6 4 12C4 18 12 22 12 22Z" stroke="#007AFF" stroke-width="1.5"/>
                        <path class="brain-path" d="M12 2V22" stroke="#007AFF" stroke-width="1" stroke-dasharray="2 2"/>
                        <circle class="brain-dot" cx="12" cy="7" r="1.5" fill="#007AFF"/>
                        <circle class="brain-dot" cx="16" cy="11" r="1" fill="#8b5cf6" style="animation-delay: 0.5s;"/>
                        <circle class="brain-dot" cx="8" cy="13" r="1" fill="#007AFF" style="animation-delay: 1s;"/>
                    </svg>
                </div>
            </a>
        </div>

        <div id="chatWidgetPanel" class="imessage-panel">
            
            <div id="viewContacts" class="imessage-view view-active">
                <div class="imessage-header large-title">
                    <h3>Messages</h3>
                    <button id="closeChatBtn" class="icon-btn" onclick="document.getElementById('chatWidgetPanel').classList.remove('is-active'); return false;"><i class="fas fa-times"></i></button>
                </div>
                
                <div class="imessage-search">
                    <i class="fas fa-search"></i>
                    <input type="text" id="chatSearchInput" placeholder="Rechercher">
                </div>

                {{ render(controller('App\\Controller\\MessengerController::contactList')) }}

            </div>

            <div id="viewDiscussion" class="imessage-view view-hidden-right">
                <div class="imessage-header blur-header">
                    <button id="backBtn" class="back-btn" onclick="document.getElementById('viewDiscussion').classList.remove('view-active'); document.getElementById('viewDiscussion').classList.add('view-hidden-right'); document.getElementById('viewContacts').classList.remove('view-hidden-left'); document.getElementById('viewContacts').classList.add('view-active'); return false;"><i class="fas fa-chevron-left"></i></button>
                    <div class="center-profile">
                        <img id="activeAvatar" src="" class="small-avatar">
                        
                        <div id="activeAvatarAi" class="ai-logo-container" style="display: none; width: 40px; height: 40px; margin-bottom: 2px;">
                            <div class="ai-aura"></div>
                            <svg class="ai-svg-brain" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 26px; height: 26px;">
                                <path class="brain-path" d="M12 22C12 22 20 18 20 12C20 6 16 2 12 2C8 2 4 6 4 12C4 18 12 22 12 22Z" stroke="#007AFF" stroke-width="1.5"/>
                                <path class="brain-path" d="M12 2V22" stroke="#007AFF" stroke-width="1" stroke-dasharray="2 2"/>
                                <circle class="brain-dot" cx="12" cy="7" r="1.5" fill="#007AFF"/>
