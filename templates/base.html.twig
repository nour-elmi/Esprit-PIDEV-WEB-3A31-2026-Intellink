            </div>
        </div>
        {% endif %}

        {% block javascripts %}
        {% endblock %}

        <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>

        <script>
            // ðŸ”´ VARIABLES GLOBALES POUR LE CHAT
            let activeConversationId = null;
            let currentUserId = {{ app.user ? app.user.id : 'null' }};
            let pusher = null;
            let activeChannel = null;
            let typingTimer;
            let isSending = false;
            const TYPING_TIMEOUT = 2000;
            let globalUnread = 0;

            // ðŸ”´ 7. GESTION DES DEMANDES D'AMIS (MOVED TO TOP)
            window.envoyerDemande = function(userId, el) {
                const badge = el.querySelector('.suggestion-add-badge');
                const icon = badge.querySelector('i');

                badge.style.background = "#ccc";
                badge.style.borderColor = "#ccc";
                icon.className = "fas fa-spinner fa-spin";

                fetch('/api/friend-request/send/' + userId, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        badge.style.background = "var(--intel-blue)";
                        badge.style.borderColor = "white";
                        icon.className = "fas fa-plus";
                    } else {
                        badge.style.background = "#10b981";
                        badge.style.borderColor = "white";
                        icon.className = "fas fa-check";
                    }
                })
                .catch(error => console.error('Erreur:', error));
            };
// Fonction pour animer le badge +99
            function updateBadge() {
    const badge = document.getElementById('notifBadge');
    if (!badge) return;
    
    // Logique mixte : Messages non lus + Reclamations non lues
    const unreadRecsEl = document.getElementById('totalNotifCount');
    const recsCount = unreadRecsEl ? parseInt(unreadRecsEl.innerText || 0) : 0;
    const msgNotifItem = document.getElementById('messagerieNotifItem');
    const txtGlobalUnread = document.getElementById('txtGlobalUnread');
    
    if (globalUnread > 0 && msgNotifItem && txtGlobalUnread) {
        msgNotifItem.classList.remove('hidden');
        txtGlobalUnread.innerText = globalUnread;
    } else if (msgNotifItem) {
        msgNotifItem.classList.add('hidden');
    }
    
    const total = globalUnread + recsCount;
    
    if (total <= 0) {
        badge.classList.add('hidden');
    } else {
        badge.classList.remove('hidden');
        badge.innerText = total > 99 ? '+99' : total;
                }
            }

            // RÃ©cupÃ©rer le total au chargement de la page
            setTimeout(() => {
                const initSpan = document.getElementById('initTotalUnread');
                if (initSpan) { globalUnread = parseInt(initSpan.innerText) || 0; updateBadge(); }
            }, 500);

            // Initialisation de Pusher
            if (currentUserId) {
                                pusher = new Pusher('185d0f65ec9745830a72', {
                    cluster: 'eu',
                    channelAuthorization: {
                        endpoint: '/api/pusher/auth',
                        transport: 'ajax'
                    }
                });

                // Canal de présence pour l'état en ligne (Pusher v8+ utilise channelAuthorization)
                const presenceChannel = pusher.subscribe('presence-messenger');

                presenceChannel.bind('pusher:subscription_succeeded', (members) => {
                    members.each((member) => {
                        if (member.id != currentUserId) updatePresenceStatus(member.id, true);
                    });
                });

                presenceChannel.bind('pusher:member_added', (member) => {
                    updatePresenceStatus(member.id, true);
                });

                presenceChannel.bind('pusher:member_removed', (member) => {
                    updatePresenceStatus(member.id, false);
                });

                function updatePresenceStatus(userId, isOnline) {
                    const contactItems = document.querySelectorAll('.imessage-contact[data-user-id="' + userId + '"]');
                    contactItems.forEach(item => {
                        const timeSpan = item.querySelector('.time');
                        if (timeSpan) {
                            timeSpan.innerText = isOnline ? 'En ligne' : 'Il y a un instant';
                            timeSpan.style.color = isOnline ? '#10B981' : '#9CA3AF';
                        }
                    });

                    // Si la personne est la cible de la conversation active
                    // Il faut récupérer le profil / targetUserId -> on va vérifier via l'ID actif
                    // On ne l'a pas explicitement dans une variable, mais on peut vérifier l'ID de la conversation => _contact_list a data-user-id
                    const activeContact = document.querySelector('.imessage-contact.active[data-user-id="' + userId + '"]');
                    if (activeContact) {
                        const activeStatusStr = document.getElementById('activeStatusStr');
                        if (activeStatusStr) {
                            activeStatusStr.innerText = isOnline ? 'En ligne' : 'Il y a un instant';
                            // activeStatusStr.style.color = isOnline ? '#10B981' : '#9CA3AF'; // si applicable
                        }
                    }
                }

                // ðŸ”´ LE CANAL GLOBAL DES NOTIFICATIONS (Pour le Badge Navbar)
                const globalChannel = pusher.subscribe('user-channel-' + currentUserId);
                globalChannel.bind('notification', function(data) {
                    const isChatPanelOpen = document.getElementById('chatWidgetPanel').classList.contains('is-active');
                    const isViewingThisChat = (activeConversationId === data.conversation_id) && !document.getElementById('viewDiscussion').classList.contains('view-hidden-right');

                    // Si on n'est pas DÉJÀ en train de lire cette conversation
                    if (!(isChatPanelOpen && isViewingThisChat)) {
                        globalUnread++;
                        updateBadge();
                        const convItem = document.getElementById('conv-item-' + data.conversation_id);
                        if (convItem) {
                            convItem.classList.add('unread-bold');
                            let cur = parseInt(convItem.getAttribute('data-unread')) || 0;
                            convItem.setAttribute('data-unread', cur + 1);
                        }
                    }
                });

                globalChannel.bind('unfriend-event', function(data) {
                    const removedUserId = (data.removerId == currentUserId) ? data.removedId : data.removerId;
                    
                    let extractedName = "Utilisateur";
                    let extractedAvatar = "https://ui-avatars.com/api/?name=User&background=f1f5f9&color=000";

                    // Remove from Contact List and extract details
                    const convItem = document.getElementById('conv-item-' + data.conversationId);
                    if (convItem) {
                        extractedName = convItem.getAttribute('data-name') || extractedName;
                        extractedAvatar = convItem.getAttribute('data-avatar') || extractedAvatar;
                        convItem.remove();
                    }

                    // Search by data-user-id fallback for Conv Item and Suggestions
                    const allConvItems = document.querySelectorAll('.imessage-contact[data-user-id="'+removedUserId+'"]');
                    allConvItems.forEach(item => {
                        extractedName = item.getAttribute('data-name') || extractedName;
                        extractedAvatar = item.getAttribute('data-avatar') || extractedAvatar;
                        item.remove();
                    });

                    const allSuggestionItems = document.querySelectorAll('.suggestion-item[data-user-id="'+removedUserId+'"]');
                    allSuggestionItems.forEach(item => item.remove());

                    // Rebuild suggestion
                    const suggestionsContainer = document.querySelector('.imessage-suggestions-container');
                    if (suggestionsContainer) {
                        const suggestionHtml = `
                            <div class="suggestion-item" data-user-id="${removedUserId}" onclick="envoyerDemande(${removedUserId}, this)">
                                <div class="suggestion-avatar-wrapper">
                                    <img src="${extractedAvatar}" alt="${extractedName}" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=User&background=f1f5f9&color=000'">
                                    <div class="suggestion-add-badge"><i class="fas fa-plus"></i></div>
                                </div>
                                <div class="suggestion-name">${extractedName}</div>
                            </div>
                        `;
                        suggestionsContainer.insertAdjacentHTML('afterbegin', suggestionHtml);
                    }

                    // If currently viewing this chat, close it
                    if (activeConversationId == data.conversationId) {
                        const viewMain = document.getElementById('viewMain');
                        const viewDiscussion = document.getElementById('viewDiscussion');
                        if (viewMain && viewDiscussion) {
                            viewMain.classList.remove('view-hidden-left');
                            viewDiscussion.classList.add('view-hidden-right');
                        }
                        activeConversationId = null;
                        
                        const unfriendBtn = document.getElementById('unfriendBtn');
                        if(unfriendBtn) unfriendBtn.style.display = 'none';
                    }
                });

                globalChannel.bind('friend-accepted-event', function(data) {
                    const allSuggestionItems = document.querySelectorAll('.suggestion-item[data-user-id="'+data.friendId+'"]');
                    allSuggestionItems.forEach(item => item.remove());

                    const demandeBlock = document.getElementById('demande-' + data.requestId);
                    if (demandeBlock) demandeBlock.remove();

                    const listContacts = document.querySelector('.imessage-contact-list');
                    if (listContacts && !document.getElementById('conv-item-' + data.conversationId)) {
                        const strName = data.friendName.replace(/'/g, "\\'");
                        const strAvatar = data.friendImage.replace(/'/g, "\\'");
                        
                        const newContactHtml = `
                            <div class="imessage-contact" 
                                id="conv-item-${data.conversationId}" 
                                data-user-id="${data.friendId}"
                                data-unread="0"
                                data-name="${strName}"
                                data-avatar="${strAvatar}"
                                data-conversation-id="${data.conversationId}"
                                data-status="En ligne"
                                data-status-color="#10B981">
                                
                                <div style="position: relative; margin-right: 12px; height: 45px;">
                                    <img src="${data.friendImage}" class="avatar" style="margin-right: 0;" alt="PDP" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=User&background=f1f5f9&color=000'">
                                    <div style="position: absolute; bottom: 0px; right: 2px; width: 13px; height: 13px; background: #10B981; border-radius: 50%; border: 2px solid white;"></div>
                                </div>
                                
                                <div class="contact-content">
                                    <div class="contact-top">
                                        <span class="name">${data.friendName}</span>
                                        <span class="time">À l'instant</span>
                                    </div>
                                    <div class="contact-bottom">
                                        <span class="last-msg" style="font-style: italic; color: var(--intel-blue);">Nouvelle relation</span>
                                    </div>
                                </div>
                            </div>
                        `;
                        const searchBox = document.querySelector('.imessage-search');
                        if (searchBox) {
                            searchBox.insertAdjacentHTML('afterend', newContactHtml);
                        } else {
                            listContacts.insertAdjacentHTML('afterbegin', newContactHtml);
                        }
                    }
                });

                globalChannel.bind('reclamation-treated', function(data) {
                    const badge = document.getElementById('notifBadge');
                    const totalCountCountSpan = document.getElementById('totalNotifCount');
                    const container = document.querySelector('.notif-body');
                    const emptyMsg = document.getElementById('emptyNotifMsg');
                    
                    if (badge) {
                        badge.classList.remove('hidden');
                        badge.innerText = parseInt(badge.innerText || 0) + 1;
                    }
                    if (totalCountCountSpan) {
                        totalCountCountSpan.innerText = parseInt(totalCountCountSpan.innerText || 0) + 1;
                    }
                    if (emptyMsg) emptyMsg.classList.add('hidden');
                    
                    if (container) {
                        const newRecHtml = `
                            <div class="notif-item reclamation-notif" id="rec-notif-${data.reclamationId}" onclick="markRecAsRead(${data.reclamationId}, '/reclamation/${data.reclamationId}')">
                                <div class="icon-circle" style="background:#dcfce7; color:#059669;"><i class="lni lni-checkmark-circle"></i></div>
                                <div class="content">
                                    <h4>Réclamation Traitée</h4>
                                    <p>${data.message}</p>
                                </div>
                            </div>
                        `;
                        container.insertAdjacentHTML('afterbegin', newRecHtml);
                    }
                });
                
                globalChannel.bind('friend-request-received', function(data) {
                    const badge = document.getElementById('notifBadge');
                    const totalCountCountSpan = document.getElementById('totalNotifCount');
                    const emptyMsg = document.getElementById('emptyNotifMsg');
                    
                    if (badge) {
                        badge.classList.remove('hidden');
                        badge.innerText = parseInt(badge.innerText || 0) + 1;
                    }
                    if (totalCountCountSpan) {
                        totalCountCountSpan.innerText = parseInt(totalCountCountSpan.innerText || 0) + 1;
                    }
                    if (emptyMsg) emptyMsg.classList.add('hidden');
                    
                    const dropdownBody = document.querySelector('.notif-body');
                    if (dropdownBody) {
                        const newHtml = `
                        <div class="notif-item friend-request-notif" onclick="document.getElementById('chatWidgetPanel').classList.add('is-active'); document.getElementById('notifDropdown').classList.remove('show');">
                            <div class="icon-circle" style="background:#fce7f3; color:#db2777;"><i class="lni lni-users"></i></div>
                            <div class="content">
                                <h4>Demande d'ami</h4>
                                <p><strong>${data.requesterName}</strong> vous a envoyé une demande d'ami.</p>
                            </div>
                        </div>`;
                        dropdownBody.insertAdjacentHTML('afterbegin', newHtml);

                    const demandesContainer = document.getElementById('demandesContainer');
                    const demandesAttenteList = document.getElementById('demandesAttenteList');
                    if (demandesContainer && demandesAttenteList) {
                        demandesContainer.style.display = 'block';
                        
                        const suggItem = document.querySelector('.suggestion-item[data-user-id="'+data.requesterId+'"]');
                        if(suggItem) suggItem.remove();
                        
                        const newRequestHtml = `
                        <div class="imessage-contact" id="demande-${data.requestId}" style="cursor: default; padding: 10px 20px;">
                            <img src="${data.requesterImage}" class="avatar" alt="PDP" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=User&background=f1f5f9&color=000'">
                            <div class="contact-content" style="display: flex; justify-content: space-between; align-items: center; border-bottom: none; padding-bottom: 0;">
                                <div class="contact-top" style="flex-direction: column; align-items: flex-start;">
                                    <span class="name" style="font-size: 15px; margin-bottom: 2px;">${data.requesterName}</span>
                                    <span class="last-msg" style="font-size: 12px; color: #8E8E93;">Veut se connecter</span>
                                </div>
                                
                                <button onclick="accepterDemande(${data.requestId}, this)" 
                                        style="background: var(--intel-blue); color: white; border: none; padding: 6px 14px; border-radius: 15px; font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.2s;">
                                    Accepter
                                </button>
                            </div>
                        </div>`;
                        demandesAttenteList.insertAdjacentHTML('beforeend', newRequestHtml);
                    }
                    }
                });
            }

            // LA TECHNIQUE DE DÃ‰LÃ‰GATION (Navigation dans le widget)
            document.addEventListener('click', function(e) {
                const chatPanel = document.getElementById('chatWidgetPanel');
                if (!chatPanel) return; 

                // Les boutons d'ouverture (navbar et IA) ainsi que retour/fermer 
                // sont maintenant gÃ©rÃ©s nativement par leurs attributs onclick="...".
                // Cela Ã©vite les doublons d'ouverture/fermeture !

                const sendBtn = e.target.closest('#sendBtn');
                if (sendBtn) { envoyerMessage(); return; }

                const contactItem = e.target.closest('.imessage-contact');
                if (contactItem) {
                    const convId = contactItem.getAttribute('data-conversation-id');
                    if (convId) {
                        const name = contactItem.getAttribute('data-name');
                        const avatar = contactItem.getAttribute('data-avatar');
                        window.slideIntoDiscussion(name, avatar, convId);
                    }
                    return;
                }
            });

            // ðŸ”´ 1. OUVRIR UNE DISCUSSION (Avec historique, Pusher, et IA)
            window.slideIntoDiscussion = function(name, avatarUrl, conversationId) {
                // --- DEBUG: Validation des Ã©lÃ©ments ---
                const viewContacts = document.getElementById('viewContacts');
                const viewDiscussion = document.getElementById('viewDiscussion');
                const activeNameEl = document.getElementById('activeName');
                const activeAvatarImg = document.getElementById('activeAvatar');
                const activeAvatarAi = document.getElementById('activeAvatarAi');
                const chatBody = document.getElementById('chatBody');

                if (!viewContacts || !viewDiscussion || !activeNameEl || !activeAvatarImg || !activeAvatarAi || !chatBody) {
                    console.error("--- ERREUR MESSAGERIE ---");
                    console.error("Un ou plusieurs Ã©lÃ©ments du DOM sont manquants. VÃ©rification :");
                    console.log("viewContacts:", !!viewContacts);
                    console.log("viewDiscussion:", !!viewDiscussion);
                    console.log("activeNameEl:", !!activeNameEl);
                    console.log("activeAvatarImg:", !!activeAvatarImg);
                    console.log("activeAvatarAi:", !!activeAvatarAi);
                    console.log("chatBody:", !!chatBody);
                    alert("Erreur critique: L'interface de chat n'a pas pu se charger correctement. VÃ©rifiez la console (F12).");
                    return;
                }
                // --- FIN DEBUG ---

                activeConversationId = conversationId;

                let lastActivityStr = '';
                let statusColor = '';

                // Enlever le gras et mettre Ã  jour le badge quand on ouvre !
                const convItem = document.getElementById('conv-item-' + conversationId);
                if (convItem) {
                    lastActivityStr = convItem.getAttribute('data-status') || '';
                    statusColor = convItem.getAttribute('data-status-color') || '';

                    let unread = parseInt(convItem.getAttribute('data-unread')) || 0;
                    if (unread > 0) {
                        globalUnread = Math.max(0, globalUnread - unread);
                        convItem.setAttribute('data-unread', '0');
                        convItem.classList.remove('unread-bold');
                        updateBadge();
                        fetch('/api/message/read/' + conversationId, { method: 'POST' });
                    }
                }

                activeNameEl.innerText = name;
                
                const activeStatusStrSpan = document.getElementById('activeStatusStr');
                if (activeStatusStrSpan) {
                    if (avatarUrl === 'ai-logo') {
                        activeStatusStrSpan.innerText = 'Toujours en ligne';
                        activeStatusStrSpan.style.color = '#10B981';
                    } else if (lastActivityStr) {
                        activeStatusStrSpan.innerText = lastActivityStr;
                        activeStatusStrSpan.style.color = statusColor;
                    } else {
                        activeStatusStrSpan.innerText = '';
                    }
                }
                
                // GESTION DU LOGO (Avatar normal ou Animation SVG pour l'IA)
                if (avatarUrl === 'ai-logo') {
                    activeAvatarImg.style.display = 'none';
                    activeAvatarAi.style.display = 'flex';
                } else {
                    activeAvatarImg.style.display = 'block';
                    activeAvatarAi.style.display = 'none';
                    activeAvatarImg.src = avatarUrl;
                }

                viewContacts.classList.remove('view-active');
                viewContacts.classList.add('view-hidden-left');
                viewDiscussion.classList.remove('view-hidden-right');
                viewDiscussion.classList.add('view-active');
                
                // ðŸ¤– SI ON OUVRE LE CHAT DE L'IA
                if (conversationId === 'ai') {
                    chatBody.innerHTML = '<div class="date-stamp">Aujourd\'hui</div>';
                    // Emoji retirÃ©
                    ajouterBulleAuChat("Bonjour ! Je suis IntelLink-AI. Comment puis-je vous aider Ã  propulser votre carriÃ¨re aujourd'hui ?", 'received');
                    return; // On s'arrÃªte lÃ  (pas d'historique ni de Pusher pour l'IA)
                }

                chatBody.innerHTML = '<div style="text-align: center; margin-top: 20px; color: #8E8E93;"><i class="fas fa-spinner fa-spin"></i> Chargement...</div>'; 
                
                // ðŸŸ¢ FETCH DE L'HISTORIQUE (Pour les vrais utilisateurs) ðŸŸ¢
                fetch('/api/message/history/' + conversationId)
                    .then(response => response.json())
                    .then(messages => {
                        chatBody.innerHTML = ''; 

                        if (messages.error) {
                            chatBody.innerHTML = `<div class="date-stamp">${messages.error}</div>`;
                            return;
                        }

                        if (messages.length === 0) {
                            chatBody.innerHTML = '<div class="date-stamp">DÃ©but de la conversation</div>';
                        } else {
                            messages.forEach(msg => {
                                const type = (msg.expediteur_id === currentUserId) ? 'sent' : 'received';
