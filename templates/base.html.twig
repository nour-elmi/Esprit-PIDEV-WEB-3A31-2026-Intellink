<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Intellink{% endblock %}</title>
        <link rel="stylesheet" href="https://cdn.lineicons.com/3.0/lineicons.css">
        <link rel="stylesheet" href="{{ asset('css/formation.css') }}">
        <link rel="stylesheet" href="{{ asset('css/offres_emploi.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {# NAVBAR COMMUNE #}
        <nav class="intellink-nav">
            <a href="/" class="nav-logo">
                <div class="nav-logo-icon">
                    <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                </div>
                <span class="nav-logo-text">intel<span>link</span></span>
            </a>

            <ul class="nav-links">
                <li><a href="#" class="active">Offres</a></li>
                <li><a href="#">Entreprises</a></li>
                <li><a href="#">Candidats</a></li>
            </ul>

            <div class="nav-icons">
                <button class="nav-icon-btn"><svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg></button>
                <button class="nav-icon-btn"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></button>
            </div>
        </nav>

        {% block body %}{% endblock %}
    </body>
</html>