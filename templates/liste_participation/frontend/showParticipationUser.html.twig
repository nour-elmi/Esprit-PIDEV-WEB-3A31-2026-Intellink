{% extends 'base.html.twig' %}

{% block title %}Mes Candidatures{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('offres_emploi.css') }}">
{% endblock %}

{% block body %}

{# ── Page Header ── #}
<div class="page-header">
    {# Personnalisation avec le nom de l'utilisateur en session #}
    <h1>Candidatures de {{ app.user ? app.user.nom : 'mon compte' }}</h1>
    <p>Suivez l'état de vos dossiers et gérez vos participations aux différentes offres d'emploi.</p>
</div>

{# ── Top Bar ── #}
<div class="top-bar">
    <span class="results-count">
        <strong>{{ list|length }}</strong> candidature{{ list|length != 1 ? 's' : '' }} envoyée{{ list|length != 1 ? 's' : '' }}
    </span>
    
    {# CORRECTION : On redirige vers la liste des offres globale pour pouvoir postuler #}
    {# Remplace 'showOffre' par le nom exact de ta route qui liste toutes les offres #}
    <a href="{{ path('showOffre') }}" class="btn-add-offre">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 8px;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Trouver une offre pour postuler
    </a>
</div>

{# ── Table ── #}
<div class="offers-wrapper">
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Candidat</th>
                    <th>CV & Compétences</th>
                    <th>Score AI</th>
                    <th>Statut</th>
                    <th>Dates</th>
                </tr>
            </thead>
            <tbody>
                {% for participation in list %}
                    <tr>
                        {# ID #}
                        <td>
                            <span class="id-badge">{{ loop.index }}</span>
                        </td>

                        {# Candidat #}
                        <td>
                            <div class="company-name">{{ participation.prenomP }} {{ participation.nomP }}</div>
                        </td>

                        {# CV & Skills #}
                        <td>
                            <div class="desc-text">
                                <a href="{{ participation.cv }}" target="_blank" style="color: var(--primary); text-decoration: none;">
                                    <i class="fas fa-file-pdf"></i> Voir le CV
                                </a><br>
                                <small style="color: var(--text-light)">{{ participation.skills|slice(0, 40) }}…</small>
                            </div>
                        </td>

                        {# Score #}
                        <td>
                            <span class="salary-cell">{{ participation.score }}%</span>
                        </td>

                        {# Statut #}
                        <td>
                            {% if participation.statutt %}
                                <span class="badge-status 
                                    {% if participation.statutt.value == 'acceptee' %}badge-open
                                    {% elseif participation.statutt.value == 'refusee' %}badge-closed
                                    {% else %}badge-pending{% endif %}">
                                    {{ participation.statutt.value|replace({'_': ' '}) }}
                                </span>
                            {% else %}
                                <span style="color:var(--text-light)">—</span>
                            {% endif %}
                        </td>

                        {# Dates #}
                        <td>
                            <div class="dates-cell">
                                <strong>Postulé :</strong> {{ participation.dateParticipation ? participation.dateParticipation|date('d/m/Y') : '—' }}<br>
                                <strong>Réponse :</strong> {{ participation.dateReponse ? participation.dateReponse|date('d/m/Y') : 'En attente' }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty-state" style="padding: 40px; text-align: center;">
                                <div class="empty-icon" style="margin-bottom: 15px; opacity: 0.5;">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <p>Vous n'avez pas encore postulé à des offres.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}