{% extends 'base.html.twig' %}

{% block title %}Liste des Participations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('offres_emploi.css') }}">
{% endblock %}

{% block body %}

{# ── Page Header ── #}
<div class="page-header">
{% if app.user %}
    <div class="user-info">
        <p>Bienvenue, <strong>{{ app.user.nom }}</strong> !</p>
    </div>
{% endif %}
    <h1>Candidatures & Participations</h1>
    <p>Suivez et gérez les dossiers des candidats ayant postulé à vos offres d'emploi.</p>
</div>

{# ── Top Bar ── #}
<div class="top-bar">
    <span class="results-count">
        <strong>{{ participations|length }}</strong> participation{{ participations|length != 1 ? 's' : '' }} enregistrée{{ participations|length != 1 ? 's' : '' }}
    </span>
    
<a href="{{ path('addParticipation', {'id_offre': offre.idOffre}) }}" class="btn-add-offre">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 8px;">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Ajouter une participation
    </a>
</div>

{# ── Table ── #}
<div class="offers-wrapper">
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Candidat</th>
                    <th>CV & Compétences</th>
                    <th>Score</th>
                    <th>Statut</th>
                    <th>Dates</th>
                </tr>
            </thead>
            <tbody>
                {% for participation in participations %}
                    <tr>

                        {# ID #}
                        <td>
                            <span class="id-badge">{{ loop.index }}</span>
                        </td>

                        {# Candidat #}
                        <td>
                            <div class="company-name">{{ participation.prenomP }} {{ participation.nomP }}</div>
                        </td>

                        {# CV & Skills #}
                        <td>
                            <div class="desc-text">
                                <a href="{{ participation.cv }}" target="_blank" style="color: var(--primary); text-decoration: none;">
                                    <i class="fas fa-file-pdf"></i> Voir le CV
                                </a><br>
                                <small style="color: var(--text-light)">{{ participation.skills|slice(0, 40) }}…</small>
                            </div>
                        </td>

                        {# Score #}
                        <td>
                            <span class="salary-cell">{{ participation.score }}%</span>
                        </td>

                        {# Statut #}
                        <td>
                            {% if participation.statutt %}
                                <span class="badge-status 
                                    {% if participation.statutt.value == 'acceptee' %}badge-open
                                    {% elseif participation.statutt.value == 'refusee' %}badge-closed
                                    {% else %}badge-pending{% endif %}">
                                    {{ participation.statutt.value|replace({'_': ' '}) }}
                                </span>
                            {% else %}
                                <span style="color:var(--text-light)">—</span>
                            {% endif %}
                        </td>

                        {# Dates #}
                        <td>
                            <div class="dates-cell">
                                <strong>Postulé :</strong> {{ participation.dateParticipation ? participation.dateParticipation|date('d/m/Y') : '—' }}<br>
                                <strong>Réponse :</strong> {{ participation.dateReponse ? participation.dateReponse|date('d/m/Y') : 'En attente' }}
                            </div>
                        </td>

                        {# Actions
                        <td>
                            <div class="actions-group">
                                <a href="{{ path('updateParticipation', { id: participation.idParticipation }) }}" class="btn-action btn-edit" title="Modifier">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('deleteParticipation', { id: participation.idParticipation }) }}" class="btn-action btn-edit" title="Supprimer" >
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                        <path d="M10 11v6"/><path d="M14 11v6"/>
                                        <path d="M9 6V4h6v2"/>
                                    </svg>
                                </a>
                            </div>
                        </td>
                        #}

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <p>Aucun candidat n'a encore participé.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}