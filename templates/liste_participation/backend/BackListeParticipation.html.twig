{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Participations - Intellink{% endblock %}


{% block body %}
<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Tableau de Bord</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a href="#"><i class="fas fa-home"></i></a>
            </li>
            <li class="separator"><i class="fas fa-chevron-right"></i></li>
            <li class="nav-item"><a href="#">Participations</a></li>
            <li class="separator"><i class="fas fa-chevron-right"></i></li>
            <li class="nav-item"><a href="#">Liste complète</a></li>
        </ul>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Liste des Participations (Intellink)</h4>
                    </div>
                </div>
                <div class="card-body">
                    {# Barre de recherche stylisée #}
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <form action="{{ path('back_participation_search') }}" method="get">
                                <div class="input-group">
                                    <input type="text" name="query" class="form-control" placeholder="Rechercher un candidat...">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Candidat</th>
                                    <th>Offre concernée</th>
                                    <th>Date</th>
                                    <th>Score AI</th>
                                    <th>CV</th>
                                    <th style="width: 10%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for participation in participations %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm me-3">
                                                    <span class="avatar-title rounded-circle border border-white bg-info">
                                                        {{ participation.nomP|first|upper }}
                                                    </span>
                                                </div>
                                                <div>
                                                    <span class="fw-bold d-block">{{ participation.prenomP }} {{ participation.nomP }}</span>
                                                    <small class="text-muted">
                                                        {{ participation.skills ? participation.skills|slice(0, 30) ~ '...' : 'Aucune compétence' }}
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            {% if participation.idOffre %}
                                                <span class="badge badge-primary">{{ participation.idOffre.nomEntreprise }}</span>
                                                <small class="text-muted d-block mt-1">{{ participation.idOffre.description|slice(0, 25) }}...</small>
                                            {% else %}
                                                <span class="text-muted italic">Aucune offre</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ participation.dateParticipation|date('d/m/Y') }}</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="me-2 fw-bold">{{ participation.score }}%</span>
                                                <div class="progress" style="height: 6px; width: 60px;">
                                                    <div class="progress-bar bg-success" role="progressbar" style="width: {{ participation.score }}%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            {% if participation.cv %}
                                                <a href="{{ asset('uploads/cv/' ~ participation.cv) }}" target="_blank" class="btn btn-link p-0" title="Voir le CV">
                                                    <i class="fas fa-file-pdf fa-lg text-danger"></i>
                                                </a>
                                            {% else %}
                                                <span class="badge bg-light text-dark">Aucun</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="form-button-action">
                                                <form method="post" action="{{ path('deleteBackParticipation', {'id': participation.idParticipation}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette candidature ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participation.idParticipation) }}">
                                                    <button type="submit" class="btn btn-link btn-danger" data-bs-toggle="tooltip" title="Supprimer">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center py-4">Aucune participation enregistrée.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Pagination #}
                    <div class="mt-4 d-flex justify-content-center">
                        {% if participations.isPaginator is defined or participations.currentPageNumber is defined %}
                            {{ knp_pagination_render(participations) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}