{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Offres - Intellink{% endblock %}

{% block body %}
<div class="container">
    <div class="page-inner">
        <div class="page-header">
            <h3 class="fw-bold mb-3">Administration</h3>
            <ul class="breadcrumbs mb-3">
                <li class="nav-home"><a href="#"><i class="fas fa-home"></i></a></li>
                <li class="separator"><i class="fas fa-chevron-right"></i></li>
                <li class="nav-item"><a href="#">Offres d'Emploi</a></li>
                <li class="separator"><i class="fas fa-chevron-right"></i></li>
                <li class="nav-item"><a href="#">Liste Backend</a></li>
            </ul>
        </div>

        {# Statistiques Avancées #}
<div class="row mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-icon">
                        <div class="icon-big text-center icon-primary bubble-shadow-small">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                    <div class="col col-stats ms-3 ms-sm-0">
                        <div class="numbers">
                            <p class="card-category">Attractivité Moyenne</p>
                            <h4 class="card-title">{{ statAttractivite }} <small>candidats/offre</small></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-icon">
                        <div class="icon-big text-center icon-danger bubble-shadow-small">
                            <i class="fas fa-hourglass-half"></i>
                        </div>
                    </div>
                    <div class="col col-stats ms-3 ms-sm-0">
                        <div class="numbers">
                            <p class="card-category">Urgence Recrutement</p>
                            <h4 class="card-title">{{ statUrgence }}% <small>expirent bientôt</small></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-icon">
                        <div class="icon-big text-center icon-success bubble-shadow-small">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                    <div class="col col-stats ms-3 ms-sm-0">
                        <div class="numbers">
                            <p class="card-category">Total Candidatures</p>
                            <h4 class="card-title">{{ totalCandidats }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <h4 class="card-title">Gestion des Offres (Intellink)</h4>
                            <a href="{{ path('addOffre') }}" class="btn btn-primary btn-round ms-auto">
                                <i class="fa fa-plus"></i> Nouvelle Offre
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        {# Recherche #}
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <form action="{{ path('app_back_offres') }}" method="get">
                                    <div class="input-group">
                                        <input type="text" name="query" class="form-control" placeholder="Rechercher une entreprise...">
                                        <button class="btn btn-primary" type="submit">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="display table table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Entreprise</th>
                                        <th>Description</th>
                                        <th>Contrat</th>
                                        <th>Expiration</th>
                                        <th>Candidats</th> {# Nombre de participations #}
                                        <th style="width: 10%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for offre in offres %}
                                        <tr>
                                            <td><span class="fw-bold">{{ offre.nomEntreprise }}</span></td>
                                            <td>{{ offre.description|slice(0, 30) }}...</td>
                                            <td><span class="badge badge-info">{{ offre.typeContrat.name }}</span></td>
                                            <td>{{ offre.dateExpiration ? offre.dateExpiration|date('d/m/Y') : 'N/A' }}</td>
                                            <td>
                                                <span class="badge badge-success">
                                                    <i class="fas fa-user-tie"></i> {{ offre.participations|length }}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="form-button-action">
                                                    <td>
                                                        <div class="form-button-action">
                                                            {# NOUVEAU BOUTON : Voir les participations #}
                                                            <a href="{{ path('showParticipationBack', {'id': offre.idOffre}) }}" class="btn btn-link btn-info" title="Voir les candidats">
                                                                <i class="fa fa-eye"></i>
                                                            </a>

                                                            {# On garde la suppression si besoin #}
                                                            <a href="{{ path('deleteBackOffre', {'id': offre.idOffre}) }}" 
                                                            class="btn btn-link btn-danger" 
                                                            onclick="return confirm('Attention : supprimer cette offre supprimera toutes les participations liées. Continuer ?')" 
                                                            title="Supprimer">
                                                                <i class="fa fa-times"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                    <a href="{{ path('deleteBackOffre', {'id': offre.idOffre}) }}" 
                                                       class="btn btn-link btn-danger" 
                                                       onclick="return confirm('Attention : supprimer cette offre supprimera toutes les participations liées. Continuer ?')" 
                                                       title="Supprimer">
                                                        <i class="fa fa-times"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center">Aucune offre trouvée.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 d-flex justify-content-center">
                            {{ knp_pagination_render(offres) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}