{% extends 'base.html.twig' %}

{% block body %}
<div class="form-container-centered">
    <a href="{{ path('showOffre') }}" class="back-link">
        <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert-custom alert-{{ label }}-custom">
                <i class="fas {% if label == 'danger' %}fa-exclamation-circle{% else %}fa-check-circle{% endif %}"></i>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <h1 class="edit-title">
        <i class="fas fa-plus-circle text-primary"></i> Publier une nouvelle offre
    </h1>

    <div class="formation-form-wrapper">
        {{ form_start(formOffre, {'attr': {'id': 'offreForm', 'novalidate': 'novalidate'}}) }}
            <div class="row">
                {# Nom de l'entreprise #}
                <div class="col-md-12 form-group-custom">
                    {{ form_label(formOffre.nom_entreprise, 'Nom de l\'Entreprise') }}
                    {{ form_widget(formOffre.nom_entreprise, {'attr': {'class': 'form-control-custom', 'placeholder': 'Ex: Intellink Tech', 'required': 'required'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(formOffre.nom_entreprise) }}</div>
                </div>

                {# Dates #}
                <div class="col-md-6 form-group-custom">
                    {{ form_label(formOffre.date_debut, 'Date de début') }}
                    {{ form_widget(formOffre.date_debut, {'attr': {'id': 'date_debut', 'class': 'form-control-custom', 'required': 'required'}}) }}
                </div>

                <div class="col-md-6 form-group-custom">
                    {{ form_label(formOffre.date_expiration, 'Date d\'expiration') }}
                    {{ form_widget(formOffre.date_expiration, {'attr': {'id': 'date_fin', 'class': 'form-control-custom', 'required': 'required'}}) }}
                </div>

                {# Message d'erreur stylisé selon ton CSS (.alert-danger-custom) #}
                <div class="col-md-12" id="date-error-container" style="display: none;">
                    <div class="alert-custom alert-danger-custom">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>La date de début doit être antérieure à la date d'expiration.</span>
                    </div>
                </div>

                {# Description #}
                <div class="col-md-12 form-group-custom">
                    {{ form_label(formOffre.description, 'Description du poste') }}
                    {{ form_widget(formOffre.description, {'attr': {'class': 'form-control-custom', 'placeholder': 'Décrivez les missions...', 'required': 'required'}}) }}
                </div>

                {# Salaire #}
                <div class="col-md-12 form-group-custom">
                    {{ form_label(formOffre.salaire, 'Salaire (€)') }}
                    {{ form_widget(formOffre.salaire, {'attr': {'class': 'form-control-custom', 'placeholder': 'Ex: 2500', 'required': 'required'}}) }}
                </div>

                {# Contrat & Statut #}
                <div class="col-md-6 form-group-custom">
                    {{ form_label(formOffre.type_contrat, 'Type de Contrat') }}
                    {{ form_widget(formOffre.type_contrat, {'attr': {'class': 'form-control-custom'}}) }}
                </div>

                <div class="col-md-6 form-group-custom">
                    {{ form_label(formOffre.statut, 'Statut initial') }}
                    {{ form_widget(formOffre.statut, {'attr': {'class': 'form-control-custom'}}) }}
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save-custom">
                    <i class="fas fa-paper-plane"></i> Publier l'offre
                </button>
                <a href="{{ path('showOffre') }}" class="btn-cancel-custom">Annuler</a>
            </div>
        {{ form_end(formOffre) }}
    </div>
</div>

<script>
document.getElementById('offreForm').addEventListener('submit', function(e) {
    const debutInput = document.getElementById('date_debut');
    const finInput = document.getElementById('date_fin');
    const errorContainer = document.getElementById('date-error-container');

    if (debutInput.value && finInput.value) {
        const debut = new Date(debutInput.value);
        const fin = new Date(finInput.value);

        if (debut >= fin) {
            e.preventDefault();
            errorContainer.style.display = 'block';
            errorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
            errorContainer.style.display = 'none';
        }
    }
});
</script>
{% endblock %}