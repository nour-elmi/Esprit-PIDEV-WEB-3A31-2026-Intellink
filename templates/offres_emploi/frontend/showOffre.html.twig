{% extends 'base.html.twig' %}

{% block title %}Offres d'Emploi{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('offres_emploi.css') }}">
{% endblock %}

{% block body %}

{# ── Page Header ── #}
<div class="page-header">
    <h1>Offres d'emploi</h1>
    <p>Consultez et gérez les offres d'emploi ciblées grâce à votre réseau de professionnels qualifiés.</p>
</div>

{# ── Top Bar ── #}
<div class="top-bar">
    <span class="results-count">
        <strong>{{ list|length }}</strong> offre{{ list|length != 1 ? 's' : '' }} disponible{{ list|length != 1 ? 's' : '' }}
    </span>
    {# Décommenter si besoin d'un bouton d'ajout #}
    {# <a href="{{ path('offre_new') }}" class="btn-add">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nouvelle offre
    </a> #}
</div>

{# ── Table ── #}
<div class="offers-wrapper">
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Entreprise</th>
                    <th>Description</th>
                    <th>Contrat</th>
                    <th>Salaire</th>
                    <th>Statut</th>
                    <th>Dates</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for offre in list %}
                    <tr>

                        {# ID #}
                        <td>
                            <span class="id-badge">{{ loop.index }}</span>
                        </td>

                        {# Entreprise #}
                        <td>
                            <span class="company-name">{{ offre.nomEntreprise }}</span>
                        </td>

                        {# Description #}
                        <td>
                            <span class="desc-text">{{ offre.description|slice(0, 60) }}…</span>
                        </td>

                        {# Type de contrat #}
                        <td>
                            {% for type in offre.typeContrat %}
                                <span class="badge-contract">{{ type.value }}</span>
                            {% endfor %}
                        </td>

                        {# Salaire #}
                        <td>
                            {% if offre.salaire %}
                                <span class="salary-cell">{{ offre.salaire }} €</span>
                            {% else %}
                                <span class="salary-neg">À négocier</span>
                            {% endif %}
                        </td>

                        {# Statut #}
                        <td>
                            {% if offre.statut %}
                                <span class="badge-status {{ offre.statut.value == 'ouverte' ? 'badge-open' : 'badge-closed' }}">
                                    {{ offre.statut.value }}
                                </span>
                            {% else %}
                                <span style="color:var(--text-light)">—</span>
                            {% endif %}
                        </td>

                        {# Dates #}
                        <td>
                            <div class="dates-cell">
                                <strong>Début :</strong> {{ offre.dateDebut ? offre.dateDebut|date('d/m/Y') : '—' }}<br>
                                <strong>Exp :</strong> {{ offre.dateExpiration ? offre.dateExpiration|date('d/m/Y') : '—' }}
                            </div>
                        </td>

                        {# Actions #}
                        <td>
                            <div class="actions-group">
                                {# Remplacer # par les vrais chemins Symfony #}
                                <a href="{{ path ('deleteOffre',  { id: offre.idOffre}) }}" class="btn-action btn-edit" title="Modifier">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                                <a href="#" class="btn-action btn-delete" title="Supprimer">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                        <path d="M10 11v6"/><path d="M14 11v6"/>
                                        <path d="M9 6V4h6v2"/>
                                    </svg>
                                </a>
                            </div>
                        </td>

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                                    </svg>
                                </div>
                                <p>Aucune offre d'emploi disponible pour le moment.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
