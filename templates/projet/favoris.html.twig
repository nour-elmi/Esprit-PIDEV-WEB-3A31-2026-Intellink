{% extends 'base_projet.html.twig' %}

{% block title %}Mes favoris{% endblock %}

{% block body %}
<style>
    .fav-page {
        max-width: 1220px;
        margin: 22px auto;
        padding: 0 14px 26px;
    }

    .fav-shell {
        border-radius: 28px;
        padding: 24px;
        background:
            radial-gradient(650px 260px at 100% -10%, rgba(36, 87, 195, 0.2), rgba(36, 87, 195, 0)),
            radial-gradient(420px 220px at -5% 100%, rgba(16, 185, 129, 0.13), rgba(16, 185, 129, 0)),
            linear-gradient(180deg, #f6f9ff 0%, #edf3ff 100%);
        border: 1px solid #d4e2ff;
        box-shadow: 0 20px 38px rgba(17, 45, 106, 0.14);
    }

    .fav-hero {
        border-radius: 26px;
        padding: 24px;
        color: #fff;
        background:
            radial-gradient(300px 180px at 92% 12%, rgba(255,255,255,.17), rgba(255,255,255,0)),
            radial-gradient(240px 150px at 0% 100%, rgba(255,255,255,.1), rgba(255,255,255,0)),
            linear-gradient(135deg, #143b98 0%, #2457c3 63%, #10b981 100%);
        border: 1px solid rgba(255,255,255,.24);
        box-shadow: 0 24px 40px rgba(15, 45, 118, 0.3);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .fav-kicker {
        margin: 0 0 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 6px 12px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.3);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .fav-hero h1 {
        margin: 0;
        font-size: clamp(34px, 5vw, 56px);
        line-height: 1;
        font-weight: 900;
    }

    .fav-hero p {
        margin: 10px 0 0;
        font-size: 20px;
        max-width: 700px;
        color: rgba(255,255,255,.94);
        font-weight: 600;
    }

    .fav-hero-right {
        display: grid;
        justify-items: end;
        gap: 12px;
        align-self: stretch;
        align-content: space-between;
    }

    .fav-count {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 10px 14px;
        font-size: 17px;
        font-weight: 900;
        color: #fff;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.28);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
    }

    .fav-count svg,
    .fav-back svg,
    .fav-remove svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.1;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex: 0 0 auto;
    }

    .fav-back {
        text-decoration: none;
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 16px;
        color: #fff;
        font-size: 16px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.36);
        transition: .2s ease;
    }

    .fav-back:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.21);
    }

    .fav-grid {
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 16px;
        justify-items: start;
    }

    .fav-card {
        border-radius: 20px;
        border: 1px solid #d5e3ff;
        background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
        box-shadow: 0 16px 30px rgba(19, 45, 108, 0.11);
        padding: 16px;
        display: grid;
        gap: 12px;
        position: relative;
        overflow: hidden;
        animation: cardIn .35s ease both;
        width: min(100%, 540px);
    }

    .fav-card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, #2457c3 0%, #10b981 100%);
    }

    .fav-card:nth-child(2) { animation-delay: .03s; }
    .fav-card:nth-child(3) { animation-delay: .06s; }
    .fav-card:nth-child(4) { animation-delay: .09s; }

    .fav-head {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 10px;
        align-items: center;
        min-width: 0;
    }

    .fav-avatar {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        color: #fff;
        font-weight: 900;
        font-size: 21px;
        background: linear-gradient(135deg, #2d63dc 0%, #10b7a7 100%);
        box-shadow: 0 10px 20px rgba(38, 93, 200, 0.28);
    }

    .fav-title-wrap {
        min-width: 0;
    }

    .fav-title {
        margin: 0;
        color: #123677;
        font-size: 30px;
        line-height: 1.06;
        font-weight: 900;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .fav-meta {
        margin: 4px 0 0;
        color: #56719e;
        font-size: 16px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .fav-status {
        border-radius: 999px;
        padding: 7px 11px;
        font-size: 12px;
        font-weight: 900;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .fav-status.wait {
        color: #8d5f00;
        border-color: #f2d78c;
        background: #fff6d8;
    }

    .fav-status.progress {
        color: #0f6f35;
        border-color: #9fd9b3;
        background: #ddf9e8;
    }

    .fav-status.done {
        color: #1f4db6;
        border-color: #bfd4ff;
        background: #e8efff;
    }

    .fav-desc {
        margin: 0;
        color: #2f578f;
        font-size: 18px;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 108px;
    }

    .fav-footer {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .fav-price {
        border-radius: 999px;
        padding: 8px 13px;
        color: #1a4fa5;
        background: #e8f0ff;
        border: 1px solid #d4e3ff;
        font-size: 16px;
        font-weight: 900;
    }

    .fav-actions {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .fav-remove {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: 1px solid #f2d89a;
        color: #996500;
        background: linear-gradient(145deg, #fff7df 0%, #ffefbd 100%);
        display: inline-grid;
        place-items: center;
        cursor: pointer;
        transition: .2s ease;
    }

    .fav-remove:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 18px rgba(153, 101, 0, 0.2);
    }

    .fav-link {
        text-decoration: none;
        min-height: 42px;
        border-radius: 12px;
        padding: 9px 15px;
        color: #fff;
        font-weight: 800;
        font-size: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: linear-gradient(135deg, #1f5ede 0%, #0ea5e9 100%);
        box-shadow: 0 12px 20px rgba(27, 88, 204, 0.25);
        transition: .2s ease;
    }

    .fav-link:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 24px rgba(27, 88, 204, 0.32);
    }

    .fav-note {
        margin-top: 6px;
        text-align: right;
        color: #5c76a2;
        font-size: 12px;
        font-weight: 700;
    }

    .fav-empty {
        margin-top: 18px;
        border-radius: 20px;
        border: 1px dashed #b7cdfc;
        background: linear-gradient(145deg, #f7faff 0%, #edf4ff 100%);
        padding: 28px;
        color: #244884;
        font-size: 16px;
        font-weight: 700;
        box-shadow: inset 0 0 0 1px rgba(206, 224, 255, 0.32);
    }

    @keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 900px) {
        .fav-shell {
            padding: 14px;
            border-radius: 22px;
        }

        .fav-hero {
            grid-template-columns: 1fr;
            padding: 18px;
            border-radius: 20px;
        }

        .fav-hero p {
            font-size: 17px;
        }

        .fav-hero-right {
            justify-items: stretch;
        }

        .fav-back {
            justify-content: center;
        }

        .fav-grid {
            grid-template-columns: 1fr;
            justify-items: stretch;
        }

        .fav-card {
            width: 100%;
        }

        .fav-title {
            font-size: 24px;
        }

        .fav-meta {
            font-size: 14px;
        }

        .fav-desc {
            font-size: 16px;
            min-height: 0;
            -webkit-line-clamp: 5;
        }

        .fav-price {
            font-size: 16px;
        }

        .fav-link {
            font-size: 15px;
        }
    }
</style>

<section class="fav-page">
    <div class="fav-shell">
        <header class="fav-hero">
            <div>
                <p class="fav-kicker">Espace apprenant</p>
                <h1>Mes favoris</h1>
                <p>Retrouve instantanement les projets que tu veux suivre de pres.</p>
            </div>
            <div class="fav-hero-right">
                <span class="fav-count" id="favoritesCountBadge">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1L3.2 9.4l6.1-.9z"></path>
                    </svg>
                    Favoris: {{ favoritesCount }}
                </span>
                <a href="{{ path('app_projet_index') }}" class="fav-back">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                    Retour aux projets
                </a>
            </div>
        </header>

        {% if favoriteProjects is not empty %}
            <div class="fav-grid" id="favoritesGrid">
                {% for projet in favoriteProjects %}
                    {% set st = projet.statut|lower %}
                    <article class="fav-card" data-project-id="{{ projet.id }}">
                        <div class="fav-head">
                            <span class="fav-avatar">{{ projet.titre|slice(0, 1)|upper }}</span>
                            <div class="fav-title-wrap">
                                <h3 class="fav-title">{{ projet.titre }}</h3>
                                <p class="fav-meta">{{ projet.createur }}</p>
                            </div>
                            <span class="fav-status {% if st == 'en attente' %}wait{% elseif st == 'en cours' %}progress{% else %}done{% endif %}">
                                {{ projet.statut }}
                            </span>
                        </div>

                        <p class="fav-desc">{{ projet.description ?: 'Aucune description disponible.' }}</p>

                        <div class="fav-footer">
                            <span class="fav-price">{{ projet.prix|number_format(0, '.', ' ') }} TND</span>
                            <div>
                                <div class="fav-actions">
                                    <button
                                        type="button"
                                        class="fav-remove js-remove-favorite"
                                        data-toggle-url="{{ path('app_projet_favori_toggle', {id: projet.id}) }}"
                                        aria-label="Retirer des favoris"
                                        title="Retirer des favoris"
                                    >
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2m-7 0 1 12h6l1-12"></path></svg>
                                    </button>
                                    <a class="fav-link" href="{{ path('app_projet_show', {id: projet.id}) }}">
                                        Voir
                                    </a>
                                </div>
                                <div class="fav-note">Retirer des favoris</div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="fav-empty" id="emptyFavoritesState">
                Aucun favori pour le moment. Clique sur l'etoile depuis la page projets pour en ajouter.
            </div>
        {% endif %}
    </div>
</section>

<script>
(() => {
    const grid = document.getElementById('favoritesGrid');
    if (!grid) {
        return;
    }

    const countBadge = document.getElementById('favoritesCountBadge');
    let count = Number('{{ favoritesCount|default(0) }}');
    const csrfToken = '{{ csrf_token('toggle_favori_projet') }}';

    const renderEmptyState = () => {
        if (count > 0 || document.getElementById('emptyFavoritesState')) {
            return;
        }

        const empty = document.createElement('div');
        empty.id = 'emptyFavoritesState';
        empty.className = 'fav-empty';
        empty.textContent = "Aucun favori pour le moment. Clique sur l'etoile depuis la page projets pour en ajouter.";
        grid.insertAdjacentElement('afterend', empty);
    };

    const updateCountBadge = () => {
        if (!countBadge) {
            return;
        }
        countBadge.lastChild.textContent = ' Favoris: ' + Math.max(0, count);
    };

    grid.querySelectorAll('.js-remove-favorite').forEach((button) => {
        button.addEventListener('click', async () => {
            const article = button.closest('.fav-card');
            const url = button.getAttribute('data-toggle-url');
            if (!article || !url) {
                return;
            }

            button.disabled = true;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: new URLSearchParams({_token: csrfToken}).toString()
                });
                const payload = await response.json();

                if (!payload.ok) {
                    button.disabled = false;
                    return;
                }

                article.remove();
                count = Number(payload.favoritesCount ?? (count - 1));
                updateCountBadge();

                if (!grid.querySelector('.fav-card')) {
                    grid.remove();
                }
                renderEmptyState();
            } catch (e) {
                button.disabled = false;
            }
        });
    });
})();
</script>
{% endblock %}
