{% extends 'base_projet.html.twig' %}

{% block title %}Mon contrat{% endblock %}

{% block body %}
<style>
    .u-contrat-wrap { max-width: 1060px; margin: 24px auto; }
    .u-contrat {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #d8e5ff;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 22px 42px rgba(16, 36, 82, 0.12);
    }
    .u-head {
        padding: 24px 24px;
        background:
            radial-gradient(460px 200px at 90% 0%, rgba(255,255,255,.2), rgba(255,255,255,0)),
            linear-gradient(135deg, #172e83 0%, #2758cc 58%, #14b8a6 100%);
        color: #fff;
    }
    .u-head h1 { margin: 0 0 6px; font-size: 36px; font-weight: 900; letter-spacing: .2px; }
    .u-head p { margin: 0; opacity: .94; font-weight: 600; }
    .u-body { padding: 22px 24px 24px; }
    .u-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }
    .u-meta-item {
        border-radius: 13px;
        border: 1px solid #d7e4ff;
        background: #f2f7ff;
        padding: 10px 11px;
    }
    .u-meta-item b {
        display: block;
        margin-bottom: 3px;
        color: #3d5f92;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .3px;
    }
    .u-meta-item span { color: #183d7a; font-weight: 800; }
    .u-status {
        display: inline-flex;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        margin-bottom: 12px;
        border: 1px solid transparent;
    }
    .u-status.signed { background: #dcfce7; color: #15803d; border-color: #b2e6c2; }
    .u-status.partial { background: #fff7dc; color: #9a6700; border-color: #f0dc9c; }
    .u-status.wait { background: #e8f0ff; color: #1d4ed8; border-color: #c6d8ff; }
    .u-text {
        white-space: pre-line;
        border: 1px solid #d3e1ff;
        border-radius: 16px;
        background: #fff;
        padding: 16px;
        color: #1f3a63;
        line-height: 1.6;
        margin-bottom: 14px;
        box-shadow: inset 0 0 0 1px rgba(212, 227, 255, .3);
    }
    .u-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
        align-items: center;
    }
    .u-row input {
        border: 1px solid #c6d7fb;
        border-radius: 12px;
        padding: 11px 13px;
        font-weight: 700;
        color: #173569;
        background: #fff;
    }
    .u-btn {
        border: 0;
        border-radius: 12px;
        padding: 11px 16px;
        background: linear-gradient(135deg, #1952d8 0%, #129fe2 100%);
        color: #fff;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 12px 24px rgba(24, 79, 204, 0.25);
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .u-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 28px rgba(24, 79, 204, 0.3);
    }
    .u-signature-box {
        border: 1px solid #d1e2ff;
        border-radius: 16px;
        background: linear-gradient(180deg, #f9fbff 0%, #f1f7ff 100%);
        padding: 12px;
        margin-bottom: 10px;
    }
    .u-signature-canvas {
        width: 100%;
        height: 180px;
        border-radius: 12px;
        border: 1px dashed #86a8ea;
        background: #fff;
        touch-action: none;
        cursor: crosshair;
    }
    .u-sign-actions {
        margin-top: 8px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .u-btn-secondary {
        border: 1px solid #c2d8ff;
        border-radius: 10px;
        background: #eaf2ff;
        color: #1d4ed8;
        font-weight: 800;
        padding: 8px 12px;
        cursor: pointer;
    }
    .u-signed-img {
        max-width: 380px;
        width: 100%;
        border-radius: 10px;
        border: 1px solid #cfe0ff;
        background: #fff;
        padding: 6px;
        margin-top: 8px;
    }
    .u-back {
        margin-top: 12px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #173a76;
        font-weight: 800;
        transition: color .2s ease;
    }
    .u-back:hover {
        color: #0f4db4;
    }
    .u-actions {
        margin-top: 12px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }
    .u-btn-pdf {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #f6cc8e;
        border-radius: 12px;
        padding: 10px 13px;
        background: linear-gradient(135deg, #fff2da 0%, #ffe5b3 100%);
        color: #8a4903;
        font-weight: 800;
        box-shadow: 0 10px 18px rgba(234, 170, 62, 0.18);
        transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }
    .u-btn-pdf:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 22px rgba(234, 170, 62, 0.24);
        filter: saturate(1.05);
    }
    @media (max-width: 900px) {
        .u-row { grid-template-columns: 1fr; }
        .u-meta { grid-template-columns: 1fr; }
        .u-head h1 { font-size: 31px; }
    }
</style>

<div class="u-contrat-wrap">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <section class="u-contrat">
        <header class="u-head">
            <h1>Contrat de participation</h1>
            <p>Projet: {{ demande.projet.titre }}</p>
        </header>
        <div class="u-body">
            {% set st = contrat.statut|default('ENVOYE_AU_USER') %}
            {% set rawSign = contrat.userSignatureName ?? '' %}
            {% set userSignPath = '' %}
            {% set userSignLabel = '' %}
            {% if rawSign starts with 'uploads/signatures/' or rawSign starts with '/uploads/signatures/' %}
                {% set userSignPath = rawSign %}
            {% elseif '|' in rawSign %}
                {% set signParts = rawSign|split('|') %}
                {% set userSignPath = signParts[0] ?? '' %}
                {% set userSignLabel = signParts[1] ?? '' %}
            {% elseif rawSign is not empty %}
                {% set userSignLabel = rawSign %}
            {% endif %}
            <span class="u-status {% if st == 'SIGNE' %}signed{% elseif st == 'SIGNE_PAR_USER' %}partial{% else %}wait{% endif %}">
                {{ st }}
            </span>

            <div class="u-meta">
                <div class="u-meta-item">
                    <b>Projet</b>
                    <span>{{ demande.projet.titre }}</span>
                </div>
                <div class="u-meta-item">
                    <b>Statut</b>
                    <span>{{ st }}</span>
                </div>
                <div class="u-meta-item">
                    <b>Signature</b>
                    <span>{{ contrat.userSignedAt ? contrat.userSignedAt|date('d/m/Y H:i') : 'En attente' }}</span>
                </div>
            </div>

            <div class="u-text">{{ contrat.contenu }}</div>

            {% if contrat.userSignedAt is null %}
                <form method="post" action="{{ path('app_participation_contrat_sign', {id: demande.id}) }}" class="u-row" id="signatureForm">
                    <input type="hidden" name="_token" value="{{ csrf_token('sign_contrat_' ~ demande.id) }}">
                    <input type="hidden" name="signature_draw" id="signatureDrawInput">

                    <div class="u-signature-box">
                        <canvas id="signaturePad" class="u-signature-canvas"></canvas>
                        <div class="u-sign-actions">
                            <button type="button" id="clearSignatureBtn" class="u-btn-secondary">Effacer</button>
                        </div>
                    </div>

                    <input type="text" name="signature_name" value="{{ app.user and app.user.nom ? app.user.nom : (app.user and app.user.email ? app.user.email : '') }}" placeholder="Nom de signature">
                    <button type="submit" class="u-btn">Signer le contrat</button>
                </form>
            {% else %}
                <div class="alert alert-success">Contrat signe le {{ contrat.userSignedAt|date('d/m/Y H:i') }}. Contrat finalise.</div>
                {% if userSignLabel %}
                    <div><strong>Signature:</strong> {{ userSignLabel }}</div>
                {% endif %}
                {% if userSignPath and (userSignPath starts with 'uploads/signatures/' or userSignPath starts with '/uploads/signatures/') %}
                    <img class="u-signed-img" src="{{ asset(userSignPath) }}" alt="Signature utilisateur">
                {% endif %}
                <div class="u-actions">
                    <a class="u-btn-pdf" href="{{ path('app_participation_contrat_pdf', {id: demande.id}) }}">
                        <span>PDF</span>
                        <span>Telecharger le contrat signe</span>
                    </a>
                </div>
            {% endif %}

            <a href="{{ path('app_mes_demandes') }}" class="u-back">
                <span>←</span>
                <span>Retour a mes participations</span>
            </a>
        </div>
    </section>
</div>
{% if contrat.userSignedAt is null %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const canvas = document.getElementById('signaturePad');
    const form = document.getElementById('signatureForm');
    const hiddenInput = document.getElementById('signatureDrawInput');
    const clearBtn = document.getElementById('clearSignatureBtn');
    if (!canvas || !form || !hiddenInput || !clearBtn) return;

    const ctx = canvas.getContext('2d');
    let drawing = false;
    let hasStroke = false;

    function resizeCanvas() {
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        const rect = canvas.getBoundingClientRect();
        canvas.width = Math.floor(rect.width * ratio);
        canvas.height = Math.floor(rect.height * ratio);
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#17326f';
        redrawGuide();
    }

    function redrawGuide() {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function pointFromEvent(event) {
        const rect = canvas.getBoundingClientRect();
        const clientX = event.touches ? event.touches[0].clientX : event.clientX;
        const clientY = event.touches ? event.touches[0].clientY : event.clientY;
        return { x: clientX - rect.left, y: clientY - rect.top };
    }

    function startDraw(event) {
        event.preventDefault();
        drawing = true;
        const p = pointFromEvent(event);
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
    }

    function draw(event) {
        if (!drawing) return;
        event.preventDefault();
        const p = pointFromEvent(event);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        hasStroke = true;
    }

    function endDraw() {
        drawing = false;
    }

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    window.addEventListener('mouseup', endDraw);
    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    window.addEventListener('touchend', endDraw);

    clearBtn.addEventListener('click', function () {
        redrawGuide();
        hasStroke = false;
        hiddenInput.value = '';
    });

    form.addEventListener('submit', function (event) {
        if (!hasStroke) {
            event.preventDefault();
            alert('Veuillez dessiner votre signature.');
            return;
        }
        hiddenInput.value = canvas.toDataURL('image/png');
    });

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
});
</script>
{% endif %}
{% endblock %}
