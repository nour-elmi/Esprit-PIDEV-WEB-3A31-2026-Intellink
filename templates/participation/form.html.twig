{% extends 'base_projet.html.twig' %}

{% block title %}Participer au projet{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-icon">📝</div>
            <h1>{% if editMode is defined and editMode %}Modifier ma demande{% else %}Participer au projet{% endif %}</h1>
            <p>{{ projet.titre }}</p>
        </div>
    </div>
</section>

<div class="main-content">
    <div class="container">
        <a href="{{ path('app_projet_show', {id: projet.id}) }}" class="back-link back-link-modern">
            <span class="back-link-icon">←</span>
            <span>Retour au projet</span>
        </a>

        <div class="form-wrapper-custom participation-form-card">
            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

            <div id="front-validation-box" class="alert alert-danger" style="display:none; border-radius:16px; margin-bottom:20px;"></div>

            <div class="form-grid participation-form-grid">
                <div class="form-group-custom">
                    {{ form_label(form.roleSouhaite) }}
                    <div class="choice-card-group" id="role-group">
                        {% for child in form.roleSouhaite %}
                            <label class="choice-card">
                                {{ form_widget(child) }}
                                <span class="choice-card-text">{{ child.vars.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <div id="role-error" class="text-danger fw-semibold mt-2" style="display:none;"></div>
                    {{ form_errors(form.roleSouhaite) }}

                    <div class="conditional-field-wrapper" data-conditional-target="role" style="display:none;">
                        {{ form_label(form.autreRole) }}
                        {{ form_widget(form.autreRole) }}
                        {{ form_errors(form.autreRole) }}
                    </div>
                </div>

                <div class="form-group-custom">
                    {{ form_label(form.disponibilite) }}
                    <div class="choice-card-group" id="dispo-group">
                        {% for child in form.disponibilite %}
                            <label class="choice-card">
                                {{ form_widget(child) }}
                                <span class="choice-card-text">{{ child.vars.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <div id="dispo-error" class="text-danger fw-semibold mt-2" style="display:none;"></div>
                    {{ form_errors(form.disponibilite) }}

                    <div class="conditional-field-wrapper" data-conditional-target="disponibilite" style="display:none;">
                        {{ form_label(form.autreDisponibilite) }}
                        {{ form_widget(form.autreDisponibilite) }}
                        {{ form_errors(form.autreDisponibilite) }}
                    </div>
                </div>

                <div class="form-group-custom form-col-full">
                    {{ form_label(form.portfolio) }}
                    {{ form_widget(form.portfolio) }}
                    {{ form_errors(form.portfolio) }}
                </div>

                <div class="form-group-custom form-col-full">
                    {{ form_label(form.motivation) }}
                    {{ form_widget(form.motivation) }}
                    <div class="motivation-meter">
                        <div class="motivation-meter-head">
                            <span>Qualité de la motivation</span>
                            <div class="motivation-meter-right">
                                <span id="motivationMeterStats">0 caractères</span>
                                <strong id="motivationMeterLabel">Faible</strong>
                            </div>
                        </div>
                        <div class="motivation-meter-track">
                            <div id="motivationMeterFill" class="motivation-meter-fill" style="width:0%;"></div>
                        </div>
                        <div id="motivationMeterHint" class="motivation-meter-hint">Commence à écrire: le score évolue même sans canevas.</div>
                    </div>
                    <div class="motivation-helper">
                        <div class="motivation-helper-head">
                            <div>
                                <strong class="motivation-title">Canevas motivation intelligent</strong>
                                <div class="motivation-subtitle">Optionnel: choisis un style et personnalise les pointillés.</div>
                            </div>
                            <button type="button" id="motivationHelperBtn" class="motivation-helper-btn">Inserer le canevas choisi</button>
                        </div>
                        <div class="motivation-meta">
                            <span class="motivation-chip"><strong>Projet:</strong>&nbsp;{{ projet.titre }}</span>
                            <span class="motivation-chip"><strong>Chef:</strong>&nbsp;{{ projet.createur }}</span>
                        </div>
                        <div class="motivation-template-grid" id="motivationTemplateGrid">
                            <button type="button" class="motivation-template-card active" data-template-id="impact">
                                <span class="motivation-template-badge">Style impact</span>
                                <p>Candidature orientee resultats, valeur ajoutee et livrable rapide.</p>
                            </button>
                            <button type="button" class="motivation-template-card" data-template-id="technique">
                                <span class="motivation-template-badge">Style technique</span>
                                <p>Candidature orientee competences, methode et execution professionnelle.</p>
                            </button>
                            <button type="button" class="motivation-template-card" data-template-id="collaboration">
                                <span class="motivation-template-badge">Style collaboration</span>
                                <p>Candidature orientee communication, fiabilite equipe et suivi des delais.</p>
                            </button>
                        </div>
                        <div id="motivationCanvasPreview" class="motivation-canvas-preview">
Projet: {{ projet.titre }}
Chef de projet: {{ projet.createur }}
Je souhaite contribuer sur ........ avec mes competences en ........
D ici 2 semaines, je peux livrer ........
Je suis disponible ........ et je m engage a ........
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Minimum 10 caractères.</small>
                    <div id="motivation-error" class="text-danger fw-semibold mt-2" style="display:none;"></div>
                    {{ form_errors(form.motivation) }}
                </div>
            </div>

            <div class="form-actions participation-form-actions">
                {{ form_widget(form.save) }}
                <a href="{{ path('app_mes_demandes') }}" class="btn-secondary-custom btn-my-requests">
                    Mes participations
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<style>
    .field-invalid .choice-card-text {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.18rem rgba(220, 53, 69, 0.12) !important;
    }

    .is-invalid-textarea,
    .is-invalid-input {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.18rem rgba(220, 53, 69, 0.12) !important;
        background: #fff8f8 !important;
    }

    .alert-danger {
        line-height: 1.7;
    }

    .motivation-helper {
        margin-top: 12px;
        border: 1px solid #d2e2ff;
        border-radius: 16px;
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 58%, #f8fffc 100%);
        box-shadow: 0 10px 24px rgba(27, 67, 140, 0.08);
        padding: 12px;
    }

    .motivation-helper-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .motivation-title {
        display: block;
        color: #133a7a;
        font-size: 20px;
        line-height: 1.2;
    }

    .motivation-subtitle {
        margin-top: 2px;
        color: #58749f;
        font-size: 12px;
        font-weight: 600;
    }

    .motivation-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 8px;
    }

    .motivation-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #ffffff;
        border: 1px solid #cddfff;
        border-radius: 999px;
        padding: 6px 10px;
        color: #153b7a;
        font-size: 12px;
        font-weight: 700;
    }

    .motivation-helper-btn {
        border: 1px solid #9fc0fb;
        background: linear-gradient(135deg, #ffffff 0%, #f2f7ff 100%);
        color: #183f8a;
        border-radius: 12px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.18s ease;
    }

    .motivation-helper-btn:hover {
        background: #eaf2ff;
        transform: translateY(-1px);
    }

    .motivation-template-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 8px;
    }

    .motivation-template-card {
        text-align: left;
        border: 1px solid #c9dcff;
        border-radius: 12px;
        background: #ffffff;
        padding: 9px 10px;
        cursor: pointer;
        transition: .18s ease;
        color: #1f427b;
    }

    .motivation-template-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(35, 74, 146, 0.12);
    }

    .motivation-template-card.active {
        border-color: #3f7cff;
        box-shadow: 0 0 0 2px rgba(63, 124, 255, 0.16);
        background: linear-gradient(180deg, #f8fbff 0%, #f1f7ff 100%);
    }

    .motivation-template-badge {
        display: inline-flex;
        border-radius: 999px;
        border: 1px solid #bed5ff;
        background: #eef4ff;
        color: #20488d;
        font-size: 11px;
        font-weight: 800;
        padding: 3px 8px;
        margin-bottom: 6px;
    }

    .motivation-template-card p {
        margin: 0;
        font-size: 12px;
        line-height: 1.45;
        color: #3b5f97;
    }

    .motivation-canvas-preview {
        margin-top: 2px;
        border: 1px dashed #8eadde;
        border-radius: 12px;
        background: #ffffff;
        color: #1f427a;
        font-size: 13px;
        line-height: 1.75;
        padding: 10px 12px;
        white-space: pre-line;
    }

    .motivation-meter {
        margin-top: 10px;
        background: #ffffff;
        border: 1px solid #d7e5ff;
        border-radius: 12px;
        padding: 10px 12px;
    }

    .motivation-meter-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
        color: #184184;
        font-size: 12px;
        font-weight: 700;
    }

    .motivation-meter-right {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    #motivationMeterStats {
        color: #5e759a;
        font-size: 11px;
        font-weight: 700;
    }

    .motivation-meter-track {
        height: 9px;
        border-radius: 999px;
        background: #eef3fb;
        overflow: hidden;
    }

    .motivation-meter-fill {
        height: 100%;
        width: 0;
        border-radius: 999px;
        background: #e24646;
        transition: width .25s ease, background-color .25s ease;
    }

    .motivation-meter-hint {
        margin-top: 7px;
        font-size: 11px;
        font-weight: 600;
        color: #5d7398;
    }

    @media (max-width: 768px) {
        .motivation-helper-head {
            flex-direction: column;
            align-items: flex-start;
        }

        .motivation-helper-btn {
            width: 100%;
            text-align: center;
        }

        .motivation-template-grid {
            grid-template-columns: 1fr;
        }

        .motivation-meter-head {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    function setupConditionalRadio(fieldName, targetName) {
        const radios = document.querySelectorAll('input[name$="[' + fieldName + ']"]');
        const targetWrapper = document.querySelector('[data-conditional-target="' + targetName + '"]');
        const targetInput = targetWrapper ? targetWrapper.querySelector('input') : null;

        if (!radios.length || !targetWrapper || !targetInput) {
            return;
        }

        function updateVisibility() {
            let selectedValue = null;

            radios.forEach(function (radio) {
                if (radio.checked) {
                    selectedValue = radio.value;
                }
            });

            if (selectedValue === 'autre') {
                targetWrapper.style.display = 'block';
            } else {
                targetWrapper.style.display = 'none';
                targetInput.value = '';
            }
        }

        radios.forEach(function (radio) {
            radio.addEventListener('change', updateVisibility);
        });

        updateVisibility();
    }

    setupConditionalRadio('roleSouhaite', 'role');
    setupConditionalRadio('disponibilite', 'disponibilite');

    const form = document.querySelector('form[name="demande_participation"]') || document.querySelector('form');
    if (!form) {
        return;
    }

    const roleInputs = form.querySelectorAll('input[name$="[roleSouhaite]"]');
    const dispoInputs = form.querySelectorAll('input[name$="[disponibilite]"]');
    const motivationInput = document.getElementById('demande_participation_motivation');
    const motivationHelperBtn = document.getElementById('motivationHelperBtn');
    const motivationTemplateGrid = document.getElementById('motivationTemplateGrid');
    const motivationTemplateCards = motivationTemplateGrid ? Array.from(motivationTemplateGrid.querySelectorAll('.motivation-template-card')) : [];
    const motivationCanvasPreview = document.getElementById('motivationCanvasPreview');
    const motivationMeterFill = document.getElementById('motivationMeterFill');
    const motivationMeterLabel = document.getElementById('motivationMeterLabel');
    const motivationMeterStats = document.getElementById('motivationMeterStats');
    const motivationMeterHint = document.getElementById('motivationMeterHint');
    const portfolioInput = document.getElementById('demande_participation_portfolio');

    const roleError = document.getElementById('role-error');
    const dispoError = document.getElementById('dispo-error');
    const motivationError = document.getElementById('motivation-error');
    const globalBox = document.getElementById('front-validation-box');
    const roleGroup = document.getElementById('role-group');
    const dispoGroup = document.getElementById('dispo-group');
    const projectTitle = '{{ projet.titre|e('js') }}';
    const chefName = '{{ projet.createur|e('js') }}';

    const motivationTemplates = {
        impact: [
            'Projet: ' + projectTitle,
            'Chef de projet: ' + chefName,
            'Je souhaite rejoindre ce projet pour generer un impact concret sur ........ grace a mes competences en ........',
            'Dans les 2 prochaines semaines, je peux livrer ........',
            'Je suis disponible ........ et je m engage a assurer un suivi clair avec le chef.'
        ].join('\n'),
        technique: [
            'Projet: ' + projectTitle,
            'Chef de projet: ' + chefName,
            'Je candidate pour intervenir sur ........ en utilisant mes competences techniques en ........',
            'Mon plan de livraison sur 2 semaines: ........',
            'Je suis disponible ........ et je m engage a produire un travail propre, teste et documente.'
        ].join('\n'),
        collaboration: [
            'Projet: ' + projectTitle,
            'Chef de projet: ' + chefName,
            'Je souhaite contribuer sur ........ et collaborer efficacement avec l equipe en apportant ........',
            'En 2 semaines, je peux finaliser ........',
            'Je suis disponible ........ et je m engage a communiquer regulierement et respecter les delais.'
        ].join('\n')
    };
    let selectedTemplateId = 'impact';

    function anyChecked(nodeList) {
        return Array.from(nodeList).some(function (input) {
            return input.checked;
        });
    }

    function resetErrors() {
        globalBox.style.display = 'none';
        globalBox.innerHTML = '';

        roleError.style.display = 'none';
        roleError.textContent = '';

        dispoError.style.display = 'none';
        dispoError.textContent = '';

        motivationError.style.display = 'none';
        motivationError.textContent = '';

        roleGroup.classList.remove('field-invalid');
        dispoGroup.classList.remove('field-invalid');

        if (motivationInput) {
            motivationInput.classList.remove('is-invalid-textarea');
        }

        if (portfolioInput) {
            portfolioInput.classList.remove('is-invalid-input');
        }
    }

    function showGlobalErrors(errors) {
        if (errors.length === 0) {
            return;
        }

        globalBox.innerHTML = '<strong>Veuillez corriger les champs suivants :</strong><br>' + errors.join('<br>');
        globalBox.style.display = 'block';
    }

    function renderTemplatePreview() {
        if (!motivationCanvasPreview) {
            return;
        }
        motivationCanvasPreview.textContent = motivationTemplates[selectedTemplateId] || motivationTemplates.impact;
    }

    function setActiveTemplate(templateId) {
        selectedTemplateId = motivationTemplates[templateId] ? templateId : 'impact';
        motivationTemplateCards.forEach(function (card) {
            const isActive = card.getAttribute('data-template-id') === selectedTemplateId;
            card.classList.toggle('active', isActive);
        });
        renderTemplatePreview();
    }

    function updateMotivationMeter() {
        if (!motivationInput || !motivationMeterFill || !motivationMeterLabel || !motivationMeterHint) {
            return;
        }

        const text = (motivationInput.value || '').trim();
        const len = text.length;
        const dotsCount = (text.match(/\.{6,}/g) || []).length;
        const lines = text.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);
        const sentenceCount = (text.match(/[.!?]+/g) || []).length;
        const hasProjectRef = /projet|mission|objectif/i.test(text);
        const hasActionRef = /livrer|contribuer|realiser|developper|implementer/i.test(text);
        const hasAvailability = /disponible|semaine|horaire|week-end|soir/i.test(text);

        let score = 0;
        score += Math.min(60, Math.round((len / 260) * 60)); // base caracteres
        score += Math.min(14, lines.length * 4); // lisibilite par structure
        score += Math.min(10, sentenceCount * 4); // phrases completes
        score += hasProjectRef ? 6 : 0;
        score += hasActionRef ? 6 : 0;
        score += hasAvailability ? 6 : 0;
        score -= dotsCount * 10;
        score = Math.max(0, Math.min(100, score));

        const hue = Math.round((score / 100) * 120);
        motivationMeterFill.style.width = score + '%';
        motivationMeterFill.style.backgroundColor = 'hsl(' + hue + ', 72%, 46%)';
        if (motivationMeterStats) {
            const placeholdersLeft = dotsCount > 0 ? ' | ' + dotsCount + ' zone(s) a completer' : '';
            motivationMeterStats.textContent = len + ' caractères' + placeholdersLeft;
        }

        if (score < 40) {
            motivationMeterLabel.textContent = 'Faible';
            motivationMeterHint.textContent = 'Ajoute ce que tu apportes, ce que tu peux livrer, et ta disponibilite.';
        } else if (score < 70) {
            motivationMeterLabel.textContent = 'Moyenne';
            motivationMeterHint.textContent = 'Bonne base. Donne un livrable plus precis et finalise toutes les zones pointillees.';
        } else {
            motivationMeterLabel.textContent = 'Forte';
            motivationMeterHint.textContent = 'Excellent niveau. Motivation claire et convaincante pour etre acceptee.';
        }
    }

    function validateForm() {
        resetErrors();

        const errors = [];
        const hasRole = anyChecked(roleInputs);
        const hasDispo = anyChecked(dispoInputs);
        const motivation = motivationInput ? motivationInput.value.trim() : '';
        const portfolio = portfolioInput ? portfolioInput.value.trim() : '';

        if (!hasRole) {
            errors.push('Veuillez choisir un rôle souhaité.');
            roleError.textContent = 'Veuillez choisir un rôle souhaité.';
            roleError.style.display = 'block';
            roleGroup.classList.add('field-invalid');
        }

        if (!hasDispo) {
            errors.push('Veuillez choisir une disponibilité.');
            dispoError.textContent = 'Veuillez choisir une disponibilité.';
            dispoError.style.display = 'block';
            dispoGroup.classList.add('field-invalid');
        }

        if (!motivation) {
            errors.push('Veuillez renseigner votre motivation.');
            motivationError.textContent = 'Veuillez renseigner votre motivation.';
            motivationError.style.display = 'block';
            if (motivationInput) {
                motivationInput.classList.add('is-invalid-textarea');
            }
        } else if (motivation.length < 10) {
            errors.push('La motivation doit contenir au moins 10 caractères.');
            motivationError.textContent = 'La motivation doit contenir au moins 10 caractères.';
            motivationError.style.display = 'block';
            if (motivationInput) {
                motivationInput.classList.add('is-invalid-textarea');
            }
        }

        if (portfolio !== '') {
            try {
                new URL(portfolio);
            } catch (e) {
                errors.push('Le lien portfolio doit être une URL valide.');
                if (portfolioInput) {
                    portfolioInput.classList.add('is-invalid-input');
                }
            }
        }

        showGlobalErrors(errors);
        return errors.length === 0;
    }

    form.addEventListener('submit', function (e) {
        const isValid = validateForm();

        if (!isValid) {
            e.preventDefault();

            const firstInvalid = form.querySelector('.field-invalid, .is-invalid-textarea, .is-invalid-input, .alert-danger');
            if (firstInvalid) {
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
    });

    roleInputs.forEach(function (input) {
        input.addEventListener('change', function () {
            roleError.style.display = 'none';
            roleError.textContent = '';
            roleGroup.classList.remove('field-invalid');
            globalBox.style.display = 'none';
        });
    });

    dispoInputs.forEach(function (input) {
        input.addEventListener('change', function () {
            dispoError.style.display = 'none';
            dispoError.textContent = '';
            dispoGroup.classList.remove('field-invalid');
            globalBox.style.display = 'none';
        });
    });

    if (motivationInput) {
        motivationInput.addEventListener('input', function () {
            motivationError.style.display = 'none';
            motivationError.textContent = '';
            motivationInput.classList.remove('is-invalid-textarea');
            globalBox.style.display = 'none';
            updateMotivationMeter();
        });
    }

    if (portfolioInput) {
        portfolioInput.addEventListener('input', function () {
            portfolioInput.classList.remove('is-invalid-input');
            globalBox.style.display = 'none';
        });
    }

    if (motivationTemplateCards.length > 0) {
        motivationTemplateCards.forEach(function (card) {
            card.addEventListener('click', function () {
                const templateId = card.getAttribute('data-template-id') || 'impact';
                setActiveTemplate(templateId);
            });
        });
    }

    if (motivationHelperBtn && motivationInput) {
        motivationHelperBtn.addEventListener('click', function () {
            const sample = motivationTemplates[selectedTemplateId] || motivationTemplates.impact;
            motivationInput.value = sample;
            motivationInput.dispatchEvent(new Event('input', { bubbles: true }));
            motivationInput.focus();
            const firstDots = motivationInput.value.indexOf('........');
            if (firstDots >= 0) {
                motivationInput.setSelectionRange(firstDots, firstDots + 8);
            } else {
                motivationInput.setSelectionRange(motivationInput.value.length, motivationInput.value.length);
            }
            updateMotivationMeter();
        });
    }

    renderTemplatePreview();
    updateMotivationMeter();
});
</script>
{% endblock %}